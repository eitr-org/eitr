#!/usr/bin/env bash
set -euo pipefail
# Local Git config, so no remote or identity is published here:
#   git config eitr.guard.remote URL           the only remote pushes may use
#   git config eitr.guard.forbidden REGEX      identities that must never be pushed
expected_remote="$(git config --get eitr.guard.remote || true)"
forbidden="$(git config --get eitr.guard.forbidden || true)"
if [[ -z "$expected_remote" ]]; then
  printf 'These hooks guard pushes. Set the allowed remote first:\n  git config eitr.guard.remote URL\n' >&2
  exit 1
fi
if [[ "${2:-}" != "$expected_remote" ]]; then
  printf 'Pushes from this checkout must use %s\n' "$expected_remote" >&2
  exit 1
fi
while read -r local_ref local_oid remote_ref remote_oid; do
  [[ "$local_oid" != 0000000000000000000000000000000000000000 ]] || continue
  # Captured first: grep -q exiting early would SIGPIPE git log under pipefail.
  identities="$(git log "$local_oid" --format='%an%n%ae%n%cn%n%ce')"
  if [[ -n "$forbidden" ]] && grep -Eiq -- "$forbidden" <<< "$identities"; then
    printf 'Refusing to push history containing a forbidden identity (%s).\n' "$local_ref" >&2
    exit 1
  fi
  messages="$(git log "$local_oid" --format='%B')"
  if grep -Eiq '^[[:space:]]*co-authored-by[[:space:]]*:' <<< "$messages"; then
    printf 'Refusing history containing co-author attribution (%s).\n' "$local_ref" >&2
    exit 1
  fi
done
