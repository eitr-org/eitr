#!/usr/bin/env python3
"""Create, inspect, restore, or undo Eitr desktop backups."""
from pathlib import Path
import sys

# A checkout's own library first; installed in /usr/bin, the packaged one, so it also
# works outside the desktop session (a text console, SSH or a service) without PYTHONPATH.
for library in [parent / name for parent in Path(__file__).resolve().parents for name in ("lib", "distro/lib")] \
        + [Path("/usr/share/eitr/lib")]:
    if (library / "eitr_paths.py").is_file():
        sys.path.insert(0, str(library))
        break

from eitr_backup.cli import main

if __name__ == "__main__":
    raise SystemExit(main())
