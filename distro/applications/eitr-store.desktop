[Desktop Entry]
Type=Application
Name=Eitr Store
GenericName=Store
Comment=Discover and manage Eitr themes, plugins, lockscreens and wallpapers
Icon=eitr-store
Exec=eitr-shell desktop-bar ipc call -- store show
Keywords=Eitr;themes;plugins;lockscreens;wallpapers;add-ons;
Categories=Settings;PackageManager;
Terminal=false
StartupNotify=false
