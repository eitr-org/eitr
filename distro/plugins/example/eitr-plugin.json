{
  "schemaVersion": 2,
  "id": "example",
  "name": "Example plugin",
  "description": "A tiny notification example",
  "author": "Eitr contributors",
  "version": "1.0.0",
  "rows": [
    {
      "title": "Example notification",
      "description": "Show a greeting from the example plugin",
      "icon": "󰂚",
      "run": "notify.sh",
      "arguments": [
        "Hello from an Eitr plugin"
      ]
    }
  ],
  "hooks": {
    "theme-changed": {
      "run": "notify.sh",
      "arguments": [
        "The theme changed"
      ]
    }
  },
  "ui": {
    "tiles": [
      {
        "id": "hello",
        "title": "Hello",
        "icon": "☀",
        "qml": "HelloTile.qml",
        "panel": "hello-panel"
      }
    ],
    "panels": [
      {
        "id": "hello-panel",
        "title": "Hello status",
        "qml": "HelloPanel.qml"
      }
    ],
    "widgets": [
      {
        "id": "clock",
        "title": "Clock",
        "qml": "ClockWidget.qml",
        "minWidth": 144,
        "minHeight": 96,
        "defaultWidth": 240,
        "defaultHeight": 144
      }
    ],
    "barItems": [
      {
        "id": "status-dot",
        "title": "Example status",
        "qml": "StatusDot.qml",
        "panel": "hello-panel"
      }
    ]
  }
}
