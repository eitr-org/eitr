[Unit]
Description=Elephant launcher backend
After=graphical-session.target
Wants=elephant-search-warm.service

[Service]
Type=simple
Environment=EITR_CODE_ROOT=/usr/share/eitr
# Terminals opened from menus get a solid background and float (walker/bin/menu-path/kitty).
ExecStart=/usr/bin/env PATH=/usr/share/eitr/walker/bin/menu-path:${PATH} /usr/bin/elephant
# Wait only for query readiness; the separate warm-up unit builds the index.
ExecStartPost=-/usr/bin/python3 /usr/share/eitr/walker/scripts/menus/search-index.py ready
Restart=on-failure
# Menu-launched applications must survive backend stops and restarts.
KillMode=process

[Install]
WantedBy=graphical-session.target
