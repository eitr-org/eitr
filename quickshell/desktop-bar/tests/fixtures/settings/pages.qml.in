import QtQuick
import Quickshell
import Quickshell.Bluetooth
import "." as Bar
ShellRoot {
 id: fixture
 function find(item, name) {
  if (item.objectName === name) return item;
  for (const child of item.children || []) { const result = find(child, name); if (result) return result; }
  return null;
 }
 QtObject {
  id: network
  property bool busy: false
  property var details: ({updatedAt: 1, error: "", data: {backend: "iwd", devices: [{path: "/fixture", state: "connected", powered: true, scanning: false, details: {interface: "wlan-fixture", ip: "192.0.2.10", ipv6: "2001:db8::10", mac: "02:00:00:00:00:02", dns: "192.0.2.1", gateway: "192.0.2.1", band: "5 GHz", frequency: 5180, channel: 36, speed: 867, security: "WPA2-Personal", standard: "802.11ac"}, networks: [{name: "Example WiFi", path: "/example", connected: true, known: true, strength: 75, type: "psk"}, {name: "Saved network", path: "/saved", connected: false, known: true, available: false, strength: null, knownPath: "/known/saved"}, {name: "Cafe guest", path: "/guest", connected: false, known: false, available: true, strength: 55, type: "open"}]}]}})
  property var latency: ({data: {ping: 18.4}})
  function observe(owner, topic) { return topic || "details"; }
  function release(token) {}
  function detach(owner) {}
  function refresh() {}
  function actionMessage(message) { return message; }
 }
 QtObject {
  id: adapter
  property bool enabled: true
  property var devices: ({values: [keyboard, headset, speaker, unnamed]})
 }
 QtObject { id: keyboard; property string name: "Example keyboard"; property string address: "02:00:00:00:00:10"; property string icon: "input-keyboard"; property bool connected: true; property bool paired: true; property bool pairing: false; property int state: BluetoothDeviceState.Connected; property bool batteryAvailable: true; property real battery: 0.75 }
 QtObject { id: headset; property string name: "Example headset"; property string address: "02:00:00:00:00:11"; property string icon: "audio-headset"; property bool connected: false; property bool paired: true; property bool pairing: false; property int state: BluetoothDeviceState.Disconnected; property bool batteryAvailable: false; property real battery: 0 }
 QtObject { id: speaker; property string name: "Example speaker"; property string address: "02:00:00:00:00:12"; property string icon: "audio-card"; property bool connected: false; property bool paired: false; property bool pairing: false; property int state: BluetoothDeviceState.Disconnected; property bool batteryAvailable: false; property real battery: 0 }
 QtObject { id: unnamed; property string name: "02-00-00-00-00-13"; property string address: "02:00:00:00:00:13"; property string icon: ""; property bool connected: false; property bool paired: false; property bool pairing: false; property int state: BluetoothDeviceState.Disconnected; property bool batteryAvailable: false; property real battery: 0 }
 Bar.SettingsWindow {
  id: window; live: false
  networkService: network
  foreground: "FOREGROUND"; background: "BACKGROUND"; accent: "#9a815c"
 }
 Timer {
  interval: 180; running: true; repeat: true
  property var pages: ["system", "appearance", "appearance/fonts", "appearance/terminal", "streaming", "assistants", "connections/bluetooth", "displays/nightlight", "bar", "windows", "lockscreen", "notifications", "focus", "displays", "sound", "connections", "input", "keybinds", "default-apps", "user", "security", "updates", "check-pc", "about"]
  property int current: 0
  property int phase: 0
  property bool saved: false
  onTriggered: {
   const content = fixture.find(window.contentItem, "settings-content");
   if (phase === 0) {
    Bar.SiteStyle.light = "PALETTE" === "light";
    Bar.SettingsPalette.select("PALETTE" === "website" ? "website" : "theme", false);
    window.show(pages[current]);
    window.implicitWidth = 1100; window.implicitHeight = 800;
   } else if (phase === 1) {
    const overview = fixture.find(content, "settings-overview");
    overview.account = {name: "Eitr Explorer", initial: "E"};
    overview.artSource = "file://ARTWORK";
    overview.hardware = {data: {sections: [{title: "CPU", name: "8 cores", usage: 12}, {title: "GPU", name: "Graphics", usage: 8}, {title: "RAM", name: "32 GiB", usage: 36}]}};
    overview.version = "0.7.0 · Huginn"; overview.channel = "stable"; overview.uptimeSeconds = 18900;
    overview.themePalette = {background: "BACKGROUND", foreground: "FOREGROUND", accent: "#9a815c", color1: "#ba6472", color2: "#719669", color3: "#d1ad60", color4: "#6a90b9", color5: "#a585b0", color6: "#69a5a0"};
    const state = fixture.find(content, "settings-style-state");
    state.cursorChoices = {family: [{id: "bibata", label: "Bibata", selected: true}, {id: "breeze", label: "Breeze", selected: false}], size: [{id: "24", label: "24", selected: true}, {id: "32", label: "32", selected: false}], color: [{id: "auto", label: "Auto", selected: true}, {id: "white", label: "White", selected: false}]};
    state.lockscreens = [{value: "hyprlock", label: "Hyprlock"}, {value: "eitr", label: "Eitr"}]; state.lockscreen = "eitr";
    state.terminalChoices = [{value: "kitty", label: "Kitty"}, {value: "ghostty", label: "Ghostty"}];
    state.terminalAppearance = {opacity: "opaque", padding: "normal", blur: "on", "blur-strength": "medium"};
    state.terminalAppearanceChoices = {opacity: [{value: "opaque", label: "Opaque"}, {value: "transparent", label: "Transparent"}], padding: [{value: "normal", label: "Normal"}], blur: [{value: "on", label: "On"}], "blur-strength": [{value: "medium", label: "Medium"}]};
    fixture.find(content, "settings-font-helper").summary = {current: "JetBrainsMono Nerd Font", available: true, choices: [{value: "JetBrainsMono Nerd Font", label: "JetBrainsMono Nerd Font", available: true}, {value: "Inter", label: "Inter", available: true}]};
    fixture.find(content, "settings-workspace-helper").summary = {current: "Runes", available: true, choices: ["Dots", "Glyph", "Numbers", "Runes"].map(value => ({value: value, label: value}))};
    fixture.find(content, "settings-bar-helper").summary = {current: {layout: "unified", edge: "top", appearance: "solid", screens: "main", clock: "12h", mediaStyle: "bars", dock: "yes"}, available: true, choices: {}};
    const appearance = [{name: "Eitr", value: "eitr", image: "file://ARTWORK", current: true}, {name: "Vanaheim", value: "vanaheim", image: "file://ARTWORK", current: false}];
    fixture.find(content, "settings-theme-model").items = appearance;
    fixture.find(content, "settings-wallpaper-model").items = appearance;
    const bluetooth = fixture.find(content, "settings-bluetooth-page");
    bluetooth.adapter = adapter;
    const keyboard = fixture.find(content, "settings-input-content");
    keyboard.layouts = [{index: 0, label: "English (US)"}, {index: 1, label: "Portuguese (Brazil)"}]; keyboard.selected = 0;
    const system = fixture.find(content, "settings-system-page");
    system.accountPicture = {name: "Eitr Explorer", initial: "E", path: ""};
    if (pages[current] === "user") {
     // The crop editor lives in a sheet over the window, never inline on the page.
     if (fixture.find(content, "settings-profile-picture")) throw new Error("inline profile editor");
     if (!fixture.find(content, "settings-change-picture").visible) throw new Error("Change picture missing");
     if (fixture.find(content, "settings-remove-picture").visible) throw new Error("Remove shown without a picture");
    }
    system.channel = "stable";
    system.updates = {status: "ready", data: {count: 7}};
    system.checks = [{group: "Updates", status: "info", message: "The cached package list is current."}, {group: "Storage", status: "warning", message: "Free disk space is low.", meaning: "Free some space before updating."}];
    const summary = pages[current] === "keybinds" ? [{group: "Launchers", title: "Open terminal", detail: "SUPER + Enter"}, {group: "Windows", title: "Close window", detail: "SUPER + Q"}] : pages[current] === "about" ? [{title: "Version", detail: "0.7.0"}, {title: "Codename", detail: "Huginn"}, {title: "Update Channel", detail: "Stable"}, {title: "Kernel", detail: "Linux"}, {title: "Licence", detail: "GPL-3.0-or-later"}] : pages[current] === "security" ? [{tab: "protection", title: "Firewall", detail: "Eitr firewall active.", actionMenu: "security"}, {tab: "sign-in", title: "Fingerprint", detail: "Review status and settings", menu: "fingerprint", controls: [{title: "Enable Fingerprint Authentication", detail: "Password fallback retained", actionMenu: "fingerprint"}, {title: "Enroll Fingerprint", detail: "Requires a supported reader", actionMenu: "fingerprint"}]}] : [{title: "Personal", detail: "Eitr Explorer · explorer@example.invalid · Default", menu: "git-accounts", provider: "git", providerTitle: "Git identities", account: "fixture", controls: [{title: "Make Default", detail: "Use this identity outside folder rules", gitAccount: "fixture"}, {title: "Remove Folder", detail: "Stop using this account in a folder", gitAccount: "fixture", options: ["~/Projects/example"]}]}, {title: "Work", detail: "Eitr Explorer · ~/Projects/work", menu: "git-accounts", provider: "git", providerTitle: "Git identities", account: "work", controls: [{title: "Test Connection", detail: "Check the SSH key with the host", gitAccount: "work"}]}, {title: "Example", detail: "example-profile", menu: "cloud", provider: "aws", providerTitle: "AWS", context: "example-profile", controls: [{title: "Rename", detail: "Example", command: []}]}, {title: "fixture", detail: "Example account", menu: "cloud", provider: "cloudflare", providerTitle: "Cloudflare", context: "fixture", controls: [{title: "Sign In", detail: "fixture", command: []}, {title: "Delete Account", detail: "Remove local sign-in; the remote account is kept.", cloudDelete: "fixture", provider: "cloudflare"}]}];
    fixture.find(content, "settings-system-helper").summary = {items: pages[current] === "user" ? [{current: true, title: "Eitr Explorer", login: "explorer", detail: "Administrator", initial: "E", picture: ""}, {current: false, title: "Ana Lima", login: "ana", detail: "Standard", initial: "A", picture: ""}] : pages[current] === "assistants" ? [{title: "Example assistant", detail: "Installed", controls: [{title: "Default", detail: "Current", command: []}, {title: "Add Account…", detail: "Sign in to a separate account", command: []}]}, {title: "Ratatoskr (local, experimental)", detail: "Runs only on this PC; less reliable than cloud assistants", controls: [{title: "Set Up", detail: "Set up an assistant that runs only on this PC", command: []}]}] : summary,
     choices: [{value: "codex", label: "Example assistant"}], current: "codex", access: "ask", collaboration: true,
     hardware: [{title: "CPU", name: "8 cores"}, {title: "RAM", name: "32 GiB"}, {title: "Storage", name: "Example SSD · NVMe SSD · 1.0 TB"}]};
    fixture.find(content, "settings-default-apps-helper").summary = {items: ["Web browser", "File manager", "Text editor", "Image viewer", "Video player", "Music player", "Mail", "PDF viewer", "Terminal"].map(label => ({kind: "fixture", label: label, current: "fixture.desktop", name: "Example app", choices: [{value: "fixture.desktop", label: "Example app"}, {value: "other.desktop", label: "Other app"}]}))};
   } else if (phase === 2) {
    if (pages[current] === "connections") {
     const wifi = fixture.find(content, "settings-wifi-page");
     if (!wifi || !wifi.visible || wifi.devices.length !== 1) throw new Error("Settings Wi-Fi missing");
     if (wifi.fields.length !== 14 || wifi.fields[1].value !== "WPA2-Personal") throw new Error("Wi-Fi details: " + JSON.stringify(wifi.fields));
    }
    if (pages[current] === "connections/bluetooth") {
     const bluetooth = fixture.find(content, "settings-bluetooth-page");
     if (!bluetooth || !bluetooth.visible) throw new Error("Settings Bluetooth missing");
     if (bluetooth.groups.connected.length !== 1 || bluetooth.groups.known.length !== 1 || bluetooth.groups.other.length !== 1 || bluetooth.groups.unnamed.length !== 1) throw new Error("Bluetooth groups");
    }
    if (pages[current] === "assistants") {
     const assistant = fixture.find(content, "settings-default-assistant");
     const access = fixture.find(content, "settings-assistant-access");
     if (!assistant || assistant.current !== "codex" || !access || access.current !== "ask") throw new Error("AI Assistant choices");
    }
    if (pages[current] === "streaming") {
     const streaming = fixture.find(content, "settings-streaming-page");
     streaming.snapshot = {status: "ready", data: {allowed: true, streaming: {installed: true, moonlightInstalled: true, running: false, startAtLogin: true,
      status: "Sharing stopped", facts: [{label: "Host", value: "Sunshine"}], actions: [
       {menu: "remote-share", source: "Start Sharing", title: "Start Sharing"},
       {menu: "remote-share", source: "Pair a Device", title: "Pair a Device"},
       {menu: "remote-share-setup", source: "Set Up Sharing", title: "Set Up Sharing", description: "Review screen capture and input permissions"},
       {menu: "remote-share-setup", source: "Restore Sharing Setup", title: "Restore Sharing Setup", description: "Undo capture and virtual input permissions"}]}}};
    }
    if (pages[current] === "default-apps") {
     const card = fixture.find(content, "settings-default-app-card");
     if (!card || card.width < 200 || card.height < 60 || !card.visible) { console.error("DEFAULT_CARD", card ? card.width : -1, card ? card.height : -1); Qt.exit(1); return; }
    }
    saved = false;
    content.grabToImage(result => { if (!result.saveToFile("OUTPUT/PALETTE-" + pages[current].replace("/", "-") + ".png")) throw new Error("render save"); saved = true; });
   } else if (phase === 3) {
    if (!saved) return;
    const desktop = fixture.find(content, "settings-desktop-page");
    const devices = fixture.find(content, "settings-devices-page");
    const pageView = desktop.visible ? desktop : devices.visible ? devices : fixture.find(content, "settings-system-page");
    if (pageView) pageView.contentY = Math.max(0, pageView.contentHeight - pageView.height);
   } else if (phase === 4) {
    if (["appearance", "bar", "windows", "lockscreen", "notifications", "focus", "connections", "sound", "displays", "input", "keybinds", "default-apps", "user", "security", "assistants", "updates", "check-pc", "about"].includes(pages[current].split("/")[0])) {
     saved = false;
     content.grabToImage(result => { if (!result.saveToFile("OUTPUT/PALETTE-" + pages[current].replace("/", "-") + "-bottom.png")) throw new Error("render save"); saved = true; });
    }
   } else if (phase === 5) {
    if (!saved) return;
    const desktop = fixture.find(content, "settings-desktop-page");
    const devices = fixture.find(content, "settings-devices-page");
    const pageView = desktop.visible ? desktop : devices.visible ? devices : fixture.find(content, "settings-system-page");
    const footer = fixture.find(pageView, "settings-page-handbook");
    if (pageView.visible && footer) {
     const position = footer.mapToItem(pageView, 0, 0).y;
     if (position < -1 || position + footer.height > pageView.height + 1) throw new Error("unreachable final row: " + pages[current]);
    }
    current++;
    if (current === pages.length) { window.closeSettings(); console.log("PAGES_OK"); Qt.quit(); return; }
    phase = -1;
   }
   phase++;
  }
 }
}
