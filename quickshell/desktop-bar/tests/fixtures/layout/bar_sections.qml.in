import QtQuick
import Quickshell
import Quickshell.Io
ShellRoot {
    id: shell
    property bool verticalBar: false
    property string barClock: "24h"
    property string barEdge: "top"
    property bool notchLayout: false
    property bool centeredLayout: false
    property bool dynamicLayout: false
    property bool dropLayout: false
    property bool floatingIslands: islandsLayout
    property bool islandsLayout: false
    property bool barCollapseIcons: true
STATUS_BINDINGS
    property bool statusOpen: false
    property bool dragCandidate: false
    property bool barPointerHeld: false
    property string barSideStyle: "slopes"
    property int tabStripThickness: 7
    property int tabBendRound: 8
    property bool barVisible: true
    property bool focused: false
    property bool barPinned: false
    property bool dictating: false
    property bool transcribing: false
    property var dictationLevels: []
    property string barMediaStyle: "wave"
    property string wifiGlyph: "WiFi"
    property real workspaceItemSize: 24
    property real workspaceItemSpacing: 4
    property var screenGaps: [8, 8, 8, 8]
    property color fg: "white"
    readonly property color barFg: fg
    function barSurface() { return barBackground ? barBackground() : "transparent"; }
    property color activeBg: "cyan"
    property color workspaceMenuBg: "black"
    property string idleLockGlyph: "I"
    property string idleLockTooltip: "Idle Lock"
    property string updatesIcon: "U"
    property string updatesTooltip: "Updates"
    property var updates: ({checking: false})
    property var battery: ({available: true, percent: 80, status: "Discharging"})
    property string batteryIcon: "B"
    property int remoteObservers: 0
    function barBackground() { return workspaceMenuBg; }
    function updateBarSetting(key, value) {}
    function barDoubleClick(button) {}
    function checkUpdates() {}
    function openSystemUpdate() {}
    QtObject { id: networkOwner }
    QtObject { id: remoteAccessService; property bool allowed: true }
    QtObject { id: notificationCenter; property bool opened: false }
    QtObject { id: batteryMenu; property bool opened: false }
    QtObject { id: mediaMenu; property bool opened: false }
    FloatingWindow {
        visible: true; implicitWidth: 1920; implicitHeight: 1080
        Item {
            id: bar; width: parent.width; height: parent.height
            property real clockPluginExtent: 0
            property bool centeredLayout: shell.centeredLayout
            property bool dynamicLayout: shell.dynamicLayout
            property bool dropLayout: shell.dropLayout
            property var islandSurfaces: islands
            property bool attachedIslands: false
            property int normalThickness: shell.verticalBar ? 56 : 32
            property var autoHideRef: ({progress: 1})
            property real tabLeadingEnd: 290
            property real tabCenterStart: centerInfo.x - 8
            property real tabCenterEnd: centerInfo.x + centerInfo.width + 8
            property real tabTrailingStart: (shell.verticalBar ? verticalEnd.y : rightSide.x) - 8
            property var leftGroup: leftGroupItem
            property var verticalControlCenterLogo: mockLogo
            property var verticalOverviewIcon: mockWorkspaces
            property var verticalWorkspaces: mockWorkspaces
            property var verticalHardware: mockStatus
            property var clockPlugins: mockLogo
            property bool floatingIslands: islandsLayout
            property bool islandsLayout: shell.islandsLayout
            property bool notchLayout: shell.notchLayout
            property bool expanded: true
            property var clockActivity: ({bellAngle: 0, flash: 0})
            function showControlCenter(page) {}
            property real leadingReveal: 320
            readonly property real centerExtent: (shell.verticalBar ? verticalCalendarIcon.height : centerInfo.width) + 16
            readonly property real trailingReveal: endPadding + (shell.verticalBar ? verticalEnd.height : rightSide.width) + itemGap
            property real endPadding: shell.verticalBar ? 8 : 12
            property real itemGap: 4
            property real islandSpacing: 16
            property real weatherReveal: 27
            property var screen: ({height: 1080})
            function togglePanel(panel) { panel.opened = !panel.opened; }
            function openPluginPanel(plugin, panel, target) {}
            property Item stripItem: strip
            property var notificationsRef: QtObject { property int count: 0; property bool doNotDisturb: false }
            property var remoteServiceRef: remoteAccessService
            property var horizontalIcons: ({})
            property var verticalIcons: ({})
            Item { id: emptyVertical }
            function registerIconItem(vertical, id, item) {
                const next = BarIconOrder.updateRegistry(vertical ? verticalIcons : horizontalIcons, id, item, null);
                if (!next) return;
                if (vertical) verticalIcons = next; else horizontalIcons = next;
            }
            function unregisterIconItem(vertical, id, item) {
                const next = BarIconOrder.updateRegistry(vertical ? verticalIcons : horizontalIcons, id, null, item);
                if (!next) return;
                if (vertical) verticalIcons = next; else horizontalIcons = next;
            }
            function iconZone(id) { return BarIconOrder.zoneOf(id); }
            function iconItem(id) { return (shell.verticalBar ? verticalIcons[id] : horizontalIcons[id]) || null; }
            readonly property var notificationIcon: horizontalIcons["notifications"] || rightSide
            function iconTarget(id, fallback, hiddenFallback) {
                return BarIconOrder.resolveTarget(iconItem(id), iconZone(id), shell.iconsOpen, shell.verticalBar,
                    hiddenFallback || bar.notificationIcon || bar.rightSide, fallback || stripItem);
            }
ALIASES
            BarCenteredOutline { host: shell; barHost: bar }
            Rectangle {
                id: strip
                color: shell.islandsLayout || shell.notchLayout || shell.centeredLayout ? "transparent" : shell.workspaceMenuBg
                BarIslands { id: islands; host: shell; barHost: bar }
                BarTabs { id: tabs; host: shell; barHost: bar }
                Item { id: mockLogo; x: 10; width: 24; height: 24 }
                Text { anchors.centerIn: mockLogo; text: "ᛖ"; color: shell.fg }
                visible: !shell.focused
                width: shell.verticalBar ? 56 : (bar.centeredLayout ? bar.centerExtent + bar.leadingReveal + bar.trailingReveal : bar.width)
                height: shell.verticalBar ? (bar.centeredLayout ? bar.centerExtent + bar.leadingReveal + bar.trailingReveal : bar.height) : 32
                x: shell.verticalBar ? (shell.barEdge === "right" ? bar.width - width : 0) : (bar.centeredLayout ? (bar.width - bar.centerExtent) / 2 - bar.leadingReveal : 0)
                y: shell.verticalBar ? (bar.centeredLayout ? (bar.height - bar.centerExtent) / 2 - bar.leadingReveal : 0) : (shell.barEdge === "bottom" ? bar.height - height - (shell.islandsLayout ? 4 : 0) : shell.islandsLayout ? 4 : 0)
                Item { id: mockWorkspaces; x: 52; width: 134; height: 24
                    Text { anchors.centerIn: parent; text: "ᚠ  ᚢ  ᚦ  ᚨ  ᚱ"; color: shell.fg }
                }
                Item { id: mockStatus; x: 200; width: 80; height: 24
                    Text { anchors.centerIn: parent; text: "AI  󰍛  󰌾"; color: shell.fg; font.family: "JetBrainsMono Nerd Font"; font.pixelSize: 14 }
                }
                // The bar exposes its left items through BarLeftGroup; the fixture mirrors that.
                QtObject {
                    id: leftGroupItem
                    readonly property Item workspaces: mockWorkspaces
                    readonly property Item hardwareStatus: mockStatus
                    readonly property Item controlCenterLogo: mockLogo
                    readonly property Item overviewIcon: mockWorkspaces
                    readonly property Item workspaceButtonRow: mockWorkspaces
                }
                Item {
                    anchors.fill: parent; visible: !shell.verticalBar
HORIZONTAL
                }
                Item { anchors.fill: parent; visible: shell.verticalBar
VERTICAL
                }
            }
            readonly property var statusRenders: STATUS_RENDERS
            property int renderIndex: 0
            property int step: 0
            function applyLayout(mode) {
                shell.centeredLayout = mode === 1;
                shell.notchLayout = mode === 2;
                shell.islandsLayout = mode === 3;
                shell.dynamicLayout = mode === 4;
                shell.dropLayout = mode === 5;
            }
            function renderNext() {
                if (bar.renderIndex === bar.statusRenders.length) {
                    console.log("BAR_SECTIONS_OK");
                    Qt.quit();
                    return;
                }
                const [mode, enabled, opened, light, name] = bar.statusRenders[bar.renderIndex++];
                bar.applyLayout(mode);
                shell.barCollapseIcons = enabled;
                shell.statusOpen = opened;
                shell.fg = light ? "#262a35" : "#e9edf3";
                shell.workspaceMenuBg = light ? "#f1f3fa" : "#242b37";
                captureTimer.output = name;
                captureTimer.restart();
            }
            Timer {
                id: captureTimer
                property string output
                interval: 60
                onTriggered: {
                    bar.grabToImage(function(result) {
                        if (!result.saveToFile(output)) { Qt.exit(1); return; }
                        bar.renderNext();
                    });
                }
            }
            property int scenario: 0
            property bool snapshotRequested: false
            readonly property var pluginStates: ["start", "disabled", "start", "unplaced", "status", "removed"]
            Process { id: writePlacement }
            function exerciseFull() {
                const toggle = bar.statusToggle;
                const zone = bar.rightSide.rightZone;
                if (bar.scenario === 0) {
                    if (!PluginRegistry.snapshotLoaded) return;
                    shell.barEdge = "top";
                    shell.verticalBar = false;
                    bar.applyLayout(0);
                    shell.barCollapseIcons = true;
                    shell.statusOpen = false;
                    shell.battery = ({available: false, percent: 80, status: "Discharging"});
                    remoteAccessService.allowed = false;
                    bar.keyboardMenu.layouts = ["us"];
                    bar.scenario++;
                    return;
                }
                const state = bar.pluginStates[bar.scenario - 1];
                for (const itemId of ["wifi", "bluetooth", "display", "audio", "notifications"]) {
                    if (!zone.items.some(entry => entry.id === itemId)) throw new Error("Missing built-in " + itemId);
                }
                if (!zone.hasHideable || toggle.visible === shell.focused || toggle.width !== shell.workspaceItemSize ||
                        (!shell.focused && bar.rightSide.width < toggle.width + bar.notificationIcon.width))
                    throw new Error("Full status toggle collapsed in " + state);
                if (state) {
                    const entry = {plugin: "github", id: "activity", title: state, kind: "barItems", disabled: state === "disabled"};
                    const placement = {plugin: entry.plugin, id: entry.id, slot: state === "status" ? "status" : "start"};
                    const snapshot = {
                        entries: state === "removed" ? [] : [entry], installed: [],
                        placements: {barItems: ["removed", "unplaced"].includes(state) ? [] : [placement]}
                    };
                    if (!bar.snapshotRequested) {
                        const path = Quickshell.env("XDG_CONFIG_HOME") + "/eitr/plugin-placements.json";
                        writePlacement.command = ["python3", "-c",
                            "import sys; from pathlib import Path; p = Path(sys.argv[1]); tmp = p.with_suffix('.tmp'); tmp.write_text(sys.argv[2]); tmp.replace(p)",
                            path, JSON.stringify(snapshot)];
                        writePlacement.running = true;
                        bar.snapshotRequested = true;
                        return;
                    }
                    if (PluginRegistry.entries[0]?.title !== snapshot.entries[0]?.title ||
                            JSON.stringify(PluginRegistry.placements.barItems) !== JSON.stringify(snapshot.placements.barItems)) return;
                    const placed = state === "status" ? "right" : state === "start" ? "left" : "";
                    if (BarIconOrder.zoneOf("github:activity") !== placed)
                        throw new Error("Plugin placement changed in " + state);
                    bar.snapshotRequested = false;
                }
                if (bar.scenario === 1) bar.brightnessMenu.opened = true;
                if (bar.scenario === 2) {
                    bar.brightnessMenu.opened = false;
                    notificationCenter.opened = true;
                    bar.notificationsRef.count = 120;
                    shell.fg = "#212530";
                    shell.workspaceMenuBg = "#f1f3fa";
                }
                if (bar.scenario === 3) notificationCenter.opened = false;
                if (bar.scenario === 4) {
                    shell.statusOpen = true;
                }
                if (bar.scenario === 5) {
                    if (toggle.icon !== "›") throw new Error("Expanded chevron changed");
                    toggle.clicked(Qt.LeftButton);
                    if (shell.statusOpen || toggle.icon !== "‹") throw new Error("Click did not collapse the icons");
                }
                if (bar.scenario === bar.pluginStates.length) shell.focused = true;
                if (bar.scenario === bar.pluginStates.length + 1) shell.focused = false;
                if (++bar.scenario > bar.pluginStates.length + 3) {
                    timer.stop();
                    strip.grabToImage(function(result) {
                        if (!result.saveToFile(CAPTURE_PATH)) { Qt.exit(1); return; }
                        bar.height = 40;
                        bar.notificationsRef.count = 0;
                        bar.mediaStrip.visible = false;
                        bar.renderNext();
                    });
                }
            }
            Timer {
                id: timer
                interval: 30; running: true; repeat: true
                onTriggered: {
                    if (bar.step === 144) {
                        try { bar.exerciseFull(); }
                        catch (error) { console.error(error); Qt.exit(1); }
                        return;
                    }
                    const edges = EDGES;
                    const modes = [0, 4, 1, 5, 2, 3];
                    const mode = modes[Math.floor(bar.step / 12) % modes.length];
                    const state = Math.floor(bar.step / 4) % 3;
                    shell.barEdge = edges[bar.step % 4];
                    shell.verticalBar = shell.barEdge === "left" || shell.barEdge === "right";
                    bar.applyLayout(mode);
                    shell.barCollapseIcons = state !== 2;
                    shell.statusOpen = state === 1;
                    bar.width = bar.step < 72 ? 1920 : 1366;
                    bar.height = bar.step < 72 ? 1080 : 768;
                    Qt.callLater(function() {
                        try {
                        const toggle = shell.verticalBar ? bar.verticalEnd.statusToggleItem : bar.statusToggle;
                        if (toggle.visible !== (mode < 4 && state !== 2))
                            throw new Error("Status toggle visibility at step " + bar.step + ": " + toggle.visible);
                        if (toggle.visible) {
                            const status = shell.verticalBar ? bar.verticalEnd : bar.rightSide;
                            const extent = shell.verticalBar ? status.height : status.width;
                            const toggleExtent = shell.verticalBar ? toggle.height : toggle.width;
                            if (extent < toggleExtent + 2 * shell.workspaceItemSize)
                                throw new Error("Right group lost its chevron slot at step " + bar.step);
                            if (shell.notchLayout) {
                                const center = toggle.mapToItem(tabs.trailingTabItem, toggle.width / 2, toggle.height / 2);
                                if (!tabs.trailingTabItem.contains(center))
                                    throw new Error("Chevron outside trailing tab at step " + bar.step);
                            }
                            if (shell.islandsLayout && islands.pillFor(toggle) !== islands.pillFor(bar.iconItem("notifications")))
                                throw new Error("Chevron outside status pill at step " + bar.step);
                        }
                        const showHideable = mode >= 4 || state !== 0;
                        for (const itemId of ["wifi", "bluetooth", "display", "audio", "streaming", "keyboard", "obs", "updates", "battery", "notifications"]) {
                            const item = bar.iconItem(itemId);
                            const shown = item && item.visible && (shell.verticalBar ? item.height : item.width) > 0;
                            if (shown !== (showHideable || itemId === "battery" || itemId === "notifications"))
                                throw new Error("Status icon " + itemId + " at step " + bar.step + ": " + shown);
                        }
                        const clock = shell.verticalBar ? bar.verticalCalendarIcon : bar.centerInfo;
                        const position = clock.mapToItem(bar, clock.width / 2, clock.height / 2);
                        const actual = shell.verticalBar ? position.y : position.x;
                        const expected = (shell.verticalBar ? bar.height : bar.width) / 2;
                        if (Math.abs(actual - expected) > 0.01) throw new Error("Clock displaced: " + actual + " / " + expected);
                        for (const item of [bar.centerInfo, bar.barCapture, bar.barPin,
                                bar.verticalCalendarIcon, bar.verticalCapture,
                                bar.wifiIcon, bar.bluetoothIcon, bar.obsIcon, bar.keyboardIcon,
                                bar.verticalWifiIcon, bar.verticalBluetoothIcon, bar.verticalObsIcon]) {
                            if (item.host !== shell) throw new Error("Missing host: " + item);
                        }
                        const calendarTarget = shell.verticalBar ? bar.verticalCalendarIcon : bar.centerInfo;
                        if (bar.calendarMenu.target !== calendarTarget || bar.weatherMenu.target !== (shell.verticalBar ? bar.verticalWeatherIcon : bar.centerInfo))
                            throw new Error("Centre panel target changed");
                        const statusTargets = [[bar.wifiMenu, bar.verticalWifiIcon, bar.wifiIcon],
                            [bar.bluetoothMenu, bar.verticalBluetoothIcon, bar.bluetoothIcon],
                            [bar.brightnessMenu, bar.verticalDisplayIcon, bar.brightnessIcon],
                            [bar.volumeMenu, bar.verticalVolumeIcon, bar.volumeIcon],
                            [bar.keyboardMenu, bar.verticalKeyboardIcon, bar.keyboardIcon]];
                        for (const entry of statusTargets) {
                            const expectedTarget = shell.verticalBar ? entry[1] : shell.iconsOpen ? entry[2] : bar.notificationIcon;
                            if (entry[0].target !== expectedTarget) throw new Error("Status panel target changed");
                        }
                        if (bar.recordingMenu.target !== (shell.verticalBar ? bar.verticalCapture : bar.barCapture)
                                || bar.recordingMenu.controller !== bar.obsMenu)
                            throw new Error("Recording panel wiring changed");
                        if (toggle.visible) {
                            const wasOpen = shell.statusOpen;
                            toggle.clicked(Qt.LeftButton);
                            if (shell.statusOpen === wasOpen || shell.iconsOpen === wasOpen)
                                throw new Error("Chevron did not toggle at step " + bar.step);
                        }
                        bar.step++;
                        } catch (error) { console.error(error); Qt.exit(1); }
                    });
                }
            }
        }
    }
}
