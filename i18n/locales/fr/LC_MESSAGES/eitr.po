msgstr "{staging} ou {old} provient d’une tentative précédente ; vérifiez avant de supprimer"

msgid "{status_label}: flagged {flagged_date}"
msgstr "{status_label} : signalé le {flagged_date}"

msgid "{subscription_count} subscription(s) are ready in the Azure menu."
msgstr "{subscription_count} abonnement(s) disponible(s) dans le menu Azure."

