msgid "{path} is not valid JSON; fix or remove it."
msgstr "{path} n'est pas un JSON valide ; corrigez-le ou supprimez-le."

msgid "{path} is outside the root snapshot. Configure a coordinated snapshot backend first."
msgstr "{path} est hors de l’instantané racine. Configurez d’abord un service d’instantanés coordonnés."

msgid "{path} is too small for Eitr"
msgstr "{path} est trop petit pour Eitr"

msgid "{path} still refers to the installation medium"
msgstr "{path} désigne encore le support d’installation"

