msgstr "{provider_name} nécessite la commande {command}"

msgid "{relative_path} is no longer read-only; the restore point is not trusted"
msgstr "{relative_path} n’est plus en lecture seule ; le point de restauration n’est pas fiable"

msgid "{setup} already exists"
msgstr "{setup} existe déjà"

msgid "{shown} and {count} more"
msgstr "{shown} et {count} autres"

