msgstr "AWS CLI가 {profile} 프로필을 생성하지 않았습니다"

msgid "The AWS profile {profile} already exists; rename it with Ctrl+R in the AWS menu"
msgstr "AWS 프로필 {profile}이(가) 이미 존재합니다. AWS 메뉴에서 Ctrl+R로 이름을 바꾸세요"

msgid "The EFI partition changed since installation; reset is not safe"
msgstr "설치 후 EFI 파티션이 변경되었습니다. 재설정은 안전하지 않습니다"

msgid "The Ollama package is still installed; remove it with: sudo pacman -R ollama"
msgstr "Ollama 패키지가 여전히 설치되어 있습니다. 다음 명령으로 제거하세요: sudo pacman -R ollama"

msgid "The PC is short on memory and may feel slow; close apps you are not using."
msgstr "PC 메모리가 부족하여 느려질 수 있습니다. 사용하지 않는 앱을 닫으세요."

msgid "The URL must not contain spaces, control characters or backslashes."
msgstr "URL에는 공백, 제어 문자 또는 백슬래시를 포함할 수 없습니다."

msgid "The address redirected away from https."
msgstr "주소가 https가 아닌 곳으로 리디렉션되었습니다."

msgid "The answers need a password"
msgstr "답변에 비밀번호가 필요합니다"

msgid "The assistant could not complete the request."
msgstr "어시스턴트가 요청을 완료할 수 없습니다."

msgid "The assistant executable was not found after installation."
msgstr "설치 후 어시스턴트 실행 파일을 찾을 수 없습니다."

msgid "The assistant returned no answer."
msgstr "어시스턴트가 답변을 반환하지 않았습니다."

msgid "The assistant timed out."
msgstr "어시스턴트 요청 시간이 초과되었습니다."

msgid "The assistants entry changed; it was left unchanged."
msgstr "어시스턴트 항목이 변경되었으므로 그대로 유지되었습니다."

msgid "The boot menu style needs Limine; this system uses {loader}. Nothing was changed."
msgstr "부팅 메뉴 스타일에는 Limine이 필요합니다. 이 시스템은 {loader}을(를) 사용합니다. 아무것도 변경되지 않았습니다."

msgid "The boot partition has filesystem errors that can stop the PC from starting; follow the recovery guide to repair it."
msgstr "부팅 파티션에 파일 시스템 오류가 있어 PC가 시작되지 않을 수 있습니다. 복구 가이드에 따라 복구하세요."

msgid "The boot partition is almost full, so the next kernel update may not fit; free space with Cleanup."
msgstr "부팅 파티션이 거의 가득 차서 다음 커널 업데이트가 설치되지 않을 수 있습니다. 정리 도구로 공간을 확보하세요."

msgid "The browser opened a new GitHub issue. Describe what happened and attach {path}."
msgstr "브라우저에서 새 GitHub 이슈를 열었습니다. 발생한 상황을 설명하고 {path}을(를) 첨부하세요."

msgid "The calendar server redirected to an insecure address."
msgstr "캘린더 서버가 안전하지 않은 주소로 리디렉션되었습니다."

msgid "The channel is stable or testing"
msgstr "채널은 stable 또는 testing이어야 합니다"

msgid "The clock is not synchronized, which can break secure websites and updates; connect to the internet and wait a minute."
msgstr "시계가 동기화되지 않아 보안 웹사이트 및 업데이트가 작동하지 않을 수 있습니다. 인터넷에 연결하고 1분 정도 기다리세요."

msgid "The collaboration state is invalid; settings were left unchanged."
msgstr "협업 상태가 유효하지 않아 설정이 변경되지 않았습니다."

msgid "The current password is not correct."
msgstr "현재 비밀번호가 올바르지 않습니다."

msgid "The default assistant changed. Start a new chat."
msgstr "기본 어시스턴트가 변경되었습니다. 새 채팅을 시작하세요."

msgid "The eitr-sharing group must contain only the sharing account"
msgstr "eitr-sharing 그룹에는 공유 계정만 포함되어야 합니다"

msgid "The factory reset helper is missing beside the boot guard"
msgstr "부팅 보호 도구 옆에 공장 초기화 도우미가 없습니다"

msgid "The firewall is off, so other devices can reach more of this PC; turn it on in Firewall settings."
msgstr "방화벽이 꺼져 있어 다른 장치에서 이 PC에 더 많이 접근할 수 있습니다. 방화벽 설정에서 켜세요."

msgid "The firewall is off: every incoming connection reaches the apps listening for it."
msgstr "방화벽이 꺼져 있습니다. 모든 인바운드 연결이 대기 중인 앱에 도달합니다."

msgid "The firewall is on: incoming connections are refused except replies and these sharing services: {services}."
msgstr "방화벽이 켜져 있습니다. 응답과 다음 공유 서비스를 제외한 인바운드 연결이 거부됩니다: {services}."

msgid "The gcloud configuration {configuration} already exists; rename it with Ctrl+R"
msgstr "gcloud 구성 {configuration}이(가) 이미 존재합니다. Ctrl+R로 이름을 바꾸세요"

msgid "The guided install supports UEFI boot only; boot the ISO in UEFI mode"
msgstr "단계별 설치는 UEFI 부팅만 지원합니다. ISO를 UEFI 모드로 부팅하세요"

msgid "The history of {id} was rewritten: the approved commit {commit} is not part of the new one. Eitr does not update it automatically. If you still trust its author, remove the plugin and add it again."
msgstr "{id}의 기록이 다시 작성되었습니다: 승인된 커밋 {commit}이(가) 새 기록에 포함되어 있지 않습니다. Eitr는 이를 자동으로 업데이트하지 않습니다. 작성자를 여전히 신뢰한다면 플러그인을 제거하고 다시 추가하세요."

msgid "The initramfs cannot use TPM2 unlock yet. Nothing was changed."
msgstr "initramfs가 아직 TPM2 잠금 해제를 사용할 수 없습니다. 아무것도 변경되지 않았습니다."

msgid "The layout your picture, color and greeting go into."
msgstr "사진, 색상 및 인사말이 들어가는 레이아웃입니다."

msgid "The login wallpaper must be a JPEG under 25 MB"
msgstr "로그인 배경화면은 25MB 미만의 JPEG여야 합니다"

msgid "The main display stays where it is; place the other displays around it."
msgstr "주 디스플레이는 현재 위치에 유지됩니다. 다른 디스플레이를 그 주위에 배치하세요."

msgid "The model download did not finish. Run setup again to resume it."
msgstr "모델 다운로드가 완료되지 않았습니다. 설정을 다시 실행하여 재개하세요."

msgid "The name must not contain control characters."
msgstr "이름에는 제어 문자를 포함할 수 없습니다."

msgid "The name needs at least one letter or digit"
msgstr "이름에는 문자나 숫자가 하나 이상 필요합니다"

msgid "The name needs at least one letter or digit."
msgstr "이름에는 문자나 숫자가 하나 이상 필요합니다."

msgid "The new password was not accepted: {reason}"
msgstr "새 비밀번호가 허용되지 않았습니다: {reason}"

msgid "The new passwords do not match."
msgstr "새 비밀번호가 일치하지 않습니다."

msgid "The password could not be changed."
msgstr "비밀번호를 변경할 수 없습니다."

msgid "The payload has no pacman {version} package"
msgstr "The payload has no pacman {version} package"

msgid "The picture has too many pixels."
msgstr "사진의 픽셀 수가 너무 많습니다."

msgid "The picture is larger than 50 MB."
msgstr "사진 파일 크기가 50MB보다 큽니다."

msgid "The picture is too small."
msgstr "사진이 너무 작습니다."

msgid "The plugin blocklist could not be read; plugins are refused until it is fixed."
msgstr "플러그인 차단 목록을 읽을 수 없습니다. 문제가 해결될 때까지 플러그인이 거부됩니다."

msgid "The previous system is still running; see {MANUAL}"
msgstr "이전 시스템이 계속 실행 중입니다. {MANUAL}을(를) 참조하세요"

msgid "The question and the files a helper reads are sent to that helper’s provider."
msgstr "질문과 도우미가 읽는 파일은 해당 도우미의 제공자에게 전송됩니다."

msgid "The recorded organization profile is invalid."
msgstr "기록된 조직 프로필이 유효하지 않습니다."

msgid "The report opened in your text editor."
msgstr "보고서가 텍스트 편집기에서 열렸습니다."

msgid "The restore point belongs to a different filesystem"
msgstr "복원 지점이 다른 파일 시스템에 속해 있습니다"

msgid "The restore point is missing /{required}"
msgstr "복원 지점에 /{required}이(가) 없습니다"

msgid "The restore point's boot files are damaged"
msgstr "복원 지점의 부팅 파일이 손상되었습니다"

msgid "The root filesystem is not the Btrfs @ subvolume of an Eitr installation"
msgstr "루트 파일 시스템이 Eitr 설치의 Btrfs @ 서브볼륨이 아닙니다"

msgid "The root-owned Eitr helper is not installed. See distro/README.md; never sudo a user-writable helper."
msgstr "root 소유 Eitr 도우미가 설치되지 않았습니다. distro/README.md를 참조하세요. 사용자가 쓰기 가능한 도우미에 절대 sudo를 사용하지 마세요."

msgid "The root-owned Eitr helper is not installed; update the eitr-desktop package."
msgstr "root 소유 Eitr 도우미가 설치되지 않았습니다. eitr-desktop 패키지를 업데이트하세요."

msgid "The setup script {value} did not finish when it last ran; it is not run again. Change the script to allow another attempt."
msgstr "설정 스크립트 {value}이(가) 마지막 실행 시 완료되지 않았으므로 다시 실행되지 않습니다. 다른 시도를 허용하려면 스크립트를 수정하세요."

msgid "The site refused the download (HTTP {code}). {hint}"
msgstr "사이트에서 다운로드를 거부했습니다(HTTP {code}). {hint}"

msgid "The sound system is not running, so no app can play sound; log out and back in, and report a problem if it continues."
msgstr "사운드 시스템이 실행되고 있지 않아 앱에서 소리를 재생할 수 없습니다. 로그아웃했다가 다시 로그인하고, 문제가 지속되면 문제를 보고하세요."

msgid "The speech model could not transcribe this recording."
msgstr "음성 모델이 이 녹음을 텍스트로 변환할 수 없습니다."

msgid "The system disk is almost full, so updates and apps can fail; free space with Cleanup."
msgstr "시스템 디스크 공간이 거의 가득 차 업데이트 및 앱 실행에 실패할 수 있습니다. 정리 기능으로 공간을 확보하세요."

msgid "The system language {language} was not generated on the installed system"
msgstr "설치된 시스템에서 시스템 언어 {language}이(가) 생성되지 않았습니다"

msgid "The template must not name a disk"
msgstr "템플릿에 디스크 이름을 지정할 수 없습니다"

msgid "The template's EFI partition size changed; update ESP_MIB"
msgstr "템플릿의 EFI 파티션 크기가 변경되었습니다. ESP_MIB를 업데이트하세요"

msgid "The testing repository cannot be reached right now, so nothing was changed. Check the connection and try again."
msgstr "테스트 저장소에 지금 연결할 수 없어 아무것도 변경되지 않았습니다. 연결을 확인하고 다시 시도하세요."

msgid "The theme could not be applied."
msgstr "테마를 적용할 수 없습니다."

msgid "The user service could not be loaded."
msgstr "사용자 서비스를 로드할 수 없습니다."

msgid "The window manager found errors in its settings, so some shortcuts or layouts may not apply; undo recent changes to your own settings or report a problem."
msgstr "창 관리자 설정에서 오류가 발견되어 일부 단축키 또는 레이아웃이 적용되지 않을 수 있습니다. 최근 변경한 설정을 취소하거나 문제를 보고하세요."

msgid "Their login keyring will keep its old password."
msgstr "해당 계정의 로그인 키링은 이전 비밀번호를 유지합니다."

msgid "Theme"
msgstr "테마"

msgid "There is no update snapshot to go back to; the next System Update creates one."
msgstr "돌아갈 업데이트 스냅샷이 없습니다. 다음 시스템 업데이트 시 스냅샷이 생성됩니다."

msgid "This ISO has no complete offline payload ({amount} is missing)"
msgstr "이 ISO에는 완전한 오프라인 페이로드가 없습니다({amount} 누락됨)"

msgid "This PC: {addresses}"
msgstr "현재 PC: {addresses}"

msgid "This WiFi security type requires advanced network configuration"
msgstr "이 WiFi 보안 유형은 고급 네트워크 구성이 필요합니다"

msgid "This address did not return an iCal calendar."
msgstr "이 주소에서 iCal 캘린더를 반환하지 않았습니다."

msgid "This app is part of Eitr and stays installed."
msgstr "이 앱은 Eitr의 일부이며 계속 설치된 상태로 유지됩니다."

msgid "This assistant is unavailable."
msgstr "이 어시스턴트는 사용할 수 없습니다."

msgid "This calendar is already added."
msgstr "이 캘린더는 이미 추가되었습니다."

msgid "This changes login, lockscreen and sudo authentication. Password fallback is retained."
msgstr "로그인, 잠금 화면 및 sudo 인증을 변경합니다. 비밀번호 대체 인증은 유지됩니다."

msgid "This changes tailscaled startup and delegates Tailscale control to your user. Restore Away Access Setup undoes these changes."
msgstr "tailscaled 시작 방식을 변경하고 Tailscale 제어 권한을 현재 사용자에게 위임합니다. 외부 접속 설정 복원을 통해 이 변경 사항을 되돌릴 수 있습니다."

msgid "This changes the network backend only after rebooting."
msgstr "네트워크 백엔드는 재부팅 후에만 변경됩니다."

msgid "This color cannot be changed here."
msgstr "이 색상은 여기서 변경할 수 없습니다."

msgid "This computer has no factory reset point. Only computers installed with the Eitr ISO have one."
msgstr "이 컴퓨터에는 공장 초기화 지점이 없습니다. Eitr ISO로 설치된 컴퓨터에만 초기화 지점이 존재합니다."

msgid "This connects {assistants}. Each of them can then ask another one for a review, an explanation or a suggestion."
msgstr "{assistants}을(를) 연결합니다. 연결된 각 어시스턴트는 다른 어시스턴트에게 검토, 설명 또는 제안을 요청할 수 있습니다."

msgid "This display does not report HDR support."
msgstr "이 디스플레이는 HDR 지원을 보고하지 않습니다."

msgid "This family spans multiple packages; remove it with the package manager"
msgstr "이 패밀리는 여러 패키지에 걸쳐 있습니다. 패키지 관리자로 제거하세요"

msgid "This font is no longer installed"
msgstr "이 글꼴은 더 이상 설치되어 있지 않습니다"

msgid "This font is not owned by one removable package"
msgstr "이 글꼴은 제거 가능한 단일 패키지에 속해 있지 않습니다"

msgid "This host uses an SSH proxy; retain a repository-local core.sshCommand for that advanced setup"
msgstr "이 호스트는 SSH 프록시를 사용합니다. 해당 고급 설정을 위해 저장소 로컬 core.sshCommand를 유지하세요"

msgid "This installation uses an unsupported location; remove it with its own manager."
msgstr "이 설치는 지원되지 않는 위치를 사용합니다. 해당 설치 관리자를 통해 제거하세요."

msgid "This is not a picture Eitr can read."
msgstr "Eitr에서 읽을 수 있는 이미지가 아닙니다."

msgid "This keyboard layout could not be loaded"
msgstr "이 키보드 레이아웃을 로드할 수 없습니다"

msgid "This launcher is not owned by an installed package. No files were removed."
msgstr "이 런처는 설치된 패키지에 속해 있지 않습니다. 제거된 파일이 없습니다."

msgid "This layout is already added"
msgstr "이 레이아웃은 이미 추가되었습니다"

msgid "This manifest should declare schemaVersion: 1."
msgstr "이 매니페스트는 schemaVersion: 1을 선언해야 합니다."

msgid "This occurrence"
msgstr "이번 일정"

msgid "This plugin is already installed. Update or remove it from Control Center > Plugins."
msgstr "이 플러그인은 이미 설치되어 있습니다. 제어 센터 > 플러그인에서 업데이트하거나 제거하세요."

msgid "This plugin is blocked: {reason}"
msgstr "이 플러그인은 차단되었습니다: {reason}"

msgid "This plugin is on the Eitr blocklist: {reason}"
msgstr "이 플러그인은 Eitr 차단 목록에 있습니다: {reason}"

msgid "This plugin needs a newer Eitr"
msgstr "이 플러그인은 최신 버전의 Eitr가 필요합니다"

msgid "This removes TPM unlock from {device}; the passphrase is required at every boot again."
msgstr "{device}에서 TPM 잠금 해제를 제거합니다. 매 부팅마다 다시 암호가 필요합니다."

msgid "This removes the charge limit, so the battery charges to 100%."
msgstr "충전 제한을 제거하여 배터리가 100%까지 충전됩니다."

msgid "This security key is already enrolled."
msgstr "이 보안 키는 이미 등록되어 있습니다."

msgid "This sign-in has no enabled subscriptions"
msgstr "이 로그인 계정에는 활성화된 구독이 없습니다"

msgid "This switch requires systemd-resolved DNS. Review /etc/resolv.conf first; no changes made."
msgstr "이 전환에는 systemd-resolved DNS가 필요합니다. 먼저 /etc/resolv.conf를 검토하세요. 변경된 사항이 없습니다."

msgid "This tool must be removed through its installation manager."
msgstr "이 도구는 설치 관리자를 통해 제거해야 합니다."

msgid "Thursday"
msgstr "목요일"

msgid "Tiling"
msgstr "타일링"

msgid "Time"
msgstr "시간"

msgid "Time must use HH:MM (00:00-23:59)"
msgstr "시간은 HH:MM(00:00-23:59) 형식을 사용해야 합니다"

msgid "Timezone not detected yet: {error}"
msgstr "시간대가 아직 감지되지 않았습니다: {error}"

msgid "Timezone set to {zone}"
msgstr "시간대가 {zone}(으)로 설정되었습니다"

msgid "Timezone: {timezone} / Hostname: {hostname}"
msgstr "시간대: {timezone} / 호스트 이름: {hostname}"

msgid "To enable mise, add eval \"$(mise activate zsh)\" to ~/.zshrc. It can conflict with nvm/uv for the same runtime."
msgstr "mise를 활성화하려면 ~/.zshrc에 eval \"$(mise activate zsh)\"를 추가하세요. 동일한 런타임에 대해 nvm/uv와 충돌할 수 있습니다."

msgid "To restore the previous list, type restore and press Enter instead."
msgstr "이전 목록을 복원하려면 대신 restore를 입력하고 Enter를 누르세요."

msgid "Too easy to guess: avoid patterns and your user name."
