msgid ""
msgstr "Project-Id-Version: Eitr\nContent-Type: text/plain; charset=UTF-8\nLanguage: ko\nPlural-Forms: nplurals=1; plural=0;\n"

msgid "\n  Repository settings still win. Remotes, keys and CLI logins are not changed."
msgstr "\n  저장소 설정이 계속 우선 적용됩니다. 원격 저장소, 키 및 CLI 로그인은 변경되지 않습니다."

msgid "\n  Your browser opens to sign in.\n"
msgstr "\n  로그인을 위해 브라우저가 열립니다.\n"

msgid "\n  Your files stay unchanged; the imported rules take precedence from now on."
msgstr "\n  파일은 변경되지 않으며, 이제부터 가져온 규칙이 우선 적용됩니다."

msgid "\nAUR packages are built on this computer: read the build file (Ctrl+B) before installing."
msgstr "\nAUR 패키지는 이 컴퓨터에서 빌드됩니다. 설치하기 전에 빌드 파일(Ctrl+B)을 읽어보세요."

msgid "\nAbout sending it: the report is used only to find and fix this problem, and it\nis deleted once the problem is fixed. An email also shares your email address;\nreply to it anytime to have your report deleted. A GitHub issue is public.\n"
msgstr "\n전송 정보: 이 보고서는 이 문제를 찾아서 수정하는 데에만 사용되며,\n문제가 해결되면 삭제됩니다. 이메일 전송 시 사용자의 이메일 주소도 공유되며,\n언제든지 회신하여 보고서 삭제를 요청할 수 있습니다. GitHub 이슈는 공개됩니다.\n"

msgid "\nCancelled."
msgstr "\n취소되었습니다."

msgid "\nFetching the icon…"
msgstr "\n아이콘 가져오는 중…"

msgid "\nHow do you want to send it?\n  1  Email it to {email} (opens your email app; attach the saved file)\n  2  Open a GitHub issue (needs a GitHub account; issues are public)\n  3  Copy the report, to paste anywhere\n  4  Read the report (opens it in your text editor)\n  Enter  Done; the report stays saved\n"
msgstr "\n어떻게 전송하시겠습니까?\n  1  {email}(으)로 이메일 전송 (이메일 앱을 열고 저장된 파일을 첨부하세요)\n  2  GitHub 이슈 열기 (GitHub 계정 필요, 이슈는 공개됨)\n  3  보고서 복사 (어디에나 붙여넣기 가능)\n  4  보고서 읽기 (텍스트 편집기에서 열림)\n  Enter  완료 (보고서는 저장된 상태로 유지됨)\n"

msgid "\nInstallation stopped during: {failure}"
msgstr "\n다음 단계 중 설치가 중단되었습니다: {failure}"

msgid "\nInterrupted."
msgstr "\n중단되었습니다."

msgid "\nNo packages changed."
msgstr "\n변경된 패키지가 없습니다."

msgid "\nOfficial prebuilt package metadata; there is no local AUR build to execute."
msgstr "\n공식 사전 빌드 패키지 메타데이터입니다. 실행할 로컬 AUR 빌드가 없습니다."

msgid "\nUnattended installation from the answers drive will ERASE the whole disk:\n  {disk_label}\nfor user {username}, {state}."
msgstr "\n응답 드라이브를 통한 무인 설치는 다음 디스크 전체를 지웁니다:\n  {disk_label}\n대상 사용자: {username}, {state}."

msgid "\nUnattended installation from the answers drive will install beside the existing systems on:\n  {disk_label}\nfor user {username}, {state}."
msgstr "\n응답 드라이브를 통한 무인 설치는 다음 디스크의 기존 시스템 옆에 설치됩니다:\n  {disk_label}\n대상 사용자: {username}, {state}."

msgid "\nUpdate channel: {channel}. The next System Update uses it."
msgstr "\n업데이트 채널: {channel}. 다음 시스템 업데이트에서 사용됩니다."

msgid "\rStarting in {remaining} s. Press Ctrl+C to cancel."
msgstr "\r{remaining}초 후에 시작합니다. 취소하려면 Ctrl+C를 누르세요."

msgid "  Add it at {bold}, signed in as the {label} account."
msgstr "  {label} 계정으로 로그인한 상태에서 {bold}에 추가하세요."

msgid "  Backup of the previous settings: {transaction}"
msgstr "  이전 설정 백업: {transaction}"

msgid "  Choose a passphrase. The key is never copied into backups.\n"
msgstr "  암호 문구를 선택하세요. 키는 백업에 복사되지 않습니다.\n"

msgid "  No Git identity configured outside EITR was found."
msgstr "  EITR 외부에 구성된 Git ID를 찾을 수 없습니다."

msgid "  Press Enter to keep the shown name."
msgstr "  표시된 이름을 유지하려면 Enter를 누르세요."

msgid "  The AWS CLI asks for the SSO start URL and region, opens your browser to sign"
msgstr "  AWS CLI가 SSO 시작 URL 및 리전을 요청하고, 브라우저를 열어"

msgid "  The AWS CLI asks for the access key ID, secret access key, region and output."
msgstr "  AWS CLI가 액세스 키 ID, 비밀 액세스 키, 리전 및 출력 형식을 요청합니다."

msgid "  The token is stored in a private, unencrypted profile file, so accounts on the"
msgstr "  토큰은 암호화되지 않은 비공개 프로필 파일에 저장되므로, 동일한 호스트의"

msgid "  This is the public half; never share the private key file."
msgstr "  이것은 공개 부분입니다. 개인 키 파일은 절대 공유하지 마세요."

msgid "  This login belongs only to this account, not your global CLI account."
msgstr "  이 로그인은 전역 CLI 계정이 아닌 이 계정에만 속합니다."

msgid "  Version 1 is installed; it has no SSO. pacman asks to remove aws-cli: answer y."
msgstr "  버전 1이 설치되어 있으며 SSO를 지원하지 않습니다. pacman이 aws-cli 제거를 물으면 y로 답하세요."

msgid "  in, then lists the accounts and roles you can choose from."
msgstr "  로그인한 다음, 선택할 수 있는 계정과 역할을 나열합니다."

msgid "  same host never share a keyring entry. Never share that directory."
msgstr "  계정은 키링 항목을 공유하지 않습니다. 해당 디렉터리는 절대 공유하지 마세요."

msgid "'{spoken}' is not a time: try 10m, 1h30m or 18:30."
msgstr "'{spoken}'은(는) 올바른 시간이 아닙니다: 10m, 1h30m 또는 18:30 형식으로 입력해 보세요."

msgid "(none)"
msgstr "(없음)"

msgid "/boot is a separate partition: snapshot entries boot the current kernel. After a kernel update, restore the matching boot archive as RECOVERY.md describes."
msgstr "/boot가 별도의 파티션입니다: 스냅샷 항목은 현재 커널로 부팅됩니다. 커널 업데이트 후에는 RECOVERY.md의 설명에 따라 일치하는 부팅 아카이브를 복원하세요."

msgid "/boot is not the EFI system partition"
msgstr "/boot가 EFI 시스템 파티션이 아닙니다"

msgid "/home is not on Btrfs, so it cannot have snapshots"
msgstr "/home이 Btrfs에 있지 않아 스냅샷을 생성할 수 없습니다"

msgid "/home is not the @home subvolume beside the root filesystem"
msgstr "/home이 루트 파일 시스템 옆의 @home 서브볼륨이 아닙니다"

msgid "==> Installed in {total} s; powering off"
msgstr "==> {total}초 만에 설치됨; 전원 끄는 중"

msgid "A PEM CA certificate is required"
msgstr "PEM CA 인증서가 필요합니다"

msgid "A background service failed, so a feature may not work; restart the PC, and report a problem if it fails again."
msgstr "백그라운드 서비스가 실패하여 일부 기능이 작동하지 않을 수 있습니다. PC를 재부팅하고, 다시 실패하면 문제를 보고하세요."

msgid "A connected display is required"
msgstr "연결된 디스플레이가 필요합니다"

msgid "A desktop component is not running, so menus or the bar may not work; log out and back in, and report a problem if it continues."
msgstr "데스크톱 구성 요소가 실행되고 있지 않아 메뉴나 바가 작동하지 않을 수 있습니다. 로그아웃 후 다시 로그인하고, 문제가 계속되면 보고하세요."

msgid "A factory reset point already exists; it is never replaced"
msgstr "공장 초기화 시점이 이미 존재하며 교체되지 않습니다"

msgid "A file such as ~/Pictures/lake.jpg, or an https address. Eitr downloads it (up to 50 MB) and checks that it is a picture."
msgstr "~/Pictures/lake.jpg와 같은 파일 또는 https 주소입니다. Eitr가 이를 다운로드(최대 50MB)하여 이미지인지 확인합니다."

msgid "A graphics card has no driver, so the screen may be slow or limited; run System Update, restart, and report a problem if it stays."
msgstr "그래픽 카드 드라이버가 없어 화면이 느리거나 제한될 수 있습니다. 시스템 업데이트를 실행하고 재부팅한 후 문제가 지속되면 보고하세요."

msgid "A leftover package lock can block updates; make sure no installer is open, then report a problem if it stays."
msgstr "남아 있는 패키지 잠금으로 인해 업데이트가 차단될 수 있습니다. 실행 중인 설치 프로그램이 없는지 확인하고, 문제가 지속되면 보고하세요."

msgid "A lockscreen named {name} already exists."
msgstr "이름이 {name}인 잠금 화면이 이미 존재합니다."

msgid "A maximum of four layouts can be active at once"
msgstr "한 번에 최대 4개의 레이아웃만 활성화할 수 있습니다"

msgid "A network service is masked; review your custom configuration before switching."
msgstr "네트워크 서비스가 마스킹되어 있습니다. 전환하기 전에 사용자 지정 구성을 검토하세요."

msgid "A package signing key is missing or expired, so updates may be refused; run System Update."
msgstr "패키지 서명 키가 없거나 만료되어 업데이트가 거부될 수 있습니다. 시스템 업데이트를 실행하세요."

msgid "A plugin reported errors; review it in Installed Plugins."
msgstr "플러그인에서 오류가 보고되었습니다. 설치된 플러그인에서 확인하세요."

msgid "A plugin runs as you, with your account’s full permissions. It can read your files, SSH keys and browser data, send them anywhere, and keep itself running in the background."
msgstr "플러그인은 사용자의 계정 권한 전체를 가지고 실행됩니다. 파일, SSH 키 및 브라우저 데이터를 읽어 어디로든 전송할 수 있으며, 백그라운드에서 계속 실행될 수 있습니다."

msgid "A program crashed"
msgstr "프로그램이 비정상 종료됨"

msgid "A regular desktop user is required"
msgstr "일반 데스크톱 사용자가 필요합니다"

msgid "A screen runs at a lower refresh rate than it supports, so motion looks less smooth; choose the higher rate in Display settings."
msgstr "화면이 지원하는 것보다 낮은 주사율로 실행 중이어서 움직임이 덜 부드러워 보입니다. 디스플레이 설정에서 더 높은 주사율을 선택하세요."

msgid "A selection is required"
msgstr "선택 항목이 필요합니다"

msgid "A theme named {name} already exists."
msgstr "이름이 {name}인 테마가 이미 존재합니다."

msgid "A web app named {name} already exists. Remove it first from Install > Web Apps."
msgstr "이름이 {name}인 웹 앱이 이미 존재합니다. 설치 > 웹 앱에서 먼저 제거하세요."

msgid "A {service} dashboard named {name} already exists."
msgstr "이름이 {name}인 {service} 대시보드가 이미 존재합니다."

msgid "A: Ask the AI to check"
msgstr "A: AI에 확인 요청"

msgid "A: ask the AI about this failure · Esc: close"
msgstr "A: AI에 이 오류 문의 · Esc: 닫기"

msgid "AI can miss things. This is advice, not approval. The full-permissions warning still applies."
msgstr "AI가 일부 항목을 놓칠 수 있습니다. 이는 조언일 뿐 승인이 아닙니다. 전체 권한 경고는 여전히 적용됩니다."

