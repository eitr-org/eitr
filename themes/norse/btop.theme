# norse: generated by themes/build-theme-files.py from colors.toml.

# Window and text
theme[main_bg]="#0a0b12"
theme[main_fg]="#e8ecf2"
theme[title]="#e8ecf2"
theme[hi_fg]="#2bb87a"
theme[inactive_fg]="#454a63"
theme[graph_text]="#e8ecf2"

# Selected process
theme[selected_bg]="#1e3a32"
theme[selected_fg]="#f4f6fa"
theme[proc_misc]="#2bb87a"

# Box outlines and dividers
theme[cpu_box]="#454a63"
theme[mem_box]="#454a63"
theme[net_box]="#454a63"
theme[proc_box]="#454a63"
theme[div_line]="#454a63"
theme[meter_bg]="#1a1b28"

# CPU and temperature graphs, low to high
theme[cpu_start]="#3fe39a"
theme[cpu_mid]="#c2ee5a"
theme[cpu_end]="#ff6b7a"
theme[temp_start]="#8a8cf5"
theme[temp_mid]="#e04fc3"
theme[temp_end]="#ff6b7a"

# Memory meters
theme[free_start]="#4fd2c0"
theme[free_mid]="#4fd2c0"
theme[free_end]="#86e6d8"
theme[cached_start]="#8a8cf5"
theme[cached_mid]="#8a8cf5"
theme[cached_end]="#aaacff"
theme[available_start]="#3fe39a"
theme[available_mid]="#3fe39a"
theme[available_end]="#7ff0bd"
theme[used_start]="#c2ee5a"
theme[used_mid]="#ff6b7a"
theme[used_end]="#ff8f9a"

# Network graphs
theme[download_start]="#3fe39a"
theme[download_mid]="#4fd2c0"
theme[download_end]="#7ff0bd"
theme[upload_start]="#e04fc3"
theme[upload_mid]="#8a8cf5"
theme[upload_end]="#f08bd8"

# Process list gradient
theme[process_start]="#2bb87a"
theme[process_mid]="#e04fc3"
theme[process_end]="#ff6b7a"
