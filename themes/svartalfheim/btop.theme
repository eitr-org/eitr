# svartalfheim: generated by themes/build-theme-files.py from colors.toml.

# Window and text
theme[main_bg]="#0d0e10"
theme[main_fg]="#e6dfd0"
theme[title]="#ece7dc"
theme[hi_fg]="#c8894a"
theme[inactive_fg]="#9a9488"
theme[graph_text]="#e6dfd0"

# Selected process
theme[selected_bg]="#22252a"
theme[selected_fg]="#e6dfd0"
theme[proc_misc]="#c8894a"

# Box outlines and dividers
theme[cpu_box]="#9a9488"
theme[mem_box]="#9a9488"
theme[net_box]="#9a9488"
theme[proc_box]="#9a9488"
theme[div_line]="#9a9488"
theme[meter_bg]="#15171a"

# CPU and temperature graphs, low to high
theme[cpu_start]="#8fa36b"
theme[cpu_mid]="#d9a865"
theme[cpu_end]="#c4554a"
theme[temp_start]="#6f8fb0"
theme[temp_mid]="#9c7aa8"
theme[temp_end]="#c4554a"

# Memory meters
theme[free_start]="#6fa3a3"
theme[free_mid]="#6fa3a3"
theme[free_end]="#93baba"
theme[cached_start]="#6f8fb0"
theme[cached_mid]="#6f8fb0"
theme[cached_end]="#93abc4"
theme[available_start]="#8fa36b"
theme[available_mid]="#8fa36b"
theme[available_end]="#abba90"
theme[used_start]="#d9a865"
theme[used_mid]="#c4554a"
theme[used_end]="#d38077"

# Network graphs
theme[download_start]="#8fa36b"
theme[download_mid]="#6fa3a3"
theme[download_end]="#abba90"
theme[upload_start]="#9c7aa8"
theme[upload_mid]="#6f8fb0"
theme[upload_end]="#b59bbe"

# Process list gradient
theme[process_start]="#c8894a"
theme[process_mid]="#9c7aa8"
theme[process_end]="#c4554a"
