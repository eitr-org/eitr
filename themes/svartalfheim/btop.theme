# svartalfheim: generated by themes/build-theme-files.py from colors.toml.

# Window and text
theme[main_bg]="#191715"
theme[main_fg]="#ede5db"
theme[title]="#f2ece4"
theme[hi_fg]="#d49a65"
theme[inactive_fg]="#b0a398"
theme[graph_text]="#ede5db"

# Selected process
theme[selected_bg]="#3c322b"
theme[selected_fg]="#ede5db"
theme[proc_misc]="#d49a65"

# Box outlines and dividers
theme[cpu_box]="#b0a398"
theme[mem_box]="#b0a398"
theme[net_box]="#b0a398"
theme[proc_box]="#b0a398"
theme[div_line]="#b0a398"
theme[meter_bg]="#29231f"

# CPU and temperature graphs, low to high
theme[cpu_start]="#9dbb89"
theme[cpu_mid]="#e0bd78"
theme[cpu_end]="#e17f72"
theme[temp_start]="#8eadcb"
theme[temp_mid]="#b79ac6"
theme[temp_end]="#e17f72"

# Memory meters
theme[free_start]="#8ab7ad"
theme[free_mid]="#8ab7ad"
theme[free_end]="#a7c9c2"
theme[cached_start]="#8eadcb"
theme[cached_mid]="#8eadcb"
theme[cached_end]="#aac2d8"
theme[available_start]="#9dbb89"
theme[available_mid]="#9dbb89"
theme[available_end]="#b6cca6"
theme[used_start]="#e0bd78"
theme[used_mid]="#e17f72"
theme[used_end]="#e89f95"

# Network graphs
theme[download_start]="#9dbb89"
theme[download_mid]="#8ab7ad"
theme[download_end]="#b6cca6"
theme[upload_start]="#b79ac6"
theme[upload_mid]="#8eadcb"
theme[upload_end]="#c9b3d4"

# Process list gradient
theme[process_start]="#d49a65"
theme[process_mid]="#b79ac6"
theme[process_end]="#e17f72"
