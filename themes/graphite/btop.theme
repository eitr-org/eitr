# graphite: generated by themes/build-theme-files.py from colors.toml.

# Window and text
theme[main_bg]="#121212"
theme[main_fg]="#bebebe"
theme[title]="#bebebe"
theme[hi_fg]="#e68e0d"
theme[inactive_fg]="#8a8a8d"
theme[graph_text]="#bebebe"

# Selected process
theme[selected_bg]="#333333"
theme[selected_fg]="#bebebe"
theme[proc_misc]="#e68e0d"

# Box outlines and dividers
theme[cpu_box]="#8a8a8d"
theme[mem_box]="#8a8a8d"
theme[net_box]="#8a8a8d"
theme[proc_box]="#8a8a8d"
theme[div_line]="#8a8a8d"
theme[meter_bg]="#333333"

# CPU and temperature graphs, low to high
theme[cpu_start]="#FFC107"
theme[cpu_mid]="#b91c1c"
theme[cpu_end]="#D35F5F"
theme[temp_start]="#e68e0d"
theme[temp_mid]="#D35F5F"
theme[temp_end]="#D35F5F"

# Memory meters
theme[free_start]="#bebebe"
theme[free_mid]="#bebebe"
theme[free_end]="#eaeaea"
theme[cached_start]="#e68e0d"
theme[cached_mid]="#e68e0d"
theme[cached_end]="#f59e0b"
theme[available_start]="#FFC107"
theme[available_mid]="#FFC107"
theme[available_end]="#FFC107"
theme[used_start]="#b91c1c"
theme[used_mid]="#D35F5F"
theme[used_end]="#B91C1C"

# Network graphs
theme[download_start]="#FFC107"
theme[download_mid]="#bebebe"
theme[download_end]="#FFC107"
theme[upload_start]="#D35F5F"
theme[upload_mid]="#e68e0d"
theme[upload_end]="#B91C1C"

# Process list gradient
theme[process_start]="#e68e0d"
theme[process_mid]="#D35F5F"
theme[process_end]="#D35F5F"
