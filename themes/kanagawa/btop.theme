# kanagawa: generated by themes/build-theme-files.py from colors.toml.

# Window and text
theme[main_bg]="#1f1f28"
theme[main_fg]="#dcd7ba"
theme[title]="#dcd7ba"
theme[hi_fg]="#7e9cd8"
theme[inactive_fg]="#727169"
theme[graph_text]="#dcd7ba"

# Selected process
theme[selected_bg]="#2d4f67"
theme[selected_fg]="#c8c093"
theme[proc_misc]="#7e9cd8"

# Box outlines and dividers
theme[cpu_box]="#727169"
theme[mem_box]="#727169"
theme[net_box]="#727169"
theme[proc_box]="#727169"
theme[div_line]="#727169"
theme[meter_bg]="#090618"

# CPU and temperature graphs, low to high
theme[cpu_start]="#76946a"
theme[cpu_mid]="#c0a36e"
theme[cpu_end]="#c34043"
theme[temp_start]="#7e9cd8"
theme[temp_mid]="#957fb8"
theme[temp_end]="#c34043"

# Memory meters
theme[free_start]="#6a9589"
theme[free_mid]="#6a9589"
theme[free_end]="#7aa89f"
theme[cached_start]="#7e9cd8"
theme[cached_mid]="#7e9cd8"
theme[cached_end]="#7fb4ca"
theme[available_start]="#76946a"
theme[available_mid]="#76946a"
theme[available_end]="#98bb6c"
theme[used_start]="#c0a36e"
theme[used_mid]="#c34043"
theme[used_end]="#e82424"

# Network graphs
theme[download_start]="#76946a"
theme[download_mid]="#6a9589"
theme[download_end]="#98bb6c"
theme[upload_start]="#957fb8"
theme[upload_mid]="#7e9cd8"
theme[upload_end]="#938aa9"

# Process list gradient
theme[process_start]="#7e9cd8"
theme[process_mid]="#957fb8"
theme[process_end]="#c34043"
