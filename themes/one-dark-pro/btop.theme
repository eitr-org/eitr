# one-dark-pro: generated by themes/build-theme-files.py from colors.toml.

# Window and text
theme[main_bg]="#282c34"
theme[main_fg]="#abb2bf"
theme[title]="#abb2bf"
theme[hi_fg]="#61afef"
theme[inactive_fg]="#5c6370"
theme[graph_text]="#abb2bf"

# Selected process
theme[selected_bg]="#3e4451"
theme[selected_fg]="#abb2bf"
theme[proc_misc]="#61afef"

# Box outlines and dividers
theme[cpu_box]="#5c6370"
theme[mem_box]="#5c6370"
theme[net_box]="#5c6370"
theme[proc_box]="#5c6370"
theme[div_line]="#5c6370"
theme[meter_bg]="#282c34"

# CPU and temperature graphs, low to high
theme[cpu_start]="#98c379"
theme[cpu_mid]="#e5c07b"
theme[cpu_end]="#e06c75"
theme[temp_start]="#61afef"
theme[temp_mid]="#c678dd"
theme[temp_end]="#e06c75"

# Memory meters
theme[free_start]="#56b6c2"
theme[free_mid]="#56b6c2"
theme[free_end]="#56b6c2"
theme[cached_start]="#61afef"
theme[cached_mid]="#61afef"
theme[cached_end]="#61afef"
theme[available_start]="#98c379"
theme[available_mid]="#98c379"
theme[available_end]="#98c379"
theme[used_start]="#e5c07b"
theme[used_mid]="#e06c75"
theme[used_end]="#e06c75"

# Network graphs
theme[download_start]="#98c379"
theme[download_mid]="#56b6c2"
theme[download_end]="#98c379"
theme[upload_start]="#c678dd"
theme[upload_mid]="#61afef"
theme[upload_end]="#c678dd"

# Process list gradient
theme[process_start]="#61afef"
theme[process_mid]="#c678dd"
theme[process_end]="#e06c75"
