# vanaheim: generated by themes/build-theme-files.py from colors.toml.

# Window and text
theme[main_bg]="#101a17"
theme[main_fg]="#e3ede2"
theme[title]="#eaf2e9"
theme[hi_fg]="#83b88e"
theme[inactive_fg]="#94aa9c"
theme[graph_text]="#e3ede2"

# Selected process
theme[selected_bg]="#2c3e33"
theme[selected_fg]="#e3ede2"
theme[proc_misc]="#83b88e"

# Box outlines and dividers
theme[cpu_box]="#94aa9c"
theme[mem_box]="#94aa9c"
theme[net_box]="#94aa9c"
theme[proc_box]="#94aa9c"
theme[div_line]="#94aa9c"
theme[meter_bg]="#1b2822"

# CPU and temperature graphs, low to high
theme[cpu_start]="#83b88e"
theme[cpu_mid]="#d5ad72"
theme[cpu_end]="#df827b"
theme[temp_start]="#83afa8"
theme[temp_mid]="#c6a0c8"
theme[temp_end]="#df827b"

# Memory meters
theme[free_start]="#8bcbc0"
theme[free_mid]="#8bcbc0"
theme[free_end]="#a8d8d0"
theme[cached_start]="#83afa8"
theme[cached_mid]="#83afa8"
theme[cached_end]="#a2c3be"
theme[available_start]="#83b88e"
theme[available_mid]="#83b88e"
theme[available_end]="#a2caaa"
theme[used_start]="#d5ad72"
theme[used_mid]="#df827b"
theme[used_end]="#e7a19c"

# Network graphs
theme[download_start]="#83b88e"
theme[download_mid]="#8bcbc0"
theme[download_end]="#a2caaa"
theme[upload_start]="#c6a0c8"
theme[upload_mid]="#83afa8"
theme[upload_end]="#d4b8d6"

# Process list gradient
theme[process_start]="#83b88e"
theme[process_mid]="#c6a0c8"
theme[process_end]="#df827b"
