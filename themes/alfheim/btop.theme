# alfheim: generated by themes/build-theme-files.py from colors.toml.

# Window and text
theme[main_bg]="#191721"
theme[main_fg]="#f0eaf6"
theme[title]="#f4eff8"
theme[hi_fg]="#d5b9f2"
theme[inactive_fg]="#ada2ba"
theme[graph_text]="#f0eaf6"

# Selected process
theme[selected_bg]="#373044"
theme[selected_fg]="#f0eaf6"
theme[proc_misc]="#d5b9f2"

# Box outlines and dividers
theme[cpu_box]="#ada2ba"
theme[mem_box]="#ada2ba"
theme[net_box]="#ada2ba"
theme[proc_box]="#ada2ba"
theme[div_line]="#ada2ba"
theme[meter_bg]="#252231"

# CPU and temperature graphs, low to high
theme[cpu_start]="#a9d6b3"
theme[cpu_mid]="#e6ce96"
theme[cpu_end]="#e895a7"
theme[temp_start]="#a3bdf0"
theme[temp_mid]="#d5b9f2"
theme[temp_end]="#e895a7"

# Memory meters
theme[free_start]="#8eddd3"
theme[free_mid]="#8eddd3"
theme[free_end]="#aae6de"
theme[cached_start]="#a3bdf0"
theme[cached_mid]="#a3bdf0"
theme[cached_end]="#bacef4"
theme[available_start]="#a9d6b3"
theme[available_mid]="#a9d6b3"
theme[available_end]="#bee0c6"
theme[used_start]="#e6ce96"
theme[used_mid]="#e895a7"
theme[used_end]="#eeb0bd"

# Network graphs
theme[download_start]="#a9d6b3"
theme[download_mid]="#8eddd3"
theme[download_end]="#bee0c6"
theme[upload_start]="#d5b9f2"
theme[upload_mid]="#a3bdf0"
theme[upload_end]="#e0caf5"

# Process list gradient
theme[process_start]="#d5b9f2"
theme[process_mid]="#d5b9f2"
theme[process_end]="#e895a7"
