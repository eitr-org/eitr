# alfheim: generated by themes/build-theme-files.py from colors.toml.

# Window and text
theme[main_bg]="#0c0a14"
theme[main_fg]="#ece6f5"
theme[title]="#f1ecf8"
theme[hi_fg]="#e04fc3"
theme[inactive_fg]="#9d93b3"
theme[graph_text]="#ece6f5"

# Selected process
theme[selected_bg]="#241e36"
theme[selected_fg]="#ece6f5"
theme[proc_misc]="#e04fc3"

# Box outlines and dividers
theme[cpu_box]="#9d93b3"
theme[mem_box]="#9d93b3"
theme[net_box]="#9d93b3"
theme[proc_box]="#9d93b3"
theme[div_line]="#9d93b3"
theme[meter_bg]="#15121f"

# CPU and temperature graphs, low to high
theme[cpu_start]="#3fe39a"
theme[cpu_mid]="#c2ee5a"
theme[cpu_end]="#ff6b7a"
theme[temp_start]="#8a8cf5"
theme[temp_mid]="#e04fc3"
theme[temp_end]="#ff6b7a"

# Memory meters
theme[free_start]="#4fd2c0"
theme[free_mid]="#4fd2c0"
theme[free_end]="#7bddd0"
theme[cached_start]="#8a8cf5"
theme[cached_mid]="#8a8cf5"
theme[cached_end]="#a7a9f8"
theme[available_start]="#3fe39a"
theme[available_mid]="#3fe39a"
theme[available_end]="#6feab3"
theme[used_start]="#c2ee5a"
theme[used_mid]="#ff6b7a"
theme[used_end]="#ff909b"

# Network graphs
theme[download_start]="#3fe39a"
theme[download_mid]="#4fd2c0"
theme[download_end]="#6feab3"
theme[upload_start]="#e04fc3"
theme[upload_mid]="#8a8cf5"
theme[upload_end]="#e87bd2"

# Process list gradient
theme[process_start]="#e04fc3"
theme[process_mid]="#e04fc3"
theme[process_end]="#ff6b7a"
