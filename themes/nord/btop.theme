# nord: generated by themes/build-theme-files.py from colors.toml.

# Window and text
theme[main_bg]="#2e3440"
theme[main_fg]="#d8dee9"
theme[title]="#d8dee9"
theme[hi_fg]="#81a1c1"
theme[inactive_fg]="#4c566a"
theme[graph_text]="#d8dee9"

# Selected process
theme[selected_bg]="#4c566a"
theme[selected_fg]="#d8dee9"
theme[proc_misc]="#81a1c1"

# Box outlines and dividers
theme[cpu_box]="#4c566a"
theme[mem_box]="#4c566a"
theme[net_box]="#4c566a"
theme[proc_box]="#4c566a"
theme[div_line]="#4c566a"
theme[meter_bg]="#3b4252"

# CPU and temperature graphs, low to high
theme[cpu_start]="#a3be8c"
theme[cpu_mid]="#ebcb8b"
theme[cpu_end]="#bf616a"
theme[temp_start]="#81a1c1"
theme[temp_mid]="#b48ead"
theme[temp_end]="#bf616a"

# Memory meters
theme[free_start]="#88c0d0"
theme[free_mid]="#88c0d0"
theme[free_end]="#8fbcbb"
theme[cached_start]="#81a1c1"
theme[cached_mid]="#81a1c1"
theme[cached_end]="#81a1c1"
theme[available_start]="#a3be8c"
theme[available_mid]="#a3be8c"
theme[available_end]="#a3be8c"
theme[used_start]="#ebcb8b"
theme[used_mid]="#bf616a"
theme[used_end]="#bf616a"

# Network graphs
theme[download_start]="#a3be8c"
theme[download_mid]="#88c0d0"
theme[download_end]="#a3be8c"
theme[upload_start]="#b48ead"
theme[upload_mid]="#81a1c1"
theme[upload_end]="#b48ead"

# Process list gradient
theme[process_start]="#81a1c1"
theme[process_mid]="#b48ead"
theme[process_end]="#bf616a"
