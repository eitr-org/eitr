# ragnarok: generated by themes/build-theme-files.py from colors.toml.

# Window and text
theme[main_bg]="#120f13"
theme[main_fg]="#f2e7e2"
theme[title]="#f5ede9"
theme[hi_fg]="#c44750"
theme[inactive_fg]="#ac999e"
theme[graph_text]="#f2e7e2"

# Selected process
theme[selected_bg]="#38272d"
theme[selected_fg]="#f2e7e2"
theme[proc_misc]="#c44750"

# Box outlines and dividers
theme[cpu_box]="#ac999e"
theme[mem_box]="#ac999e"
theme[net_box]="#ac999e"
theme[proc_box]="#ac999e"
theme[div_line]="#ac999e"
theme[meter_bg]="#21191e"

# CPU and temperature graphs, low to high
theme[cpu_start]="#a4bd8d"
theme[cpu_mid]="#e7ad67"
theme[cpu_end]="#8f202b"
theme[temp_start]="#9ca9d5"
theme[temp_mid]="#c69ac6"
theme[temp_end]="#8f202b"

# Memory meters
theme[free_start]="#8ac8cc"
theme[free_mid]="#8ac8cc"
theme[free_end]="#a7d6d9"
theme[cached_start]="#9ca9d5"
theme[cached_mid]="#9ca9d5"
theme[cached_end]="#b5bee0"
theme[available_start]="#a4bd8d"
theme[available_mid]="#a4bd8d"
theme[available_end]="#bbceaa"
theme[used_start]="#e7ad67"
theme[used_mid]="#8f202b"
theme[used_end]="#ab5860"

# Network graphs
theme[download_start]="#a4bd8d"
theme[download_mid]="#8ac8cc"
theme[download_end]="#bbceaa"
theme[upload_start]="#c69ac6"
theme[upload_mid]="#9ca9d5"
theme[upload_end]="#d4b3d4"

# Process list gradient
theme[process_start]="#c44750"
theme[process_mid]="#c69ac6"
theme[process_end]="#8f202b"
