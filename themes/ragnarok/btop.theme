# ragnarok: generated by themes/build-theme-files.py from colors.toml.

# Window and text
theme[main_bg]="#0a0909"
theme[main_fg]="#e4dcd2"
theme[title]="#ebe5dd"
theme[hi_fg]="#d4545c"
theme[inactive_fg]="#9a8f86"
theme[graph_text]="#e4dcd2"

# Selected process
theme[selected_bg]="#221d1d"
theme[selected_fg]="#e4dcd2"
theme[proc_misc]="#d4545c"

# Box outlines and dividers
theme[cpu_box]="#9a8f86"
theme[mem_box]="#9a8f86"
theme[net_box]="#9a8f86"
theme[proc_box]="#9a8f86"
theme[div_line]="#9a8f86"
theme[meter_bg]="#131111"

# CPU and temperature graphs, low to high
theme[cpu_start]="#8f9a63"
theme[cpu_mid]="#b08d57"
theme[cpu_end]="#c94a4a"
theme[temp_start]="#6d7f99"
theme[temp_mid]="#9a5a7a"
theme[temp_end]="#c94a4a"

# Memory meters
theme[free_start]="#6f9590"
theme[free_mid]="#6f9590"
theme[free_end]="#93b0ac"
theme[cached_start]="#6d7f99"
theme[cached_mid]="#6d7f99"
theme[cached_end]="#929fb2"
theme[available_start]="#8f9a63"
theme[available_mid]="#8f9a63"
theme[available_end]="#abb38a"
theme[used_start]="#b08d57"
theme[used_mid]="#c94a4a"
theme[used_end]="#d67777"

# Network graphs
theme[download_start]="#8f9a63"
theme[download_mid]="#6f9590"
theme[download_end]="#abb38a"
theme[upload_start]="#9a5a7a"
theme[upload_mid]="#6d7f99"
theme[upload_end]="#b3839b"

# Process list gradient
theme[process_start]="#a8323a"
theme[process_mid]="#9a5a7a"
theme[process_end]="#c94a4a"
