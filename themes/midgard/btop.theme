# midgard: generated by themes/build-theme-files.py from colors.toml.

# Window and text
theme[main_bg]="#0b1015"
theme[main_fg]="#d9e2e8"
theme[title]="#e2e9ee"
theme[hi_fg]="#7ee0b5"
theme[inactive_fg]="#8a9aa6"
theme[graph_text]="#d9e2e8"

# Selected process
theme[selected_bg]="#1e2a35"
theme[selected_fg]="#d9e2e8"
theme[proc_misc]="#7ee0b5"

# Box outlines and dividers
theme[cpu_box]="#8a9aa6"
theme[mem_box]="#8a9aa6"
theme[net_box]="#8a9aa6"
theme[proc_box]="#8a9aa6"
theme[div_line]="#8a9aa6"
theme[meter_bg]="#121a22"

# CPU and temperature graphs, low to high
theme[cpu_start]="#7ee0b5"
theme[cpu_mid]="#d9a865"
theme[cpu_end]="#e0716a"
theme[temp_start]="#6aa7d8"
theme[temp_mid]="#a78bd6"
theme[temp_end]="#e0716a"

# Memory meters
theme[free_start]="#4fc3c9"
theme[free_mid]="#4fc3c9"
theme[free_end]="#7bd2d6"
theme[cached_start]="#6aa7d8"
theme[cached_mid]="#6aa7d8"
theme[cached_end]="#8fbde2"
theme[available_start]="#7ee0b5"
theme[available_mid]="#7ee0b5"
theme[available_end]="#9ee8c8"
theme[used_start]="#d9a865"
theme[used_mid]="#e0716a"
theme[used_end]="#e8948f"

# Network graphs
theme[download_start]="#7ee0b5"
theme[download_mid]="#4fc3c9"
theme[download_end]="#9ee8c8"
theme[upload_start]="#a78bd6"
theme[upload_mid]="#6aa7d8"
theme[upload_end]="#bda8e0"

# Process list gradient
theme[process_start]="#7ee0b5"
theme[process_mid]="#a78bd6"
theme[process_end]="#e0716a"
