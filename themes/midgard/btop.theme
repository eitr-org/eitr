# midgard: generated by themes/build-theme-files.py from colors.toml.

# Window and text
theme[main_bg]="#171a1d"
theme[main_fg]="#e5e8e8"
theme[title]="#eceeee"
theme[hi_fg]="#83a6c7"
theme[inactive_fg]="#9ca7ac"
theme[graph_text]="#e5e8e8"

# Selected process
theme[selected_bg]="#343e45"
theme[selected_fg]="#e5e8e8"
theme[proc_misc]="#83a6c7"

# Box outlines and dividers
theme[cpu_box]="#9ca7ac"
theme[mem_box]="#9ca7ac"
theme[net_box]="#9ca7ac"
theme[proc_box]="#9ca7ac"
theme[div_line]="#9ca7ac"
theme[meter_bg]="#22282d"

# CPU and temperature graphs, low to high
theme[cpu_start]="#91b69c"
theme[cpu_mid]="#d8be85"
theme[cpu_end]="#da8582"
theme[temp_start]="#83a6c7"
theme[temp_mid]="#be9cbf"
theme[temp_end]="#da8582"

# Memory meters
theme[free_start]="#80bdbe"
theme[free_mid]="#80bdbe"
theme[free_end]="#a0cece"
theme[cached_start]="#83a6c7"
theme[cached_mid]="#83a6c7"
theme[cached_end]="#a2bcd5"
theme[available_start]="#91b69c"
theme[available_mid]="#91b69c"
theme[available_end]="#acc8b5"
theme[used_start]="#d8be85"
theme[used_mid]="#da8582"
theme[used_end]="#e3a4a1"

# Network graphs
theme[download_start]="#91b69c"
theme[download_mid]="#80bdbe"
theme[download_end]="#acc8b5"
theme[upload_start]="#be9cbf"
theme[upload_mid]="#83a6c7"
theme[upload_end]="#ceb5cf"

# Process list gradient
theme[process_start]="#83a6c7"
theme[process_mid]="#be9cbf"
theme[process_end]="#da8582"
