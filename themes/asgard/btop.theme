# asgard: generated by themes/build-theme-files.py from colors.toml.

# Window and text
theme[main_bg]="#0a0a0b"
theme[main_fg]="#d8d8d4"
theme[title]="#e2e2df"
theme[hi_fg]="#ddbd7e"
theme[inactive_fg]="#8d8d88"
theme[graph_text]="#d8d8d4"

# Selected process
theme[selected_bg]="#202024"
theme[selected_fg]="#d8d8d4"
theme[proc_misc]="#ddbd7e"

# Box outlines and dividers
theme[cpu_box]="#8d8d88"
theme[mem_box]="#8d8d88"
theme[net_box]="#8d8d88"
theme[proc_box]="#8d8d88"
theme[div_line]="#8d8d88"
theme[meter_bg]="#131315"

# CPU and temperature graphs, low to high
theme[cpu_start]="#9aa58a"
theme[cpu_mid]="#b8a06a"
theme[cpu_end]="#c86a5e"
theme[temp_start]="#8a98a8"
theme[temp_mid]="#a395a8"
theme[temp_end]="#c86a5e"

# Memory meters
theme[free_start]="#92a8a4"
theme[free_mid]="#92a8a4"
theme[free_end]="#adbebb"
theme[cached_start]="#8a98a8"
theme[cached_mid]="#8a98a8"
theme[cached_end]="#a7b2be"
theme[available_start]="#9aa58a"
theme[available_mid]="#9aa58a"
theme[available_end]="#b3bca7"
theme[used_start]="#b8a06a"
theme[used_mid]="#c86a5e"
theme[used_end]="#d68f86"

# Network graphs
theme[download_start]="#9aa58a"
theme[download_mid]="#92a8a4"
theme[download_end]="#b3bca7"
theme[upload_start]="#a395a8"
theme[upload_mid]="#8a98a8"
theme[upload_end]="#bab0be"

# Process list gradient
theme[process_start]="#ddbd7e"
theme[process_mid]="#a395a8"
theme[process_end]="#c86a5e"
