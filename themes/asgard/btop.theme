# asgard: generated by themes/build-theme-files.py from colors.toml.

# Window and text
theme[main_bg]="#141820"
theme[main_fg]="#e9edf4"
theme[title]="#eef2f7"
theme[hi_fg]="#e4b968"
theme[inactive_fg]="#98a4b5"
theme[graph_text]="#e9edf4"

# Selected process
theme[selected_bg]="#2c3545"
theme[selected_fg]="#e9edf4"
theme[proc_misc]="#e4b968"

# Box outlines and dividers
theme[cpu_box]="#98a4b5"
theme[mem_box]="#98a4b5"
theme[net_box]="#98a4b5"
theme[proc_box]="#98a4b5"
theme[div_line]="#98a4b5"
theme[meter_bg]="#1d2330"

# CPU and temperature graphs, low to high
theme[cpu_start]="#9ccb9b"
theme[cpu_mid]="#e4b968"
theme[cpu_end]="#e67e80"
theme[temp_start]="#8faed8"
theme[temp_mid]="#c6a1da"
theme[temp_end]="#e67e80"

# Memory meters
theme[free_start]="#85c9d7"
theme[free_mid]="#85c9d7"
theme[free_end]="#a4d6e1"
theme[cached_start]="#8faed8"
theme[cached_mid]="#8faed8"
theme[cached_end]="#abc2e2"
theme[available_start]="#9ccb9b"
theme[available_mid]="#9ccb9b"
theme[available_end]="#b5d8b4"
theme[used_start]="#e4b968"
theme[used_mid]="#e67e80"
theme[used_end]="#ec9ea0"

# Network graphs
theme[download_start]="#9ccb9b"
theme[download_mid]="#85c9d7"
theme[download_end]="#b5d8b4"
theme[upload_start]="#c6a1da"
theme[upload_mid]="#8faed8"
theme[upload_end]="#d4b8e3"

# Process list gradient
theme[process_start]="#e4b968"
theme[process_mid]="#c6a1da"
theme[process_end]="#e67e80"
