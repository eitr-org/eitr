# helheim: generated by themes/build-theme-files.py from colors.toml.

# Window and text
theme[main_bg]="#15171a"
theme[main_fg]="#dfe3dc"
theme[title]="#e7eae5"
theme[hi_fg]="#a3bd79"
theme[inactive_fg]="#9ca8a0"
theme[graph_text]="#dfe3dc"

# Selected process
theme[selected_bg]="#32383a"
theme[selected_fg]="#dfe3dc"
theme[proc_misc]="#a3bd79"

# Box outlines and dividers
theme[cpu_box]="#9ca8a0"
theme[mem_box]="#9ca8a0"
theme[net_box]="#9ca8a0"
theme[proc_box]="#9ca8a0"
theme[div_line]="#9ca8a0"
theme[meter_bg]="#212529"

# CPU and temperature graphs, low to high
theme[cpu_start]="#a3bd79"
theme[cpu_mid]="#d0ba82"
theme[cpu_end]="#cf818b"
theme[temp_start]="#91a9c5"
theme[temp_mid]="#b193ba"
theme[temp_end]="#cf818b"

# Memory meters
theme[free_start]="#8ebeb6"
theme[free_mid]="#8ebeb6"
theme[free_end]="#aacec8"
theme[cached_start]="#91a9c5"
theme[cached_mid]="#91a9c5"
theme[cached_end]="#acbed4"
theme[available_start]="#a3bd79"
theme[available_mid]="#a3bd79"
theme[available_end]="#bace9a"
theme[used_start]="#d0ba82"
theme[used_mid]="#cf818b"
theme[used_end]="#dba0a8"

# Network graphs
theme[download_start]="#a3bd79"
theme[download_mid]="#8ebeb6"
theme[download_end]="#bace9a"
theme[upload_start]="#b193ba"
theme[upload_mid]="#91a9c5"
theme[upload_end]="#c4aecb"

# Process list gradient
theme[process_start]="#a3bd79"
theme[process_mid]="#b193ba"
theme[process_end]="#cf818b"
