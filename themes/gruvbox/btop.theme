# gruvbox: generated by themes/build-theme-files.py from colors.toml.

# Window and text
theme[main_bg]="#282828"
theme[main_fg]="#d4be98"
theme[title]="#d4be98"
theme[hi_fg]="#7daea3"
theme[inactive_fg]="#3c3836"
theme[graph_text]="#d4be98"

# Selected process
theme[selected_bg]="#d65d0e"
theme[selected_fg]="#ebdbb2"
theme[proc_misc]="#7daea3"

# Box outlines and dividers
theme[cpu_box]="#3c3836"
theme[mem_box]="#3c3836"
theme[net_box]="#3c3836"
theme[proc_box]="#3c3836"
theme[div_line]="#3c3836"
theme[meter_bg]="#3c3836"

# CPU and temperature graphs, low to high
theme[cpu_start]="#a9b665"
theme[cpu_mid]="#d8a657"
theme[cpu_end]="#ea6962"
theme[temp_start]="#7daea3"
theme[temp_mid]="#d3869b"
theme[temp_end]="#ea6962"

# Memory meters
theme[free_start]="#89b482"
theme[free_mid]="#89b482"
theme[free_end]="#89b482"
theme[cached_start]="#7daea3"
theme[cached_mid]="#7daea3"
theme[cached_end]="#7daea3"
theme[available_start]="#a9b665"
theme[available_mid]="#a9b665"
theme[available_end]="#a9b665"
theme[used_start]="#d8a657"
theme[used_mid]="#ea6962"
theme[used_end]="#ea6962"

# Network graphs
theme[download_start]="#a9b665"
theme[download_mid]="#89b482"
theme[download_end]="#a9b665"
theme[upload_start]="#d3869b"
theme[upload_mid]="#7daea3"
theme[upload_end]="#d3869b"

# Process list gradient
theme[process_start]="#7daea3"
theme[process_mid]="#d3869b"
theme[process_end]="#ea6962"
