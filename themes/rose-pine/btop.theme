# rose-pine: generated by themes/build-theme-files.py from colors.toml.

# Window and text
theme[main_bg]="#faf4ed"
theme[main_fg]="#575279"
theme[title]="#575279"
theme[hi_fg]="#56949f"
theme[inactive_fg]="#9893a5"
theme[graph_text]="#575279"

# Selected process
theme[selected_bg]="#dfdad9"
theme[selected_fg]="#575279"
theme[proc_misc]="#56949f"

# Box outlines and dividers
theme[cpu_box]="#9893a5"
theme[mem_box]="#9893a5"
theme[net_box]="#9893a5"
theme[proc_box]="#9893a5"
theme[div_line]="#9893a5"
theme[meter_bg]="#f2e9e1"

# CPU and temperature graphs, low to high
theme[cpu_start]="#286983"
theme[cpu_mid]="#ea9d34"
theme[cpu_end]="#b4637a"
theme[temp_start]="#56949f"
theme[temp_mid]="#907aa9"
theme[temp_end]="#b4637a"

# Memory meters
theme[free_start]="#d7827e"
theme[free_mid]="#d7827e"
theme[free_end]="#d7827e"
theme[cached_start]="#56949f"
theme[cached_mid]="#56949f"
theme[cached_end]="#56949f"
theme[available_start]="#286983"
theme[available_mid]="#286983"
theme[available_end]="#286983"
theme[used_start]="#ea9d34"
theme[used_mid]="#b4637a"
theme[used_end]="#b4637a"

# Network graphs
theme[download_start]="#286983"
theme[download_mid]="#d7827e"
theme[download_end]="#286983"
theme[upload_start]="#907aa9"
theme[upload_mid]="#56949f"
theme[upload_end]="#907aa9"

# Process list gradient
theme[process_start]="#56949f"
theme[process_mid]="#907aa9"
theme[process_end]="#b4637a"
