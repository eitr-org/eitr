# muspelheim: generated by themes/build-theme-files.py from colors.toml.

# Window and text
theme[main_bg]="#0e070c"
theme[main_fg]="#f1e4ea"
theme[title]="#f4ebef"
theme[hi_fg]="#e95978"
theme[inactive_fg]="#a68e9b"
theme[graph_text]="#f1e4ea"

# Selected process
theme[selected_bg]="#2a1424"
theme[selected_fg]="#f1e4ea"
theme[proc_misc]="#e95978"

# Box outlines and dividers
theme[cpu_box]="#a68e9b"
theme[mem_box]="#a68e9b"
theme[net_box]="#a68e9b"
theme[proc_box]="#a68e9b"
theme[div_line]="#a68e9b"
theme[meter_bg]="#170c14"

# CPU and temperature graphs, low to high
theme[cpu_start]="#9cc72a"
theme[cpu_mid]="#ccc564"
theme[cpu_end]="#f0505a"
theme[temp_start]="#8a7fd0"
theme[temp_mid]="#e95978"
theme[temp_end]="#f0505a"

# Memory meters
theme[free_start]="#6fc2b0"
theme[free_mid]="#6fc2b0"
theme[free_end]="#93d1c4"
theme[cached_start]="#8a7fd0"
theme[cached_mid]="#8a7fd0"
theme[cached_end]="#a79fdc"
theme[available_start]="#9cc72a"
theme[available_mid]="#9cc72a"
theme[available_end]="#b5d55f"
theme[used_start]="#ccc564"
theme[used_mid]="#f0505a"
theme[used_end]="#f47c83"

# Network graphs
theme[download_start]="#9cc72a"
theme[download_mid]="#6fc2b0"
theme[download_end]="#b5d55f"
theme[upload_start]="#e95978"
theme[upload_mid]="#8a7fd0"
theme[upload_end]="#ee829a"

# Process list gradient
theme[process_start]="#a6124d"
theme[process_mid]="#e95978"
theme[process_end]="#f0505a"
