# muspelheim: generated by themes/build-theme-files.py from colors.toml.

# Window and text
theme[main_bg]="#1d1314"
theme[main_fg]="#f4e6df"
theme[title]="#f7ece7"
theme[hi_fg]="#f28b59"
theme[inactive_fg]="#bda39c"
theme[graph_text]="#f4e6df"

# Selected process
theme[selected_bg]="#432a27"
theme[selected_fg]="#f4e6df"
theme[proc_misc]="#f28b59"

# Box outlines and dividers
theme[cpu_box]="#bda39c"
theme[mem_box]="#bda39c"
theme[net_box]="#bda39c"
theme[proc_box]="#bda39c"
theme[div_line]="#bda39c"
theme[meter_bg]="#2b1c1c"

# CPU and temperature graphs, low to high
theme[cpu_start]="#b4c486"
theme[cpu_mid]="#e9bd63"
theme[cpu_end]="#f07870"
theme[temp_start]="#91abce"
theme[temp_mid]="#d29bbf"
theme[temp_end]="#f07870"

# Memory meters
theme[free_start]="#8ec8c2"
theme[free_mid]="#8ec8c2"
theme[free_end]="#aad6d1"
theme[cached_start]="#91abce"
theme[cached_mid]="#91abce"
theme[cached_end]="#acc0da"
theme[available_start]="#b4c486"
theme[available_mid]="#b4c486"
theme[available_end]="#c7d3a4"
theme[used_start]="#e9bd63"
theme[used_mid]="#f07870"
theme[used_end]="#f49a94"

# Network graphs
theme[download_start]="#b4c486"
theme[download_mid]="#8ec8c2"
theme[download_end]="#c7d3a4"
theme[upload_start]="#d29bbf"
theme[upload_mid]="#91abce"
theme[upload_end]="#ddb4cf"

# Process list gradient
theme[process_start]="#f28b59"
theme[process_mid]="#d29bbf"
theme[process_end]="#f07870"
