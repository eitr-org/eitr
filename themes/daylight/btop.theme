# daylight: generated by themes/build-theme-files.py from colors.toml.

# Window and text
theme[main_bg]="#ffffff"
theme[main_fg]="#000000"
theme[title]="#000000"
theme[hi_fg]="#6e6e6e"
theme[inactive_fg]="#c0c0c0"
theme[graph_text]="#000000"

# Selected process
theme[selected_bg]="#1a1a1a"
theme[selected_fg]="#ffffff"
theme[proc_misc]="#6e6e6e"

# Box outlines and dividers
theme[cpu_box]="#c0c0c0"
theme[mem_box]="#c0c0c0"
theme[net_box]="#c0c0c0"
theme[proc_box]="#c0c0c0"
theme[div_line]="#c0c0c0"
theme[meter_bg]="#c0c0c0"

# CPU and temperature graphs, low to high
theme[cpu_start]="#3a3a3a"
theme[cpu_mid]="#4a4a4a"
theme[cpu_end]="#2a2a2a"
theme[temp_start]="#1a1a1a"
theme[temp_mid]="#2e2e2e"
theme[temp_end]="#2a2a2a"

# Memory meters
theme[free_start]="#3e3e3e"
theme[free_mid]="#3e3e3e"
theme[free_end]="#3e3e3e"
theme[cached_start]="#1a1a1a"
theme[cached_mid]="#1a1a1a"
theme[cached_end]="#1a1a1a"
theme[available_start]="#3a3a3a"
theme[available_mid]="#3a3a3a"
theme[available_end]="#3a3a3a"
theme[used_start]="#4a4a4a"
theme[used_mid]="#2a2a2a"
theme[used_end]="#2a2a2a"

# Network graphs
theme[download_start]="#3a3a3a"
theme[download_mid]="#3e3e3e"
theme[download_end]="#3a3a3a"
theme[upload_start]="#2e2e2e"
theme[upload_mid]="#1a1a1a"
theme[upload_end]="#2e2e2e"

# Process list gradient
theme[process_start]="#6e6e6e"
theme[process_mid]="#2e2e2e"
theme[process_end]="#2a2a2a"
