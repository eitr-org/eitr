# catppuccin: generated by themes/build-theme-files.py from colors.toml.

# Window and text
theme[main_bg]="#1e1e2e"
theme[main_fg]="#cdd6f4"
theme[title]="#cdd6f4"
theme[hi_fg]="#89b4fa"
theme[inactive_fg]="#585b70"
theme[graph_text]="#cdd6f4"

# Selected process
theme[selected_bg]="#f5e0dc"
theme[selected_fg]="#1e1e2e"
theme[proc_misc]="#89b4fa"

# Box outlines and dividers
theme[cpu_box]="#585b70"
theme[mem_box]="#585b70"
theme[net_box]="#585b70"
theme[proc_box]="#585b70"
theme[div_line]="#585b70"
theme[meter_bg]="#45475a"

# CPU and temperature graphs, low to high
theme[cpu_start]="#a6e3a1"
theme[cpu_mid]="#f9e2af"
theme[cpu_end]="#f38ba8"
theme[temp_start]="#89b4fa"
theme[temp_mid]="#f5c2e7"
theme[temp_end]="#f38ba8"

# Memory meters
theme[free_start]="#94e2d5"
theme[free_mid]="#94e2d5"
theme[free_end]="#94e2d5"
theme[cached_start]="#89b4fa"
theme[cached_mid]="#89b4fa"
theme[cached_end]="#89b4fa"
theme[available_start]="#a6e3a1"
theme[available_mid]="#a6e3a1"
theme[available_end]="#a6e3a1"
theme[used_start]="#f9e2af"
theme[used_mid]="#f38ba8"
theme[used_end]="#f38ba8"

# Network graphs
theme[download_start]="#a6e3a1"
theme[download_mid]="#94e2d5"
theme[download_end]="#a6e3a1"
theme[upload_start]="#f5c2e7"
theme[upload_mid]="#89b4fa"
theme[upload_end]="#f5c2e7"

# Process list gradient
theme[process_start]="#89b4fa"
theme[process_mid]="#f5c2e7"
theme[process_end]="#f38ba8"
