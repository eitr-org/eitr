# jade: generated by themes/build-theme-files.py from colors.toml.

# Window and text
theme[main_bg]="#111c18"
theme[main_fg]="#C1C497"
theme[title]="#C1C497"
theme[hi_fg]="#509475"
theme[inactive_fg]="#53685B"
theme[graph_text]="#C1C497"

# Selected process
theme[selected_bg]="#C1C497"
theme[selected_fg]="#111C18"
theme[proc_misc]="#509475"

# Box outlines and dividers
theme[cpu_box]="#53685B"
theme[mem_box]="#53685B"
theme[net_box]="#53685B"
theme[proc_box]="#53685B"
theme[div_line]="#53685B"
theme[meter_bg]="#23372B"

# CPU and temperature graphs, low to high
theme[cpu_start]="#549e6a"
theme[cpu_mid]="#459451"
theme[cpu_end]="#FF5345"
theme[temp_start]="#509475"
theme[temp_mid]="#D2689C"
theme[temp_end]="#FF5345"

# Memory meters
theme[free_start]="#2DD5B7"
theme[free_mid]="#2DD5B7"
theme[free_end]="#8CD3CB"
theme[cached_start]="#509475"
theme[cached_mid]="#509475"
theme[cached_end]="#ACD4CF"
theme[available_start]="#549e6a"
theme[available_mid]="#549e6a"
theme[available_end]="#63b07a"
theme[used_start]="#459451"
theme[used_mid]="#FF5345"
theme[used_end]="#db9f9c"

# Network graphs
theme[download_start]="#549e6a"
theme[download_mid]="#2DD5B7"
theme[download_end]="#63b07a"
theme[upload_start]="#D2689C"
theme[upload_mid]="#509475"
theme[upload_end]="#75bbb3"

# Process list gradient
theme[process_start]="#509475"
theme[process_mid]="#D2689C"
theme[process_end]="#FF5345"
