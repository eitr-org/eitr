# wisteria: generated by themes/build-theme-files.py from colors.toml.

# Window and text
theme[main_bg]="#fafafa"
theme[main_fg]="#212121"
theme[title]="#000000"
theme[hi_fg]="#3264eb"
theme[inactive_fg]="#9e9e9e"
theme[graph_text]="#424242"

# Selected process
theme[selected_bg]="#d0d0d0"
theme[selected_fg]="#000000"
theme[proc_misc]="#3264eb"

# Box outlines and dividers
theme[cpu_box]="#9e9e9e"
theme[mem_box]="#9e9e9e"
theme[net_box]="#9e9e9e"
theme[proc_box]="#9e9e9e"
theme[div_line]="#9e9e9e"
theme[meter_bg]="#ececec"

# CPU and temperature graphs, low to high
theme[cpu_start]="#4a2fd0"
theme[cpu_mid]="#026fde"
theme[cpu_end]="#c900c4"
theme[temp_start]="#3264eb"
theme[temp_mid]="#8a4ad7"
theme[temp_end]="#c900c4"

# Memory meters
theme[free_start]="#0c67de"
theme[free_mid]="#0c67de"
theme[free_end]="#3986ff"
theme[cached_start]="#3264eb"
theme[cached_mid]="#3264eb"
theme[cached_end]="#5482ff"
theme[available_start]="#4a2fd0"
theme[available_mid]="#4a2fd0"
theme[available_end]="#9f85e0"
theme[used_start]="#026fde"
theme[used_mid]="#c900c4"
theme[used_end]="#f930fb"

# Network graphs
theme[download_start]="#4a2fd0"
theme[download_mid]="#0c67de"
theme[download_end]="#9f85e0"
theme[upload_start]="#8a4ad7"
theme[upload_mid]="#3264eb"
theme[upload_end]="#b363ff"

# Process list gradient
theme[process_start]="#3264eb"
theme[process_mid]="#8a4ad7"
theme[process_end]="#c900c4"
