# niflheim: generated by themes/build-theme-files.py from colors.toml.

# Window and text
theme[main_bg]="#101b25"
theme[main_fg]="#e7f3f7"
theme[title]="#edf6f9"
theme[hi_fg]="#91d5e6"
theme[inactive_fg]="#9fb7c6"
theme[graph_text]="#e7f3f7"

# Selected process
theme[selected_bg]="#2a3d4b"
theme[selected_fg]="#e7f3f7"
theme[proc_misc]="#91d5e6"

# Box outlines and dividers
theme[cpu_box]="#9fb7c6"
theme[mem_box]="#9fb7c6"
theme[net_box]="#9fb7c6"
theme[proc_box]="#9fb7c6"
theme[div_line]="#9fb7c6"
theme[meter_bg]="#1b2a36"

# CPU and temperature graphs, low to high
theme[cpu_start]="#9acdbd"
theme[cpu_mid]="#dbd49f"
theme[cpu_end]="#de94a5"
theme[temp_start]="#a6c1f0"
theme[temp_mid]="#c5b0e2"
theme[temp_end]="#de94a5"

# Memory meters
theme[free_start]="#91d5e6"
theme[free_mid]="#91d5e6"
theme[free_end]="#ace0ec"
theme[cached_start]="#a6c1f0"
theme[cached_mid]="#a6c1f0"
theme[cached_end]="#bcd0f4"
theme[available_start]="#9acdbd"
theme[available_mid]="#9acdbd"
theme[available_end]="#b3dace"
theme[used_start]="#dbd49f"
theme[used_mid]="#de94a5"
theme[used_end]="#e6afbc"

# Network graphs
theme[download_start]="#9acdbd"
theme[download_mid]="#91d5e6"
theme[download_end]="#b3dace"
theme[upload_start]="#c5b0e2"
theme[upload_mid]="#a6c1f0"
theme[upload_end]="#d4c4e9"

# Process list gradient
theme[process_start]="#91d5e6"
theme[process_mid]="#c5b0e2"
theme[process_end]="#de94a5"
