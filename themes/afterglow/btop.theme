# afterglow: generated by themes/build-theme-files.py from colors.toml.

# Window and text
theme[main_bg]="#0c0b0c"
theme[main_fg]="#FAFCFB"
theme[title]="#e2dddc"
theme[hi_fg]="#b59790"
theme[inactive_fg]="#584e51"
theme[graph_text]="#cfd3cd"

# Selected process
theme[selected_bg]="#584e51"
theme[selected_fg]="#e2dddc"
theme[proc_misc]="#b59790"

# Box outlines and dividers
theme[cpu_box]="#584e51"
theme[mem_box]="#584e51"
theme[net_box]="#584e51"
theme[proc_box]="#584e51"
theme[div_line]="#584e51"
theme[meter_bg]="#090809"

# CPU and temperature graphs, low to high
theme[cpu_start]="#87a9b0"
theme[cpu_mid]="#6B5E73"
theme[cpu_end]="#c38b7b"
theme[temp_start]="#b59790"
theme[temp_mid]="#c4d8e2"
theme[temp_end]="#c38b7b"

# Memory meters
theme[free_start]="#a5a0b6"
theme[free_mid]="#a5a0b6"
theme[free_end]="#a5a0b6"
theme[cached_start]="#b59790"
theme[cached_mid]="#b59790"
theme[cached_end]="#b59790"
theme[available_start]="#87a9b0"
theme[available_mid]="#87a9b0"
theme[available_end]="#87a9b0"
theme[used_start]="#6B5E73"
theme[used_mid]="#c38b7b"
theme[used_end]="#c38b7b"

# Network graphs
theme[download_start]="#87a9b0"
theme[download_mid]="#a5a0b6"
theme[download_end]="#87a9b0"
theme[upload_start]="#c4d8e2"
theme[upload_mid]="#b59790"
theme[upload_end]="#c4d8e2"

# Process list gradient
theme[process_start]="#b59790"
theme[process_mid]="#c4d8e2"
theme[process_end]="#c38b7b"
