# eitr: generated by themes/build-theme-files.py from colors.toml.

# Window and text
theme[main_bg]="#000000"
theme[main_fg]="#e2eae2"
theme[title]="#e9efe9"
theme[hi_fg]="#b9d77e"
theme[inactive_fg]="#91a397"
theme[graph_text]="#e2eae2"

# Selected process
theme[selected_bg]="#19251d"
theme[selected_fg]="#e2eae2"
theme[proc_misc]="#b9d77e"

# Box outlines and dividers
theme[cpu_box]="#91a397"
theme[mem_box]="#91a397"
theme[net_box]="#91a397"
theme[proc_box]="#91a397"
theme[div_line]="#91a397"
theme[meter_bg]="#0b110e"

# CPU and temperature graphs, low to high
theme[cpu_start]="#85c69a"
theme[cpu_mid]="#d5c27d"
theme[cpu_end]="#c9777d"
theme[temp_start]="#8cafcb"
theme[temp_mid]="#b39bcb"
theme[temp_end]="#c9777d"

# Memory meters
theme[free_start]="#80c8ba"
theme[free_mid]="#80c8ba"
theme[free_end]="#a0d6cb"
theme[cached_start]="#8cafcb"
theme[cached_mid]="#8cafcb"
theme[cached_end]="#a9c3d8"
theme[available_start]="#85c69a"
theme[available_mid]="#85c69a"
theme[available_end]="#a4d4b3"
theme[used_start]="#d5c27d"
theme[used_mid]="#c9777d"
theme[used_end]="#d6999e"

# Network graphs
theme[download_start]="#85c69a"
theme[download_mid]="#80c8ba"
theme[download_end]="#a4d4b3"
theme[upload_start]="#b39bcb"
theme[upload_mid]="#8cafcb"
theme[upload_end]="#c6b4d8"

# Process list gradient
theme[process_start]="#b9d77e"
theme[process_mid]="#b39bcb"
theme[process_end]="#c9777d"
