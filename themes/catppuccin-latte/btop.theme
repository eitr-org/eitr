# catppuccin-latte: generated by themes/build-theme-files.py from colors.toml.

# Window and text
theme[main_bg]="#eff1f5"
theme[main_fg]="#4c4f69"
theme[title]="#4c4f69"
theme[hi_fg]="#1e66f5"
theme[inactive_fg]="#acb0be"
theme[graph_text]="#4c4f69"

# Selected process
theme[selected_bg]="#dc8a78"
theme[selected_fg]="#eff1f5"
theme[proc_misc]="#1e66f5"

# Box outlines and dividers
theme[cpu_box]="#acb0be"
theme[mem_box]="#acb0be"
theme[net_box]="#acb0be"
theme[proc_box]="#acb0be"
theme[div_line]="#acb0be"
theme[meter_bg]="#bcc0cc"

# CPU and temperature graphs, low to high
theme[cpu_start]="#40a02b"
theme[cpu_mid]="#df8e1d"
theme[cpu_end]="#d20f39"
theme[temp_start]="#1e66f5"
theme[temp_mid]="#ea76cb"
theme[temp_end]="#d20f39"

# Memory meters
theme[free_start]="#179299"
theme[free_mid]="#179299"
theme[free_end]="#179299"
theme[cached_start]="#1e66f5"
theme[cached_mid]="#1e66f5"
theme[cached_end]="#1e66f5"
theme[available_start]="#40a02b"
theme[available_mid]="#40a02b"
theme[available_end]="#40a02b"
theme[used_start]="#df8e1d"
theme[used_mid]="#d20f39"
theme[used_end]="#d20f39"

# Network graphs
theme[download_start]="#40a02b"
theme[download_mid]="#179299"
theme[download_end]="#40a02b"
theme[upload_start]="#ea76cb"
theme[upload_mid]="#1e66f5"
theme[upload_end]="#ea76cb"

# Process list gradient
theme[process_start]="#1e66f5"
theme[process_mid]="#ea76cb"
theme[process_end]="#d20f39"
