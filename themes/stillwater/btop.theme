# stillwater: generated by themes/build-theme-files.py from colors.toml.

# Window and text
theme[main_bg]="#101315"
theme[main_fg]="#cacccc"
theme[title]="#a5aeb4"
theme[hi_fg]="#798186"
theme[inactive_fg]="#4b4e55"
theme[graph_text]="#cbc2be"

# Selected process
theme[selected_bg]="#343d41"
theme[selected_fg]="#a5aeb4"
theme[proc_misc]="#798186"

# Box outlines and dividers
theme[cpu_box]="#4b4e55"
theme[mem_box]="#4b4e55"
theme[net_box]="#4b4e55"
theme[proc_box]="#4b4e55"
theme[div_line]="#4b4e55"
theme[meter_bg]="#0c0e10"

# CPU and temperature graphs, low to high
theme[cpu_start]="#9fa5a9"
theme[cpu_mid]="#d9dbdc"
theme[cpu_end]="#565d60"
theme[temp_start]="#798186"
theme[temp_mid]="#aeaeae"
theme[temp_end]="#565d60"

# Memory meters
theme[free_start]="#707070"
theme[free_mid]="#707070"
theme[free_end]="#707070"
theme[cached_start]="#798186"
theme[cached_mid]="#798186"
theme[cached_end]="#5d6367"
theme[available_start]="#9fa5a9"
theme[available_mid]="#9fa5a9"
theme[available_end]="#343d41"
theme[used_start]="#d9dbdc"
theme[used_mid]="#565d60"
theme[used_end]="#de6145"

# Network graphs
theme[download_start]="#9fa5a9"
theme[download_mid]="#707070"
theme[download_end]="#343d41"
theme[upload_start]="#aeaeae"
theme[upload_mid]="#798186"
theme[upload_end]="#9a9a9a"

# Process list gradient
theme[process_start]="#798186"
theme[process_mid]="#aeaeae"
theme[process_end]="#565d60"
