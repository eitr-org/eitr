# moss: generated by themes/build-theme-files.py from colors.toml.

# Window and text
theme[main_bg]="#222222"
theme[main_fg]="#c2c2b0"
theme[title]="#c2c2b0"
theme[hi_fg]="#78824b"
theme[inactive_fg]="#666666"
theme[graph_text]="#c2c2b0"

# Selected process
theme[selected_bg]="#78824b"
theme[selected_fg]="#c2c2b0"
theme[proc_misc]="#78824b"

# Box outlines and dividers
theme[cpu_box]="#666666"
theme[mem_box]="#666666"
theme[net_box]="#666666"
theme[proc_box]="#666666"
theme[div_line]="#666666"
theme[meter_bg]="#000000"

# CPU and temperature graphs, low to high
theme[cpu_start]="#5f875f"
theme[cpu_mid]="#b36d43"
theme[cpu_end]="#685742"
theme[temp_start]="#78824b"
theme[temp_mid]="#bb7744"
theme[temp_end]="#685742"

# Memory meters
theme[free_start]="#c9a554"
theme[free_mid]="#c9a554"
theme[free_end]="#c9a554"
theme[cached_start]="#78824b"
theme[cached_mid]="#78824b"
theme[cached_end]="#78824b"
theme[available_start]="#5f875f"
theme[available_mid]="#5f875f"
theme[available_end]="#5f875f"
theme[used_start]="#b36d43"
theme[used_mid]="#685742"
theme[used_end]="#685742"

# Network graphs
theme[download_start]="#5f875f"
theme[download_mid]="#c9a554"
theme[download_end]="#5f875f"
theme[upload_start]="#bb7744"
theme[upload_mid]="#78824b"
theme[upload_end]="#bb7744"

# Process list gradient
theme[process_start]="#78824b"
theme[process_mid]="#bb7744"
theme[process_end]="#685742"
