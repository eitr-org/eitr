# jotunheim: generated by themes/build-theme-files.py from colors.toml.

# Window and text
theme[main_bg]="#121a24"
theme[main_fg]="#e5edf5"
theme[title]="#ecf2f8"
theme[hi_fg]="#78b6cd"
theme[inactive_fg]="#9bafc1"
theme[graph_text]="#e5edf5"

# Selected process
theme[selected_bg]="#2c3c4d"
theme[selected_fg]="#e5edf5"
theme[proc_misc]="#78b6cd"

# Box outlines and dividers
theme[cpu_box]="#9bafc1"
theme[mem_box]="#9bafc1"
theme[net_box]="#9bafc1"
theme[proc_box]="#9bafc1"
theme[div_line]="#9bafc1"
theme[meter_bg]="#1d2937"

# CPU and temperature graphs, low to high
theme[cpu_start]="#94c7b6"
theme[cpu_mid]="#e1c18d"
theme[cpu_end]="#e48d9c"
theme[temp_start]="#85aee1"
theme[temp_mid]="#b7a0d9"
theme[temp_end]="#e48d9c"

# Memory meters
theme[free_start]="#78c5d2"
theme[free_mid]="#78c5d2"
theme[free_end]="#9ad4dd"
theme[cached_start]="#85aee1"
theme[cached_mid]="#85aee1"
theme[cached_end]="#a4c2e8"
theme[available_start]="#94c7b6"
theme[available_mid]="#94c7b6"
theme[available_end]="#afd5c8"
theme[used_start]="#e1c18d"
theme[used_mid]="#e48d9c"
theme[used_end]="#ebaab5"

# Network graphs
theme[download_start]="#94c7b6"
theme[download_mid]="#78c5d2"
theme[download_end]="#afd5c8"
theme[upload_start]="#b7a0d9"
theme[upload_mid]="#85aee1"
theme[upload_end]="#c9b8e2"

# Process list gradient
theme[process_start]="#78b6cd"
theme[process_mid]="#b7a0d9"
theme[process_end]="#e48d9c"
