# jotunheim: generated by themes/build-theme-files.py from colors.toml.

# Window and text
theme[main_bg]="#0b0d10"
theme[main_fg]="#dfe6ea"
theme[title]="#e7ecef"
theme[hi_fg]="#a7b1c2"
theme[inactive_fg]="#8995a0"
theme[graph_text]="#dfe6ea"

# Selected process
theme[selected_bg]="#1d252e"
theme[selected_fg]="#dfe6ea"
theme[proc_misc]="#a7b1c2"

# Box outlines and dividers
theme[cpu_box]="#8995a0"
theme[mem_box]="#8995a0"
theme[net_box]="#8995a0"
theme[proc_box]="#8995a0"
theme[div_line]="#8995a0"
theme[meter_bg]="#12161b"

# CPU and temperature graphs, low to high
theme[cpu_start]="#8fbf9f"
theme[cpu_mid]="#c9b27a"
theme[cpu_end]="#d0736b"
theme[temp_start]="#8fb8d0"
theme[temp_mid]="#a99cc9"
theme[temp_end]="#d0736b"

# Memory meters
theme[free_start]="#86c3c9"
theme[free_mid]="#86c3c9"
theme[free_end]="#a4d2d6"
theme[cached_start]="#8fb8d0"
theme[cached_mid]="#8fb8d0"
theme[cached_end]="#abcadc"
theme[available_start]="#8fbf9f"
theme[available_mid]="#8fbf9f"
theme[available_end]="#abcfb7"
theme[used_start]="#c9b27a"
theme[used_mid]="#d0736b"
theme[used_end]="#dc9690"

# Network graphs
theme[download_start]="#8fbf9f"
theme[download_mid]="#86c3c9"
theme[download_end]="#abcfb7"
theme[upload_start]="#a99cc9"
theme[upload_mid]="#8fb8d0"
theme[upload_end]="#beb5d6"

# Process list gradient
theme[process_start]="#a7b1c2"
theme[process_mid]="#a99cc9"
theme[process_end]="#d0736b"
