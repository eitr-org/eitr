# eitr-light: generated by themes/build-theme-files.py from colors.toml.

# Window and text
theme[main_bg]="#f1f6f1"
theme[main_fg]="#17291e"
theme[title]="#101f16"
theme[hi_fg]="#3e5212"
theme[inactive_fg]="#404d43"
theme[graph_text]="#17291e"

# Selected process
theme[selected_bg]="#d1e3d7"
theme[selected_fg]="#17291e"
theme[proc_misc]="#3e5212"

# Box outlines and dividers
theme[cpu_box]="#404d43"
theme[mem_box]="#404d43"
theme[net_box]="#404d43"
theme[proc_box]="#404d43"
theme[div_line]="#404d43"
theme[meter_bg]="#e3ede7"

# CPU and temperature graphs, low to high
theme[cpu_start]="#1f4d31"
theme[cpu_mid]="#5c4b14"
theme[cpu_end]="#792c34"
theme[temp_start]="#2f4c64"
theme[temp_mid]="#584065"
theme[temp_end]="#792c34"

# Memory meters
theme[free_start]="#1b5046"
theme[free_mid]="#1b5046"
theme[free_end]="#144339"
theme[cached_start]="#2f4c64"
theme[cached_mid]="#2f4c64"
theme[cached_end]="#233e57"
theme[available_start]="#1f4d31"
theme[available_mid]="#1f4d31"
theme[available_end]="#173e27"
theme[used_start]="#5c4b14"
theme[used_mid]="#792c34"
theme[used_end]="#6d252d"

# Network graphs
theme[download_start]="#1f4d31"
theme[download_mid]="#1b5046"
theme[download_end]="#173e27"
theme[upload_start]="#584065"
theme[upload_mid]="#2f4c64"
theme[upload_end]="#4b3358"

# Process list gradient
theme[process_start]="#3e5212"
theme[process_mid]="#584065"
theme[process_end]="#792c34"
