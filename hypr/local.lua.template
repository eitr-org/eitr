-- Hand-written Hyprland settings for this machine, loaded after Eitr's own config
-- and after the Display panel's layout (displays.lua), so whatever you set here wins.
--
-- The Display panel (bar > Display > gear on a monitor) arranges any number of
-- monitors side by side. Use this file for what it does not cover: rotated
-- screens, exact pixel offsets, workspaces pinned to a monitor, or one layout for
-- a laptop and another when it is docked.
--
-- Every example below is commented out. Remove the leading "--" to use one, save,
-- and run `hyprctl reload` (or log out and back in). If this file has an error,
-- Eitr keeps its default layout and shows the error as a notification.
--
-- Find your monitor names, modes and positions with: hyprctl monitors
-- Positions are in logical pixels: a 3840x2160 monitor at scale 2 is 1920 wide.

------------------------------------------------------------------------------
-- Three monitors in a row, the middle one as the main screen
------------------------------------------------------------------------------
-- hl.monitor({ output = "DP-1", mode = "2560x1440@144", position = "0x0", scale = 1 })
-- hl.monitor({ output = "DP-2", mode = "2560x1440@144", position = "2560x0", scale = 1 })
-- hl.monitor({ output = "HDMI-A-1", mode = "1920x1080@60", position = "5120x180", scale = 1 })
--   (180 = (1440 - 1080) / 2, which centers the smaller screen vertically)

------------------------------------------------------------------------------
-- A portrait monitor (rotated 90 degrees) to the left of the main one
------------------------------------------------------------------------------
-- transform: 0 normal, 1 = 90°, 2 = 180°, 3 = 270°, 4-7 = the same, flipped.
-- A rotated 1920x1080 monitor is 1080 wide and 1920 tall.
-- hl.monitor({ output = "DP-2", mode = "1920x1080@60", position = "-1080x-420", scale = 1, transform = 1 })
-- hl.monitor({ output = "DP-1", mode = "2560x1080@144", position = "0x0", scale = 1 })

------------------------------------------------------------------------------
-- One monitor above another
------------------------------------------------------------------------------
-- hl.monitor({ output = "DP-1", mode = "2560x1440@144", position = "0x0", scale = 1 })
-- hl.monitor({ output = "HDMI-A-1", mode = "1920x1080@60", position = "320x-1080", scale = 1 })

------------------------------------------------------------------------------
-- Mirror one monitor onto another (presentations, projectors)
------------------------------------------------------------------------------
-- hl.monitor({ output = "HDMI-A-1", mode = "preferred", position = "auto", scale = 1, mirror = "eDP-1" })

------------------------------------------------------------------------------
-- Turn a monitor off
------------------------------------------------------------------------------
-- hl.monitor({ output = "HDMI-A-2", disabled = true })

