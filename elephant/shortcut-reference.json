[
  {
    "heading": "󰌌  Launchers"
  },
  {
    "description": "Open terminal",
    "command": "\"$EITR_CODE_ROOT/walker/bin/menu-path/kitty\" &",
    "row": "Open Terminal"
  },
  {
    "key": "SUPER + Ctrl + Enter",
    "description": "Open tmux",
    "command": "\"$EITR_CODE_ROOT/walker/bin/app-launch\" --terminal -e tmux new-session -A -s main &"
  },
  {
    "description": "Search apps",
    "row": "Search Apps"
  },
  {
    "key": "SUPER + /",
    "description": "Show shortcuts",
    "command": "\"$MENUS_DIR/shortcuts.sh\""
  },
  {
    "key": "SUPER + Shift + /",
    "description": "Show LazyVim commands",
    "command": "\"$MENUS_DIR/vim.sh\""
  },
  {
    "description": "Open file manager",
    "row": "File Manager",
    "background": true
  },
  {
    "key": "SUPER + F",
    "description": "Open main menu",
    "command": "\"$EITR_CODE_ROOT/walker/bin/walker\" --provider menus:main"
  },
  {
    "key": "SUPER + F1",
    "description": "Toggle EITR handbook",
    "command": "bash \"$EITR_CODE_ROOT/quickshell/desktop-bar/scripts/handbook.sh\" toggle"
  },
  {
    "description": "Toggle control center",
    "row": "Desktop Control Center"
  },
  {
    "description": "Search Google",
    "row": "Search Google"
  },
  {
    "key": "SUPER + C",
    "description": "Copy",
    "command": "wtype -M ctrl c -m ctrl"
  },
  {
    "key": "SUPER + X",
    "description": "Cut",
    "command": "wtype -M ctrl x -m ctrl"
  },
  {
    "key": "SUPER + V",
    "description": "Paste",
    "command": "wtype -M ctrl v -m ctrl"
  },
  {
    "description": "Paste clipboard history",
    "row": "Clipboard History"
  },
  {
    "description": "Fuzzy-find files",
    "command": "\"$EITR_CODE_ROOT/walker/bin/menu-path/kitty\" --class fif-terminal -e python3 \"$EITR_CODE_ROOT/walker/scripts/actions/task-terminal.py\" zsh -c 'source ~/.zshrc; fif' &",
    "row": "Fuzzy Find Files"
  },
  {
    "description": "Fuzzy-find text",
    "command": "\"$EITR_CODE_ROOT/walker/bin/menu-path/kitty\" --class fifs-terminal -e python3 \"$EITR_CODE_ROOT/walker/scripts/actions/task-terminal.py\" zsh -c 'source ~/.zshrc; fifs; exit 0' &",
    "row": "Fuzzy Find Text"
  },
  {
    "key": "SUPER + D (hold)",
    "description": "Dictate, release to type",
    "command": "notify-send --app-name=Dictation \"Offline dictation\" \"Hold SUPER + D in a text field, speak, then release.\""
  },
  {
    "key": "SUPER + Shift + D (hold)",
    "description": "Voice reminders, release to send",
    "command": "python3 \"$ACTIONS_DIR/tools/voice-command.py\" typed"
  },
  {
    "heading": "󰖲  Windows"
  },
  {
    "description": "Close active window",
    "row": "Close Window"
  },
  {
    "description": "Toggle floating and pin",
    "command": "hyprctl --batch \"dispatch togglefloating; dispatch pin\"",
    "row": "Toggle Floating And Pin"
  },
  {
    "description": "Toggle fullscreen",
    "command": "hyprctl dispatch fullscreen",
    "row": "Toggle Fullscreen"
  },
  {
    "key": "SUPER + Shift + P",
    "description": "Toggle pseudo tiling",
    "command": "hyprctl dispatch pseudo"
  },
  {
    "description": "Open default AI assistant (Development)",
    "row": "Default Assistant"
  },
  {
    "key": "SUPER + R",
    "description": "Toggle split direction",
    "command": "hyprctl dispatch layoutmsg togglesplit"
  },
  {
    "key": "SUPER + Shift + R",
    "description": "Rotate split direction",
    "command": "hyprctl dispatch layoutmsg rotatesplit"
  },
  {
    "heading": "󰆾  Focus"
  },
  {
    "key": "SUPER + H",
    "description": "Focus left",
    "command": "hyprctl dispatch movefocus l"
  },
  {
    "key": "SUPER + J",
    "description": "Focus down",
    "command": "hyprctl dispatch movefocus d"
  },
  {
    "key": "SUPER + K",
    "description": "Focus up",
    "command": "hyprctl dispatch movefocus u"
  },
  {
    "key": "SUPER + L",
    "description": "Focus right",
    "command": "hyprctl dispatch movefocus r"
  },
  {
    "heading": "󰙀  Move And Resize"
  },
  {
    "key": "SUPER + Shift + H",
    "description": "Resize narrower",
    "command": "hyprctl dispatch resizeactive -15 0"
  },
  {
    "key": "SUPER + Shift + J",
    "description": "Resize taller",
    "command": "hyprctl dispatch resizeactive 0 15"
  },
  {
    "key": "SUPER + Shift + K",
    "description": "Resize shorter",
    "command": "hyprctl dispatch resizeactive 0 -15"
  },
  {
    "key": "SUPER + Shift + L",
    "description": "Resize wider",
    "command": "hyprctl dispatch resizeactive 15 0"
  },
  {
    "key": "SUPER + Ctrl + U",
    "description": "Quarter-size window",
    "command": "\"$EITR_CODE_ROOT/hypr/scripts/window-quarter-size.sh\""
  },
  {
    "key": "SUPER + Ctrl + H",
    "description": "Move window left",
    "command": "hyprctl dispatch movewindow l"
  },
  {
    "key": "SUPER + Ctrl + J",
    "description": "Move window down",
    "command": "hyprctl dispatch movewindow d"
  },
  {
    "key": "SUPER + Ctrl + K",
    "description": "Move window up",
    "command": "hyprctl dispatch movewindow u"
  },
  {
    "key": "SUPER + Ctrl + L",
    "description": "Move window right",
    "command": "hyprctl dispatch movewindow r"
  },
