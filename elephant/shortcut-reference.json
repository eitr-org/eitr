  {
    "heading": "  Media And Hardware"
  },
  {
    "key": "F8",
    "description": "Play or pause media",
    "command": "playerctl play-pause"
  },
  {
    "key": "F9",
    "description": "Next media",
    "command": "playerctl next"
  },
  {
    "key": "Volume Up",
    "description": "Raise volume",
    "command": "swayosd-client --output-volume=2 --max-volume=100"
  },
  {
    "key": "Volume Down",
    "description": "Lower volume",
    "command": "swayosd-client --output-volume=-2 --max-volume=100"
  },
  {
    "key": "Volume Mute",
    "description": "Toggle output mute",
    "command": "swayosd-client --output-volume=mute-toggle --max-volume=100"
  },
  {
    "key": "Mic Mute",
    "description": "Toggle microphone mute",
    "command": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"
  },
  {
    "key": "Brightness Up",
    "description": "Raise brightness",
    "command": "swayosd-client --brightness +2"
  },
  {
    "key": "Brightness Down",
    "description": "Lower brightness",
    "command": "swayosd-client --brightness -2"
  },
  {
    "key": "Media Previous",
    "description": "Previous media",
    "command": "playerctl previous"
  },
  {
    "key": "Media Play/Pause",
    "description": "Play or pause media",
    "command": "playerctl play-pause"
  },
  {
    "key": "Media Next",
    "description": "Next media",
    "command": "playerctl next"
