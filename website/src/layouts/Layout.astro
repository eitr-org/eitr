---
import "@fontsource/cinzel/500.css";
import "@fontsource/cinzel/700.css";
import "@fontsource/noto-sans-runic/400.css";
import "@fontsource/cormorant-garamond/500.css";
import "@fontsource/cormorant-garamond/500-italic.css";
import "../styles/global.css";
import "../styles/appearance.css";
import SkySwitch from "../components/SkySwitch.astro";
import RuneText from "../components/RuneText.astro";
import release from "../data/release.json";
import { sitePages } from "../data/site-pages";
const {
  title = sitePages.home.title,
  description = sitePages.home.description,
  noindex = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {'@type': 'WebSite', '@id': new URL('/#website', Astro.site).href, url: Astro.site?.href, name: 'Eitr Linux', description: sitePages.home.description},
    {'@type': 'WebPage', '@id': canonical, url: canonical, name: title, description, isPartOf: {'@id': new URL('/#website', Astro.site).href}},
    ...(Astro.url.pathname === '/' ? [{'@type': 'SoftwareApplication', name: 'Eitr Linux', applicationCategory: 'OperatingSystem', operatingSystem: 'x86_64 UEFI PC', softwareVersion: release.version, url: Astro.site?.href, license: 'https://github.com/eitr-org/eitr/blob/main/LICENSE'}] : []),
  ],
};
const futhark = "ᚠᚢᚦᚨᚱᚲᚷᚹ ᚺᚾᛁᛃᛇᛈᛉᛊ ᛏᛒᛖᛗᛚᛜᛞᛟ";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      document.documentElement.classList.add('js');
      try {document.documentElement.dataset.appearance=localStorage.getItem('eitr-appearance')==='light'?'light':'dark';}
      catch {document.documentElement.dataset.appearance='dark';}
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Eitr Linux" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:image" content={new URL('/art/themes/norse-full.webp', Astro.site)} />
    <meta property="og:image:alt" content="Eitr Linux Norse theme artwork" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#0a0707" />
    <link rel="icon" href="/branding/eitr-favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <title>{title}</title>
    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(structuredData).replaceAll("<", "\\u003c")} />}
  </head>
  <body>
    <div class="site-page"><div class="site-page-content">
    <a class="skip" href="#main">Skip to content</a>
    <div class="grain" aria-hidden="true"></div>
    <div class="bifrost-crossing" data-active="false" aria-hidden="true"></div>
    <div class="ambient-sparks" data-ambient="false" aria-hidden="true">{Array.from({length:24},(_,i)=><i style={`--left:${3+(i*37)%94}%;--top:${5+(i*23)%90}%;--drift:${i%2 ? 22 : -18}px;--duration:${9+i%7}s;--wait:${-i*1.7}s`}></i>)}</div>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="brand" href="/" aria-label="Eitr Linux home"><span class="wordmark" aria-hidden="true"></span></a>
        <nav aria-label="Main navigation">
          <a href={sitePages.about.path} aria-current={Astro.url.pathname === sitePages.about.path ? "page" : undefined}>About</a>
          <a href={sitePages.development.path} aria-current={Astro.url.pathname === sitePages.development.path ? "page" : undefined}>Development</a>
          <a href={sitePages.features.path} aria-current={Astro.url.pathname === sitePages.features.path ? "page" : undefined}>Features</a>
          <a href={sitePages.guide.path} aria-current={Astro.url.pathname === sitePages.guide.path ? "page" : undefined}>Handbook</a>
          <a href="/#what">Desktop</a>
          <a href="/#themes">Themes</a>
          <a href={sitePages.installation.path} aria-current={Astro.url.pathname === sitePages.installation.path ? "page" : undefined}>Installation</a>
          <a href="/#faq">FAQ</a>
        </nav>
        <SkySwitch />
        <span class="version-badge"><span class="status-dot"></span> {release.version} {release.codename}</span>
        <a class="github" href="https://github.com/eitr-org/eitr" target="_blank" rel="noopener noreferrer" aria-label="EITR on GitHub">
          <svg viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z" /></svg>
        </a>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <slot name="overlay" />
    <footer class="footer">
      <div class="marquee" aria-hidden="true"><span><RuneText text={`${futhark} · ${futhark} · ${futhark} · ${futhark} · `} /></span></div>
      <div class="wrap footer-grid">
        <div>
          <span class="wordmark" aria-hidden="true"></span>
          <p>From eitr, a world takes shape.</p>
        </div>
        <div class="footer-links">
          <a href={sitePages.about.path} aria-current={Astro.url.pathname === sitePages.about.path ? "page" : undefined}>{sitePages.about.label}</a>
          <a href={sitePages.features.path} aria-current={Astro.url.pathname === sitePages.features.path ? "page" : undefined}>{sitePages.features.label}</a>
          <a href={sitePages.development.path} aria-current={Astro.url.pathname === sitePages.development.path ? "page" : undefined}>{sitePages.development.label}</a>
          <a href="/#road">Roadmap</a>
          <a href="/#support">Support</a>
          <a href={sitePages.installation.path} aria-current={Astro.url.pathname === sitePages.installation.path ? "page" : undefined}>{sitePages.installation.label}</a>
          <a href={sitePages.guide.path} aria-current={Astro.url.pathname === sitePages.guide.path ? "page" : undefined}>{sitePages.guide.label}</a>
          <a href="https://github.com/eitr-org/eitr" target="_blank" rel="noopener noreferrer">Source code ↗</a>
          <a href="https://github.com/eitr-org/eitr/blob/main/distro/RELEASES.md" target="_blank" rel="noopener noreferrer">Releases ↗</a>
          <a href="https://github.com/sponsors/erickbatistaprado" target="_blank" rel="noopener noreferrer">Sponsor ↗</a>
          <a href="/privacy/">Privacy</a>
          <a href="mailto:contact@eitr.info">contact@eitr.info</a>
        </div>
        <p class="fine">
          Eitr Linux · An independent Arch-based Linux distribution. GPL-3.0 code, CC BY 4.0 artwork.
          <br />
          <a href="/installation/">{release.version} {release.codename} · {release.stage} · installation &amp; hardware notes</a>
        </p>
      </div>
    </footer>
    </div></div>
    <script>
      import "../scripts/effects";
      import "../scripts/realm/thunder";
      import "../scripts/realm/mjolnir-charge";
      import "../scripts/realm/mimir-well";
      import "../scripts/realm/world-root";
      import "../scripts/realm/rune-decoder";
      import "../scripts/realm/ragnarok";
      import "../scripts/realm/theme-viewer";
      import "../scripts/realm/wield-mjolnir";
      import "../scripts/navigation";
      import "../scripts/tour";
    </script>
  </body>
</html>
