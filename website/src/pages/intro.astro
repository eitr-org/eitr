---
import Layout from '../layouts/Layout.astro';
import MjolnirScene from '../components/MjolnirScene.astro';
---
<Layout title="Lightning entrance study · Eitr Linux" noindex>
  <section class="wrap intro-study">
    <h1 class="eyebrow">Motion study / Lightning</h1>
    <MjolnirScene />
    <div class="intro-controls"><button class="button primary" id="replay">Replay the strike ↻</button><a class="text-link" href="/">Back to the website ↗</a></div>
    <p class="fine">Quick motion prototype · original SVG and CSS · reduced motion shows the finished logo.</p>
  </section>
</Layout>
<style>
.intro-study{padding-top:135px;padding-bottom:55px}
.intro-study>h1{line-height:1.7}
.intro-controls{display:flex;align-items:center;gap:30px;margin:25px 0 15px;flex-wrap:wrap}
</style>
<script>
const stage=document.querySelector('#impact-stage');
document.querySelector('#replay')?.addEventListener('click',()=>{
 stage?.classList.remove('playing');
 requestAnimationFrame(()=>requestAnimationFrame(()=>{
  stage?.classList.add('playing');
  stage?.dispatchEvent(new Event('replay'));
 }));
});
</script>
