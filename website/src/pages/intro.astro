---
import { translator } from '../i18n';
const t = translator(Astro.url.pathname, 'intro');
import Layout from '../layouts/Layout.astro';
import MjolnirScene from '../components/MjolnirScene.astro';
---
<Layout title={t('lightning_entrance_study_eitr_linux')} description={t('description')} noindex>
  <section class="wrap intro-study">
    <h1 class="eyebrow">{t('motion_study_lightning')}</h1>
    <MjolnirScene />
    <div class="intro-controls"><button class="button primary" id="replay">{t('replay_the_strike')}</button><a class="text-link" href="/">{t('back_to_the_website')}</a></div>
    <p class="fine">{t('quick_motion_prototype_original_svg_and_css_reduced_mot')}</p>
  </section>
</Layout>
<style>
.intro-study{padding-top:135px;padding-bottom:55px}
.intro-study>h1{line-height:1.7}
.intro-controls{display:flex;align-items:center;gap:30px;margin:25px 0 15px;flex-wrap:wrap}
</style>
<script>
const stage=document.querySelector('#impact-stage');
document.querySelector('#replay')?.addEventListener('click',()=>{
 stage?.classList.remove('playing');
 requestAnimationFrame(()=>requestAnimationFrame(()=>{
  stage?.classList.add('playing');
  stage?.dispatchEvent(new Event('replay'));
 }));
});
</script>
