---
import { translator } from '../i18n';
const t = translator(Astro.url.pathname, 'home');
import Layout from "../layouts/Layout.astro";
import NorseSymbol from "../components/NorseSymbol.astro";
import MjolnirScene from "../components/MjolnirScene.astro";
import AmbientMusic from "../components/AmbientMusic.astro";
import BrandText from "../components/BrandText.astro";
import SerpentPassage from "../components/SerpentPassage.astro";
import WorldTree from "../components/WorldTree.astro";
import AuroraSky from "../components/AuroraSky.astro";
import RuneCarving from "../components/RuneCarving.astro";
import RuneText from "../components/RuneText.astro";
import Ravens from "../components/Ravens.astro";
import { localizedScreenshots } from "../data/screenshots";
const screenshots = localizedScreenshots(translator(Astro.url.pathname, "gallery")).flatMap(group => group.shots);
import themes from "../data/themes.json";
import release from "../data/release.json";
import download from "../data/download.json";
import roadmap from "../data/roadmap.json";

const roadText = (text: string) => translator(Astro.url.pathname, 'roadmap')(text);
const futhark = "ᚠᚢᚦᚨᚱᚲᚷᚹ ᚺᚾᛁᛃᛇᛈᛉᛊ ᛏᛒᛖᛗᛚᛜᛞᛟ";

const dossier = [
  [t("dossier_base"), t('arch_linux_x86_64')],
  [t("dossier_compositor"), "Hyprland"],
  [t("dossier_shell"), t('quickshell_bar_and_native_panels')],
  [t("dossier_launcher"), t('walker_with_elephant_menus')],
  [t("dossier_install"), t('guided_and_fully_offline_from_the_iso')],
  [t("dossier_updates"), t('signed_eitr_repository')],
  [t("dossier_recovery"), t('btrfs_snapshots_and_factory_reset')],
  [t("dossier_channels"), t('stable_or_testing_for_early_fixes')],
  [t("dossier_themes"), t('theme_count', {count: themes.length})],
  [t("dossier_plugins"), t('widgets_panels_and_bar_items_from_git')],
  [t("dossier_assistants"), t('claude_code_codex_gemini_cli_and_more_with_accounts')],
  [t("dossier_languages"), t('english_portugues_brasil_espanol_deutsch_and_francais')],
];

// Versions, stages and milestones come from distro/RELEASES.md; the site adds
// only the myth behind each codename.
const myths: Record<string, string> = {
  "Ymir": t('myth_ymir'),
  "Audhumla": t('myth_audhumla'),
  "Yggdrasil": t('myth_yggdrasil'),
  "Mimir": t('myth_mimir'),
  "Huginn": t('myth_huginn'),
  "Muninn": t('myth_muninn'),
  "Bifröst": t('myth_bifröst'),
};

const roadmapGroups: (typeof roadmap)[] = [];
for (const entry of roadmap) {
  const previous = roadmapGroups.at(-1);
  if (previous?.[0].codename === entry.codename) previous.push(entry);
  else roadmapGroups.push([entry]);
}

const homepageFeatures = [
  {
    "id": "tour",
    "title": t('the_desktop'),
    "file": "desktop",
    "body": t('walker_brings_apps_settings_and_actions_into_one_keyboa'),
    "group": "desktop"
  },
  {
    "id": "personalize",
    "title": t('make_it_yours'),
    "file": "themes",
    "body": t('pick_a_theme_or_build_one_from_a_picture_then_edit_its_'),
    "group": "style"
  },
  {
    "id": "developers",
    "title": t('built_for_linux_lovers'),
    "subtitle": t('ready_for_development'),
    "file": "development",
    "body": t('lazyvim_tmux_and_docker_are_included_curated_installs_a'),
    "group": "development"
  },
  {
    "id": "gaming",
    "title": t('play'),
    "file": "gaming",
    "body": t('steam_comes_installed_with_gamemode_mangohud_gamescope_'),
    "group": "development"
  },
  {
    "id": "recovery",
    "title": t('safe_to_update'),
    "file": "snapshots",
    "body": t('on_supported_snapshot_setups_system_update_checks_arch_'),
    "group": "recovery"
  }
];

const faq = [
  [t('is_it_free'), t('yes_free_to_download_use_and_share_with_no_account_subs')],
  [t('how_long_does_installation_take'), t('about_two_minutes_in_a_virtual_machine_on_a_fast_comput')],
  [t('do_i_need_internet_to_install'), t('no_the_iso_carries_the_packages_needed_for_guided_offli')],
  [t('can_i_break_it_with_an_update'), t('on_supported_layouts_system_update_takes_a_btrfs_snapsh')],
  [t('what_does_beta_mean_here'), t('beta_answer', {version: release.version, codename: release.codename})],
  [t('does_it_phone_home'), t('eitr_does_not_require_an_eitr_online_account_or_collect')],
];
---

<Layout>
  <SerpentPassage />
  <section class="hero">
    <AuroraSky />
    <div class="wrap hero-grid">
    <div class="hero-copy">
      <p class="eyebrow reveal"><NorseSymbol name="raven" class="heading-symbol"/> {t('an_arch_based_linux_distribution_from_the_far_north')}</p>
      <h1 class="reveal">{t('from_eitr')}<br /><em>{t('a_world')}<br />{t('takes_shape')}</em></h1>
      <p class="lead reveal">
        {t('a_keyboard_first_arch_linux_distribution_built_around_h')}
      </p>
      <div class="actions reveal">
        <a class="button primary" href="#install">{t('begin')} <span>ᚠ</span></a>
        <a class="button ghost" href="#tour">{t('explore_the_desktop')}</a>
      </div>
      <nav class="info-links hero-details" aria-label={t('learn_about_eitr_linux')}>
        <a class="text-link" href="/about/">{t('about_eitr_linux')}</a>
        <a class="text-link" href="/development/">{t('development_workflows')}</a>
        <a class="text-link" href="/guide/">{t('read_the_handbook')}</a>
        <a class="text-link" href="/installation/">{t('installation_hardware')}</a>
      </nav>
    </div>
    <div class="hero-scene"><MjolnirScene embedded /></div>
    </div>
    <AmbientMusic />
    <div class="scroll-cue" aria-hidden="true"><span></span></div>
  </section>

  <div class="rune-band" aria-hidden="true"><div><span><RuneText text={`${futhark} ${futhark} ${futhark} ${futhark}`} /></span></div></div>

  <Ravens />

  {homepageFeatures.map(feature => {
    const shot = screenshots.find(shot => shot.file === feature.file)!;
    return <section id={feature.id} class="wrap section homepage-feature">
      <div class="feature-copy">
        <h2>{feature.title}{feature.subtitle && <><br /><em>{feature.subtitle}</em></>}</h2>
        <p>{feature.body}</p>
        <a class="text-link" href={`/screenshots/#${feature.group}`}>{t('see_more')}</a>
      </div>
      <a class="feature-image" href={`/screenshots/#${feature.group}`} aria-label={t('see_more_feature', {name: [feature.title, feature.subtitle].filter(Boolean).join(" ")})}>
        <img src={`/shots/${shot.file}.webp`} alt={shot.alt} width={shot.width} height={shot.height} loading="lazy" />
      </a>
    </section>;
  })}
  <div class="wrap screenshots-cta"><a class="button" href="/screenshots/">{t('see_all_screenshots')}</a></div>

  <WorldTree />

  <section id="themes" class="themes-section">
    <div class="wrap">
      <div class="section-heading">
        <RuneCarving rune="sowilo" />
        <p class="eyebrow reveal"><NorseSymbol name="tree" class="heading-symbol"/> {t('sowilo_themes')}</p>
        <h2 class="reveal">{themes.length} {t('worlds')}<br /><em>{t('one_desktop')}</em></h2>
        <p class="reveal">{t('eitr_is_the_default_theme_every_theme_recolors_the_bar_')}</p>
      </div>
      <svg class="well-filter" aria-hidden="true" focusable="false"><filter id="well-ripple"><feTurbulence type="fractalNoise" baseFrequency="0.011 0.028" numOctaves="2" seed="7"><animate attributeName="baseFrequency" dur="5s" values="0.011 0.028;0.015 0.036;0.011 0.028" repeatCount="indefinite" /></feTurbulence><feDisplacementMap in="SourceGraphic" scale="12" /></filter></svg>
      <div class="theme-grid">
        {themes.map((theme) => (
          <figure class="theme-card glowable reveal" tabindex="0" role="button" aria-label={t('view_wallpaper', {name: theme.name})} data-name={theme.name} data-theme={theme.id} data-accent={theme.swatches[6]} data-aurora={theme.swatches[4]} data-violet={theme.swatches[5]} data-bronze={theme.swatches[3]}>
            <img src={`/art/themes/${theme.id}.webp`} alt={t('theme_wallpaper', {name: theme.name})} loading="lazy" />
            <figcaption>
              <span class="theme-name">{theme.name}</span>
              <span class="swatches">{theme.swatches.map((color) => (<i style={`background:${color}`}></i>))}</span>
            </figcaption>
            {theme.light && <span class="theme-tag">{t('light')}</span>}
          </figure>
        ))}
      </div>
    </div>
  </section>

  <dialog class="theme-viewer" aria-labelledby="theme-viewer-name">
    <div class="theme-viewer-stage">
      <div class="theme-carousel-side" data-side="-1" aria-hidden="true"></div>
      <img alt="" />
      <div class="theme-carousel-side" data-side="1" aria-hidden="true"></div>
      <button class="theme-viewer-step" type="button" data-step="-1" aria-label={t('previous_theme')}>‹</button>
      <button class="theme-viewer-step" type="button" data-step="1" aria-label={t('next_theme')}>›</button>
    </div>
    <div class="theme-viewer-bar">
      <p class="theme-name" id="theme-viewer-name"></p>
      <span class="theme-count" aria-live="polite"></span>
      <span class="swatches"></span>
      <button class="theme-viewer-close" type="button" aria-label={t('close')}>✕</button>
    </div>
  </dialog>

  <section id="install" class="wrap install">
    <div class="install-art reveal" aria-hidden="true"></div>
    <div class="section-heading">
      <RuneCarving rune="fehu" />
      <p class="eyebrow reveal"><NorseSymbol name="ship" class="heading-symbol"/> {t('fehu_begin')}</p>
      <h2 class="reveal">{t('your_first_winter')}<br />{t('with')} <BrandText text="EITR" wordmark />.</h2>
    </div>
    <div class="install-grid">
      <article class="install-card glowable reveal">
        <p class="label">{t('install')}</p>
        <h3>{t('on_your_machine')}</h3>
        <p>{t('download_the_iso_check_it_write_it_to_a_usb_stick_boot_')} <code>/dev/sdX</code> {t('is_erased')}</p>
        <a class="button primary download-button" href={download.url} download={download.file}>{t('download')} {download.version}</a>
        <p class="download-checksum" data-download-count hidden aria-live="polite"></p>
        <p class="download-checksum">{t('sha_256')} <a class="text-link" href={download.checksum_url} download={`${download.file}.sha256`}>{t('checksum_file')}</a>: <code>{download.sha256}</code></p>
        <pre tabindex="0" aria-label={t('iso_commands')}><code>{`sha256sum -c ${download.file}.sha256
sudo dd if=${download.file} of=/dev/sdX bs=4M status=progress oflag=sync`}</code></pre>
      </article>
      <div class="dossier reveal" role="group" aria-labelledby="dossier-title">
        <p class="label" id="dossier-title">{t('system_dossier')}</p>
        <dl>{dossier.map(([term, value]) => (<div><dt>{term}</dt><dd><BrandText text={value} /></dd></div>))}</dl>
      </div>
    </div>
  </section>

  <section id="road" class="wrap section">
    <div class="section-heading">
      <RuneCarving rune="raidho" />
      <p class="eyebrow reveal"><NorseSymbol name="serpent" class="heading-symbol"/> {t('raidho_the_road_ahead')}</p>
      <h2 class="reveal">{t('the_road')}<br /><em>{t('to_bifrost')}</em></h2>
      <p class="reveal">{t('each_release_takes_its_name_from_the_old_stories_from_t')}</p>
    </div>
    <ol class="road">
      {roadmapGroups.map((entries) => {
        const { version, codename, stage, milestone } = entries[0];
        const grouped = entries.length > 1;
        const current = entries.some(entry => entry.version === release.version);
        return (
        <li class:list={["reveal", { current }]}>
          <span class="road-version">{grouped ? version.split(".").slice(0, 2).join(".") : version.replace(/\.0$/, "")}</span>
          <div>
            <h3>{codename} <span class="stage">{current && !grouped ? t('current_now') : ""}{roadText(stage)}</span></h3>
            {myths[codename] && <p class="myth"><BrandText text={myths[codename]} /></p>}
            {grouped ? <ul class="road-patches">
              {entries.map(entry => <li class:list={["road-patch", { "patch-current": entry.version === release.version }]}>
                <span>{entry.version.replace(/\.0$/, "")}</span>
                <span>{roadText(entry.milestone)}.</span>
                {entry.version === release.version && <span class="stage">{t('now')}</span>}
              </li>)}
            </ul> : <p>{roadText(milestone)}.</p>}
            {current && <p class="road-note">{t('a_preview_for_early_users_the_installer_updates_and_rec')} <a class="text-link" href="/installation/">{t('tested_hardware_known_limitations')}</a></p>}
          </div>
        </li>
      ); })}
    </ol>
  </section>

  <section id="faq" class="wrap section faq">
    <div class="section-heading">
      <RuneCarving rune="isaz" />
      <p class="eyebrow reveal"><NorseSymbol name="raven" class="heading-symbol"/> {t('isaz_questions')}</p>
      <h2 class="reveal">{t('asked_at')}<br /><em>{t('the_fire')}</em></h2>
    </div>
    <div class="faq-list">
      {faq.map(([question, answer]) => (
        <details class="reveal">
          <summary><span><BrandText text={question} wordmark /></span></summary>
          <p><BrandText text={answer} /></p>
        </details>
      ))}
    </div>
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org', '@type': 'FAQPage',
      mainEntity: faq.map(([question, answer]) => ({'@type': 'Question', name: question, acceptedAnswer: {'@type': 'Answer', text: answer}})),
    }).replaceAll("<", "\\u003c")} />
  </section>

  <section id="support" class="wrap section support">
    <div class="section-heading">
      <RuneCarving rune="wunjo" />
      <p class="eyebrow reveal"><NorseSymbol name="hammer" class="heading-symbol"/> {t('wunjo_support')}</p>
      <h2 class="reveal">{t('keep_the_fire')}<br /><em>{t('burning')}</em></h2>
    </div>
    <article class="support-card glowable reveal">
      <div>
        <p class="label">{t('github_sponsors')}</p>
        <h3>{t('support')} <BrandText text="EITR" wordmark /></h3>
        <p><BrandText text={t('eitr_is_free_and_open_source_made_in_the_open_and_teste')} /></p>
      </div>
      <a class="button primary" href="https://github.com/sponsors/erickbatistaprado" target="_blank" rel="noopener noreferrer">{t('sponsor')} <span>ᚹ</span></a>
    </article>
  </section>
</Layout>

<script>
  import "../scripts/download-count";
</script>
