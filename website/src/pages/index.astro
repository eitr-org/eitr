---
import Layout from "../layouts/Layout.astro";
import NorseSymbol from "../components/NorseSymbol.astro";
import MjolnirScene from "../components/MjolnirScene.astro";
import AmbientMusic from "../components/AmbientMusic.astro";
import BrandText from "../components/BrandText.astro";
import SerpentPassage from "../components/SerpentPassage.astro";
import WorldTree from "../components/WorldTree.astro";
import AuroraSky from "../components/AuroraSky.astro";
import RuneCarving from "../components/RuneCarving.astro";
import RuneText from "../components/RuneText.astro";
import Ravens from "../components/Ravens.astro";
import { screenshots } from "../data/screenshots";
import themes from "../data/themes.json";
import release from "../data/release.json";
import download from "../data/download.json";
import roadmap from "../data/roadmap.json";

const futhark = "ᚠᚢᚦᚨᚱᚲᚷᚹ ᚺᚾᛁᛃᛇᛈᛉᛊ ᛏᛒᛖᛗᛚᛜᛞᛟ";

const dossier = [
  ["Base", "Arch Linux, x86_64"],
  ["Compositor", "Hyprland"],
  ["Shell", "Quickshell bar and native panels"],
  ["Launcher", "Walker with Elephant menus"],
  ["Install", "Guided and fully offline from the ISO"],
  ["Updates", "Signed [eitr] repository"],
  ["Recovery", "Btrfs snapshots and factory reset"],
  ["Languages", "English, Português (Brasil), Español, Deutsch and Français"],
];

// Versions, stages and milestones come from distro/RELEASES.md; the site adds
// only the myth behind each codename.
const myths: Record<string, string> = {
  "Ymir": "The first being, born of eitr.",
  "Audhumla": "The cow whose milk fed Ymir.",
  "Yggdrasil": "The world tree that holds the realms.",
  "Mimir": "The well of wisdom.",
  "Huginn": "Odin's raven of thought.",
  "Bifröst": "The burning bridge between worlds.",
};

const roadmapGroups: (typeof roadmap)[] = [];
for (const entry of roadmap) {
  const previous = roadmapGroups.at(-1);
  if (previous?.[0].codename === entry.codename) previous.push(entry);
  else roadmapGroups.push([entry]);
}

const homepageFeatures = [
  {
    "id": "tour",
    "title": "The desktop",
    "file": "desktop",
    "body": "Walker brings apps, settings and actions into one keyboard-first flow. The bar and control center open the same native panels.",
    "group": "desktop"
  },
  {
    "id": "personalize",
    "title": "Make it yours",
    "file": "themes",
    "body": "Pick a theme or build one from a picture, then edit its colors live. The bar, terminal, launcher, lockscreen and apps follow; your bar, corners, cursor and fonts stay put.",
    "group": "style"
  },
  {
    "id": "developers",
    "title": "Built for Linux lovers,",
    "subtitle": "ready for development.",
    "file": "development",
    "body": "LazyVim, tmux and Docker are included. Curated installs add editors, language toolchains and AI coding agents, while Git identities and cloud menus keep account context explicit.",
    "group": "development"
  },
  {
    "id": "gaming",
    "title": "Play",
    "file": "gaming",
    "body": "Steam comes installed with GameMode, MangoHud, gamescope and 32-bit graphics drivers. Game Mode turns off animations, blur and notification popups while you play.",
    "group": "development"
  },
  {
    "id": "recovery",
    "title": "Safe to update",
    "file": "snapshots",
    "body": "On supported snapshot setups, System Update checks Arch news and takes a Btrfs snapshot before an upgrade. Recovery has documented layout and boot requirements; keep an independent backup too.",
    "group": "recovery"
  }
];

const faq = [
  ["Is EITR a distribution?", "Yes. Eitr Linux is an Arch-based Linux distribution with its own ISO, guided offline installer, desktop packages and signed repository. Arch supplies the underlying system; Eitr maintains the integrated desktop and workflows on top."],
  ["How long does installation take?", "About two minutes in a virtual machine on a fast computer, from confirming to finished. Everything comes from the ISO, so nothing is downloaded while it installs."],
  ["Do I need internet to install?", "No. The ISO carries the packages needed for guided offline installation. Later updates and optional tool downloads need a connection; optional services also keep their own account requirements."],
  ["Can I break it with an update?", "On supported layouts, System Update takes a Btrfs snapshot before an upgrade. Recovery has documented layout and boot requirements, and snapshots do not replace an independent backup. Read the recovery Handbook chapter before relying on a rollback."],
  ["What does beta mean here?", `${release.version} ${release.codename} already includes the integrated desktop, developer menus and recovery workflows. Beta describes the validation scope: Eitr runs daily on its developer’s desktop and released ISOs pass automated VM checks, while broader hardware and some recovery scenarios still need testing. Read Installation & hardware before installing, and keep independent backups.`],
  ["Does it phone home?", "Eitr does not require an Eitr online account or collect usage telemetry. Weather, updates and optional connected tools talk to their own services. Problem reports are prepared for your review and sent only when you choose."],
];
---

<Layout>
  <SerpentPassage />
  <section class="hero">
    <AuroraSky />
    <div class="wrap hero-grid">
    <div class="hero-copy">
      <p class="eyebrow reveal"><NorseSymbol name="raven" class="heading-symbol"/> An Arch-based Linux distribution from the far north</p>
      <h1 class="reveal">From eitr,<br /><em>a world<br />takes shape.</em></h1>
      <p class="lead reveal">
        A keyboard-first Arch Linux environment built around Hyprland and Quickshell.
        Your desktop, development tools, cloud accounts and system management, brought together.
      </p>
      <div class="actions reveal">
        <a class="button primary" href="#install">Begin <span>ᚠ</span></a>
        <a class="button ghost" href="#what">Explore the desktop</a>
      </div>
      <nav class="info-links hero-details" aria-label="Learn about Eitr Linux">
        <a class="text-link" href="/about/">About Eitr Linux</a>
        <a class="text-link" href="/development/">Development workflows</a>
        <a class="text-link" href="/guide/">Read the Handbook</a>
        <a class="text-link" href="/installation/">Installation &amp; hardware</a>
      </nav>
    </div>
    <div class="hero-scene"><MjolnirScene embedded /></div>
    </div>
    <AmbientMusic />
    <div class="scroll-cue" aria-hidden="true"><span></span></div>
  </section>

  <div class="rune-band" aria-hidden="true"><div><span><RuneText text={`${futhark} ${futhark} ${futhark} ${futhark}`} /></span></div></div>

  <section id="what" class="wrap what">
    <div class="what-heading">
      <RuneCarving rune="ansuz" />
      <p class="eyebrow reveal"><NorseSymbol name="spear" class="heading-symbol"/> Ansuz / What it is</p>
      <h2 class="reveal">Old wisdom,<br /><em>a modern shell.</em></h2>
    </div>
    <figure class="what-art reveal" aria-hidden="true">
      <img src="/art/mimir.webp" alt="" loading="lazy" />
    </figure>
    <div class="what-copy">
      <p class="reveal">
        Eitr Linux is a distribution with its own ISO, guided offline installer and signed
        package repository alongside Arch’s. Its Quickshell desktop brings panels,
        notifications and settings into one coherent system. Keep Arch’s packages,
        choose your tools, and work from the keyboard. Graphical controls are another way
        into the same workflows, not a requirement to use them.
      </p>
      <p class="reveal"><a class="text-link" href="/about/">What is Eitr Linux? →</a></p>
      <div class="dossier reveal" role="group" aria-labelledby="dossier-title">
        <p class="label" id="dossier-title">System dossier</p>
        <dl>{dossier.map(([term, value]) => (<div><dt>{term}</dt><dd><BrandText text={value} /></dd></div>))}</dl>
      </div>
    </div>
  </section>

  <WorldTree />
  <Ravens />

  {homepageFeatures.map(feature => {
    const shot = screenshots.find(shot => shot.file === feature.file)!;
    return <section id={feature.id} class="wrap section homepage-feature">
      <div class="feature-copy">
        <h2>{feature.title}{feature.subtitle && <><br /><em>{feature.subtitle}</em></>}</h2>
        <p>{feature.body}</p>
        <a class="text-link" href={`/screenshots/#${feature.group}`}>See more →</a>
      </div>
      <a class="feature-image" href={`/screenshots/#${feature.group}`} aria-label={`See more: ${[feature.title, feature.subtitle].filter(Boolean).join(" ")}`}>
        <img src={`/shots/${shot.file}.webp`} alt={shot.alt} width={shot.width} height={shot.height} loading="lazy" />
      </a>
    </section>;
  })}
  <div class="wrap screenshots-cta"><a class="button" href="/screenshots/">See all screenshots →</a></div>

  <section id="themes" class="themes-section">
    <div class="wrap">
      <div class="section-heading">
        <RuneCarving rune="sowilo" />
        <p class="eyebrow reveal"><NorseSymbol name="tree" class="heading-symbol"/> Sowilo / Themes</p>
        <h2 class="reveal">{themes.length} worlds,<br /><em>one desktop.</em></h2>
        <p class="reveal">Every theme recolors the bar, terminal, launcher, lockscreen, editors and apps at once. Each comes with its own wallpapers.</p>
      </div>
      <svg class="well-filter" aria-hidden="true" focusable="false"><filter id="well-ripple"><feTurbulence type="fractalNoise" baseFrequency="0.011 0.028" numOctaves="2" seed="7"><animate attributeName="baseFrequency" dur="5s" values="0.011 0.028;0.015 0.036;0.011 0.028" repeatCount="indefinite" /></feTurbulence><feDisplacementMap in="SourceGraphic" scale="12" /></filter></svg>
      <div class="theme-grid">
        {themes.map((theme) => (
          <figure class="theme-card glowable reveal" tabindex="0" role="button" aria-label={`View the ${theme.name} wallpaper`} data-name={theme.name} data-theme={theme.id} data-accent={theme.swatches[6]} data-aurora={theme.swatches[4]} data-violet={theme.swatches[5]} data-bronze={theme.swatches[3]}>
            <img src={`/art/themes/${theme.id}.webp`} alt={`${theme.name} theme wallpaper`} loading="lazy" />
            <figcaption>
              <span class="theme-name">{theme.name}</span>
              <span class="swatches">{theme.swatches.map((color) => (<i style={`background:${color}`}></i>))}</span>
            </figcaption>
            {theme.light && <span class="theme-tag">light</span>}
          </figure>
        ))}
      </div>
    </div>
  </section>

  <dialog class="theme-viewer" aria-labelledby="theme-viewer-name">
    <div class="theme-viewer-stage">
      <img alt="" />
      <button class="theme-viewer-step" type="button" data-step="-1" aria-label="Previous theme">‹</button>
      <button class="theme-viewer-step" type="button" data-step="1" aria-label="Next theme">›</button>
    </div>
    <div class="theme-viewer-bar">
      <p class="theme-name" id="theme-viewer-name"></p>
      <span class="theme-count" aria-live="polite"></span>
      <span class="swatches"></span>
      <button class="theme-viewer-close" type="button" aria-label="Close">✕</button>
    </div>
  </dialog>

  <section id="install" class="wrap install">
    <div class="install-art reveal" style="background-image: url('/art/yggdrasil.webp')" aria-hidden="true"></div>
    <div class="section-heading">
      <RuneCarving rune="fehu" />
      <p class="eyebrow reveal"><NorseSymbol name="ship" class="heading-symbol"/> Fehu / Begin</p>
      <h2 class="reveal">Your first winter<br />with <BrandText text="EITR" wordmark />.</h2>
    </div>
    <div class="install-grid">
      <article class="install-card glowable reveal">
        <p class="label">Install</p>
        <h3>On your machine</h3>
        <p>Download the ISO, check it, write it to a USB stick, boot it and follow the installer: about two minutes on a fast machine, with nothing to download. It can erase a disk or install beside Windows (installing beside Windows is so far tested only in a VM). Everything on <code>/dev/sdX</code> is erased.</p>
        <a class="button primary download-button" href={download.url} download={download.file}>Download {download.version}</a>
        <p class="download-checksum" data-download-count hidden aria-live="polite"></p>
        <p class="download-checksum">SHA-256 <a class="text-link" href={download.checksum_url} download={`${download.file}.sha256`}>checksum file</a>: <code>{download.sha256}</code></p>
        <pre tabindex="0" aria-label="Commands to check and write the ISO"><code>{`sha256sum -c ${download.file}.sha256
sudo dd if=${download.file} of=/dev/sdX bs=4M status=progress oflag=sync`}</code></pre>
      </article>
      <article class="install-card status glowable reveal">
        <p class="label"><span class="status-dot"></span> Honest status</p>
        <h3>{release.version} {release.codename} · {release.stage}</h3>
        <p>A preview for early users. The installer, updates and recovery pass automated VM tests and run on the first real machine; other hardware is what we learn from you. Something broke? System &gt; Information &gt; Report a Problem.</p>
        <a class="text-link" href="/installation/">Tested hardware &amp; known limitations →</a>
      </article>
    </div>
  </section>

  <section id="road" class="wrap section">
    <div class="section-heading">
      <RuneCarving rune="raidho" />
      <p class="eyebrow reveal"><NorseSymbol name="serpent" class="heading-symbol"/> Raidho / The road ahead</p>
      <h2 class="reveal">The road<br /><em>to Bifröst.</em></h2>
      <p class="reveal">Each release takes its name from the old stories, from the first being to the bridge between worlds.</p>
    </div>
    <ol class="road">
      {roadmapGroups.map((entries) => {
        const { version, codename, stage, milestone } = entries[0];
        const grouped = entries.length > 1;
        const current = entries.some(entry => entry.version === release.version);
        return (
        <li class:list={["reveal", { current }]}>
          <span class="road-version">{grouped ? version.split(".").slice(0, 2).join(".") : version.replace(/\.0$/, "")}</span>
          <div>
            <h3>{codename} <span class="stage">{current && !grouped ? "now · " : ""}{stage}</span></h3>
            {myths[codename] && <p class="myth"><BrandText text={myths[codename]} /></p>}
            {grouped ? <ul class="road-patches">
              {entries.map(entry => <li class:list={["road-patch", { "patch-current": entry.version === release.version }]}>
                <span>{entry.version.replace(/\.0$/, "")}</span>
                <span>{entry.milestone}.</span>
                {entry.version === release.version && <span class="stage">now</span>}
              </li>)}
            </ul> : <p>{milestone}.</p>}
          </div>
        </li>
      ); })}
    </ol>
  </section>

  <section id="faq" class="wrap section faq">
    <div class="section-heading">
      <RuneCarving rune="isaz" />
      <p class="eyebrow reveal"><NorseSymbol name="raven" class="heading-symbol"/> Isaz / Questions</p>
      <h2 class="reveal">Asked at<br /><em>the fire.</em></h2>
    </div>
    <div class="faq-list">
      {faq.map(([question, answer]) => (
        <details class="reveal">
          <summary><span><BrandText text={question} wordmark /></span></summary>
          <p><BrandText text={answer} /></p>
        </details>
      ))}
    </div>
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org', '@type': 'FAQPage',
      mainEntity: faq.map(([question, answer]) => ({'@type': 'Question', name: question, acceptedAnswer: {'@type': 'Answer', text: answer}})),
    }).replaceAll("<", "\\u003c")} />
  </section>

  <section id="support" class="wrap section support">
    <div class="section-heading">
      <RuneCarving rune="wunjo" />
      <p class="eyebrow reveal"><NorseSymbol name="hammer" class="heading-symbol"/> Wunjo / Support</p>
      <h2 class="reveal">Keep the fire<br /><em>burning.</em></h2>
    </div>
    <article class="support-card glowable reveal">
      <div>
        <p class="label">GitHub Sponsors</p>
        <h3>Support <BrandText text="EITR" wordmark /></h3>
        <p><BrandText text="EITR is free and open source, made in the open and tested on every release. If it makes your days at the computer better, you can support its development with a one-time or monthly sponsorship." /></p>
      </div>
      <a class="button primary" href="https://github.com/sponsors/erickbatistaprado" target="_blank" rel="noopener noreferrer">Sponsor <span>ᚹ</span></a>
    </article>
  </section>
</Layout>

<script>
  import "../scripts/download-count";
</script>
