---
import { translator } from '../i18n';
const t = translator(Astro.url.pathname, 'about');
import Layout from '../layouts/Layout.astro';
import { sitePages } from '../data/site-pages';
import release from '../data/release.json';
---
<Layout {...sitePages.about}>
  <section class="wrap guide-intro">
    <p class="eyebrow">{t('about_eitr_linux')}</p>
    <h1>{t('arch_underneath')}<br /><em>{t('eitr_throughout')}</em></h1>
    <p class="lead">{t('eitr_linux_is_an_arch_based_linux_distribution_built_ar')}</p>
    <nav class="info-links" aria-label={t('explore_eitr_linux')}>
      <a class="text-link" href="/features/">{t('explore_the_features')}</a>
      <a class="text-link" href="/development/">{t('development_workflows')}</a>
      <a class="text-link" href="/installation/">{t('installation_hardware')}</a>
    </nav>
  </section>
  <div class="wrap info-body">
    <section class="info-section" aria-labelledby="about-desktop">
      <p class="eyebrow">{t('one_desktop')}</p>
      <h2 id="about-desktop">{t('a_tiling_workflow')}<br /><em>{t('controls_within_reach')}</em></h2>
      <p>{t('hyprland_arranges_windows_and_workspaces_eitr_s_quicksh')}</p>
      <p>{t('use_shortcuts_when_you_want_to_move_quickly_or_open_gra')}</p>
    </section>
    <section class="info-section" aria-labelledby="about-audience">
      <p class="eyebrow">{t('who_it_is_for')}</p>
      <h2 id="about-audience">{t('build_work')}<br /><em>{t('and_make_it_yours')}</em></h2>
      <p>{t('eitr_is_for_people_who_want_arch_s_packages_and_a_keybo')}</p>
      <p>{t('you_can_inspect_the_configuration_and_source_choose_you')}</p>
    </section>
    <section class="info-section" aria-labelledby="about-foundation">
      <p class="eyebrow">{t('the_foundation')}</p>
      <h2 id="about-foundation">{t('built_on_arch')}<br /><em>{t('maintained_as_eitr')}</em></h2>
      <p>{t('eitr_uses_arch_linux_and_pacman_with_its_own_desktop_pa')} <code>eitr update pacman</code>, <code>eitr update aur</code> {t('and')} <code>eitr update full</code> {t('update_without_automatic_snapshots_the_offline_handbook')}</p>
      <p>{t('eitr_s_code_is_free_and_open_source_under_gpl_3_0_or_la')}</p>
      <div class="info-links">
        <a class="text-link" href="https://github.com/eitr-org/eitr" target="_blank" rel="noopener noreferrer">{t('read_the_source')}</a>
        <a class="text-link" href="https://github.com/eitr-org/eitr/blob/main/NOTICE.md" target="_blank" rel="noopener noreferrer">{t('licenses_notices')}</a>
      </div>
    </section>
    <section class="info-section" aria-labelledby="about-status">
      <p class="eyebrow">{t('current_status')} {release.version} {release.codename}</p>
      <h2 id="about-status">{t('a_public_beta')}<br /><em>{t('functionality_and_validation')}</em></h2>
      <p>{t('eitr_runs_daily_on_its_developer_s_desktop_released_iso')}</p>
      <p>{t('the_beta_label_describes_validation_and_support_scope_i')}</p>
      <a class="button" href="/installation/">{t('check_installation_hardware')}</a>
    </section>
  </div>
</Layout>
