---
import BrandText from "../components/BrandText.astro";
import Layout from "../layouts/Layout.astro";
import { sitePages } from "../data/site-pages";
const repo = "https://github.com/eitr-org/eitr/blob/main/";
const guides = [
  [
    "Linux VM testing",
    "The preferred first test: an x86_64 guest on a Linux/KVM host.",
    "distro/LINUX-VM-TESTING.md",
  ],
  [
    "Mac VM testing",
    "Apple Silicon uses x86_64 emulation. CPU and graphics behavior differ from a native Linux VM.",
    "distro/MAC-VM-TESTING.md",
  ],
  [
    "Installation guide",
    "Target requirements, manifests, guided installation, and current limitations.",
    "distro/README.md",
  ],
  [
    "Recovery guide",
    "Supported snapshot layouts, boot recovery, and documented undo procedures.",
    "distro/RECOVERY.md",
  ],
];
---

<Layout {...sitePages.guide}>
  <section class="wrap guide-intro">
    <p class="eyebrow">Get started / Development preview</p>
    <h1>
      Try it.
      <br />
      <em>Get to know it.</em>
    </h1>
    <p class="lead">
      Start in a VM with a clean virtual disk.
      <br />
      Read the current guide before installing Eitr Linux.
    </p>
    <p class="info-links"><a class="text-link" href="/installation/">Installation requirements &amp; tested hardware →</a></p>
    <div class="guide-notice">
      <span class="status-dot"></span>
      <p>
        <BrandText text="Eitr" /> is actively developed. The offline installation passes in a disconnected VM and runs on
        the first real machine; laptops and other GPUs are still being
        validated. The ISO is on the <a class="text-link" href="/#install">install section</a> of the home page.
      </p>
    </div>
  </section>
  <section class="wrap guide-links" aria-label="Canonical project guides">
    {guides.map(([title, body, path], i) => (
      <a class="guide-link" href={repo + path} target="_blank" rel="noopener noreferrer">
        <span class="feature-number">0{i + 1}</span>
        <div>
          <h2>{title}</h2>
          <p>{body}</p>
        </div>
        <span aria-hidden="true">↗</span>
      </a>
    ))}
  </section>
  <section class="wrap handbook-section">
    <p class="eyebrow">The <BrandText text="EITR" /> Handbook</p>
    <h2>
      Learn the desktop.
      <br />
      <em>Keep the knowledge close.</em>
    </h2>
    <p>
      The desktop includes an offline, read-only Handbook for shortcuts,
      appearance, connectivity, maintenance, and recovery. The website links to
      its canonical sources so guidance stays in one place.
    </p>
    <a class="button" href={repo + "quickshell/desktop-bar/handbook/content/"} target="_blank" rel="noopener noreferrer">
      Browse the handbook sources ↗
    </a>
  </section>
</Layout>
