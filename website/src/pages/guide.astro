---
import { translator } from '../i18n';
const t = translator(Astro.url.pathname, 'guide');
import Layout from '../layouts/Layout.astro';
import { sitePages } from '../data/site-pages';
import { chaptersFor } from '../data/handbook';
import { languageFor } from '../i18n';
const handbookChapters = chaptersFor(languageFor(Astro.url.pathname));
const repo = 'https://github.com/eitr-org/eitr/blob/main/';
const guides = [
  [t('installation_guide'), t('target_requirements_package_manifests_disk_choices_and_'), 'distro/README.md'],
  [t('linux_vm_testing'), t('the_preferred_first_test_an_x86_64_guest_on_linux_kvm'), 'distro/LINUX-VM-TESTING.md'],
  [t('mac_vm_testing'), t('apple_silicon_uses_x86_64_emulation_not_a_native_arm_po'), 'distro/MAC-VM-TESTING.md'],
];
---
<Layout {...sitePages.guide}>
  <section class="wrap guide-intro">
    <p class="eyebrow">{t('the_handbook_on_the_desktop_and_on_the_web')}</p>
    <h1>{t('find_your_way')}<br /><em>{t('keep_the_knowledge_close')}</em></h1>
    <p class="lead">{t('read_the_same_practical_chapters_that_ship_in_eitr_s_of')}</p>
    <nav class="info-links" aria-label={t('start_reading')}>
      <a class="text-link" href="/guide/getting-started/">{t('first_login')}</a><a class="text-link" href="/guide/shortcuts/">{t('keyboard_mouse')}</a><a class="text-link" href="/development/">{t('development_overview')}</a><a class="text-link" href="/installation/">{t('installation_hardware')}</a>
    </nav>
    <p class="doc-context">{t('online_chapters_describe_the_current_desktop_packages_t')} <a class="text-link" href="/installation/">{t('release_and_compatibility_notes')}</a>.</p>
    <form class="handbook-search" role="search" hidden>
      <label for="chapter-search">{t('find_a_handbook_chapter')}</label>
      <input id="chapter-search" type="search" placeholder={t('try_git_cloud_ai_keyboard_or_snapshots')} autocomplete="off" />
      <p id="chapter-count" role="status" aria-live="polite"></p>
    </form>
  </section>
  <section class="wrap guide-links" aria-label={t('handbook_chapters')}>
    {handbookChapters.map((chapter, index) => (
      <a class="guide-link" href={chapter.path} lang={chapter.contentLanguage} data-chapter data-search={`${chapter.title} ${chapter.summary} ${Array.from(new Set(chapter.markdown.toLocaleLowerCase('en').split(/\s+/))).join(' ')}`.toLocaleLowerCase('en')}>
        <span class="feature-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
        <div><h2>{chapter.title}</h2><p>{chapter.summary}</p></div><span aria-hidden="true">→</span>
      </a>
    ))}
  </section>
  <section class="wrap info-body">
    <section class="info-section" aria-labelledby="install-guides">
      <p class="eyebrow">{t('before_installing')}</p><h2 id="install-guides">{t('know_the_ground')}<br /><em>{t('start_with_the_guide')}</em></h2>
      <p>{t('the_full_installation_and_vm_testing_procedures_remain_')}</p>
      <div class="info-links">{guides.map(([title, description, path]) => <a class="text-link" href={repo + path} title={description} target="_blank" rel="noopener noreferrer">{title} ↗</a>)}</div>
    </section>
  </section>
</Layout>
<script>
import { message } from "../scripts/messages";
  const form = document.querySelector<HTMLFormElement>('.handbook-search');
  const input = document.querySelector<HTMLInputElement>('#chapter-search');
  const count = document.querySelector<HTMLElement>('#chapter-count');
  const chapters = Array.from(document.querySelectorAll<HTMLElement>('[data-chapter]'));
  if (form && input && count) {
    form.hidden = false;
    form.addEventListener('submit', event => event.preventDefault());
    input.addEventListener('input', () => {
      const words = input.value.toLocaleLowerCase('en').trim().split(/\s+/).filter(Boolean);
      for (const chapter of chapters) chapter.hidden = !words.every(word => chapter.dataset.search?.includes(word));
      const shown = chapters.filter(chapter => !chapter.hidden).length;
      count.textContent = message('chapter_count', {shown, total: chapters.length});
    });
  }
</script>
