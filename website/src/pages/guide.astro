---
import Layout from '../layouts/Layout.astro';
import { sitePages } from '../data/site-pages';
import { handbookChapters } from '../data/handbook';
const repo = 'https://github.com/eitr-org/eitr/blob/main/';
const guides = [
  ['Installation guide', 'Target requirements, package manifests, disk choices and installation limitations.', 'distro/README.md'],
  ['Linux VM testing', 'The preferred first test: an x86_64 guest on Linux/KVM.', 'distro/LINUX-VM-TESTING.md'],
  ['Mac VM testing', 'Apple Silicon uses x86_64 emulation, not a native ARM port.', 'distro/MAC-VM-TESTING.md'],
];
---
<Layout {...sitePages.guide}>
  <section class="wrap guide-intro">
    <p class="eyebrow">The Handbook / On the desktop and on the web</p>
    <h1>Find your way.<br /><em>Keep the knowledge close.</em></h1>
    <p class="lead">Read the same practical chapters that ship in Eitr’s offline Handbook: keyboard shortcuts, applications, development workflows, desktop controls and system recovery.</p>
    <nav class="info-links" aria-label="Start reading">
      <a class="text-link" href="/guide/getting-started/">First login →</a><a class="text-link" href="/guide/shortcuts/">Keyboard &amp; mouse →</a><a class="text-link" href="/development/">Development overview →</a><a class="text-link" href="/installation/">Installation &amp; hardware →</a>
    </nav>
    <p class="doc-context">Online chapters describe the current desktop packages. The downloadable ISO may contain earlier package versions. Installation decisions belong with the <a class="text-link" href="/installation/">release and compatibility notes</a>.</p>
    <form class="handbook-search" role="search" hidden>
      <label for="chapter-search">Find a Handbook chapter</label>
      <input id="chapter-search" type="search" placeholder="Try Git, cloud, AI, keyboard or snapshots" autocomplete="off" />
      <p id="chapter-count" role="status" aria-live="polite"></p>
    </form>
  </section>
  <section class="wrap guide-links" aria-label="Handbook chapters">
    {handbookChapters.map((chapter, index) => (
      <a class="guide-link" href={chapter.path} data-chapter data-search={`${chapter.title} ${chapter.summary} ${Array.from(new Set(chapter.markdown.toLocaleLowerCase('en').split(/\s+/))).join(' ')}`.toLocaleLowerCase('en')}>
        <span class="feature-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
        <div><h2>{chapter.title}</h2><p>{chapter.summary}</p></div><span aria-hidden="true">→</span>
      </a>
    ))}
  </section>
  <section class="wrap info-body">
    <section class="info-section" aria-labelledby="install-guides">
      <p class="eyebrow">Before installing</p><h2 id="install-guides">Know the ground.<br /><em>Start with the guide.</em></h2>
      <p>The full installation and VM testing procedures remain in the repository. Read them alongside the website’s tested-hardware and release notes before changing a disk.</p>
      <div class="info-links">{guides.map(([title, description, path]) => <a class="text-link" href={repo + path} title={description} target="_blank" rel="noopener noreferrer">{title} ↗</a>)}</div>
    </section>
  </section>
</Layout>
<script>
  const form = document.querySelector<HTMLFormElement>('.handbook-search');
  const input = document.querySelector<HTMLInputElement>('#chapter-search');
  const count = document.querySelector<HTMLElement>('#chapter-count');
  const chapters = Array.from(document.querySelectorAll<HTMLElement>('[data-chapter]'));
  if (form && input && count) {
    form.hidden = false;
    form.addEventListener('submit', event => event.preventDefault());
    input.addEventListener('input', () => {
      const words = input.value.toLocaleLowerCase('en').trim().split(/\s+/).filter(Boolean);
      for (const chapter of chapters) chapter.hidden = !words.every(word => chapter.dataset.search?.includes(word));
      const shown = chapters.filter(chapter => !chapter.hidden).length;
      count.textContent = `${shown} of ${chapters.length} chapters`;
    });
  }
</script>
