---
import { translator } from '../i18n';
const t = translator(Astro.url.pathname, 'features');
import Layout from '../layouts/Layout.astro';
import { sitePages } from '../data/site-pages';
import themes from '../data/themes.json';
---
<Layout {...sitePages.features}>
  <section class="wrap guide-intro">
    <p class="eyebrow">{t('features_eitr_linux')}</p>
    <h1>{t('one_desktop')}<br /><em>{t('many_ways_to_use_it')}</em></h1>
    <p class="lead">{t('eitr_linux_brings_an_arch_based_system_a_native_hyprlan')}</p>
    <nav class="info-links" aria-label={t('feature_sections')}>
      <a class="text-link" href="#desktop">{t('desktop')}</a><a class="text-link" href="#development">{t('development_ai')}</a><a class="text-link" href="#accounts">{t('accounts')}</a><a class="text-link" href="#organizations">{t('organizations')}</a><a class="text-link" href="#recovery">{t('recovery')}</a>
    </nav>
  </section>
  <div class="wrap info-body">
    <section class="info-section" id="desktop" aria-labelledby="features-desktop">
      <p class="eyebrow">{t('desktop_appearance')}</p>
      <h2 id="features-desktop">{t('keyboard_first')}<br /><em>{t('graphical_when_you_need_it')}</em></h2>
      <p>{t('the_custom_quickshell_desktop_includes_native_notificat')}</p>
      <ul>
        <li>{t('choose_full_centered_with_evenly_packed_icons_around_a_')}</li>
        <li>{t('place_monitors_beside_one_another_choose_a_main_display')}</li>
        <li>{t('adjust_per_application_audio_and_microphone_controls_in')}</li>
        <li>{t('choose_from')} {themes.length} {t('themes_with_matching_application_colors_lockscreens_4k_')}</li>
        <li>{t('add_wallpapers_from_a_file_or_link_for_all_themes_or_on')}</li>
        <li>{t('keep_your_preferred_bar_position_corners_cursor_and_fon')}</li>
      </ul>
      <a class="text-link" href="/#tour">{t('see_the_real_desktop')}</a>
    </section>
    <section class="info-section" id="development" aria-labelledby="features-development">
      <p class="eyebrow">{t('development_ai')}</p>
      <h2 id="features-development">{t('tools_for_the_work')}<br /><em>{t('assistance_by_choice')}</em></h2>
      <p>{t('kitty_zsh_tmux_neovim_with_lazyvim_docker_lazygit_and_l')} <a href="/development/#plugins-title">{t('update_plugins')}</a> {t('reviews_updates_separately_from_system_update')}</p>
      <p>{t('claude_code_codex_github_copilot_cli_grok_and_gemini_cl')}</p>
      <p>{t('the_optional_let_assistants_work_together_feature_conne')}</p>
      <p>{t('failed_task_terminals_offer_ask_the_ai_crash_notificati')}</p>
      <a class="text-link" href="/development/">{t('development_workflows_defaults_optional_tools')}</a>
    </section>
    <section class="info-section" id="accounts" aria-labelledby="features-accounts">
      <p class="eyebrow">{t('accounts_cloud_git')}</p>
      <h2 id="features-accounts">{t('know_the_account')}<br /><em>{t('keep_the_context_visible')}</em></h2>
      <p>{t('git_accounts_manages_folder_specific_identities_and_ssh')}</p>
      <p>{t('system_security_users_lists_existing_human_accounts_as_')}</p>
      <p>{t('provider_menus_cover_aws_azure_google_cloud_cloudflare_')}</p>
    </section>
    <section class="info-section" id="organizations" aria-labelledby="features-organizations">
      <p class="eyebrow">{t('organization_profiles')}</p>
      <h2 id="features-organizations">{t('set_it_up_once')}<br /><em>{t('install_it_on_every_desk')}</em></h2>
      <p>{t('an_organization_profile_is_a_json_file_on_the_installer')} <code>eitr profile check</code> {t('and')} <code>eitr profile apply</code> {t('do_the_same_on_an_installed_machine')}</p>
      <p>{t('policies_govern_eitr_s_own_tools_they_are_not_a_lockdow')}</p>
      <a class="text-link" href="https://github.com/eitr-org/eitr/blob/main/distro/ORGANIZATION-PROFILES.md" target="_blank" rel="noopener noreferrer">{t('read_the_profile_format_and_limits')}</a>
    </section>
    <section class="info-section" aria-labelledby="features-everyday">
      <p class="eyebrow">{t('everyday_tools_gaming')}</p>
      <h2 id="features-everyday">{t('capture_an_idea')}<br /><em>{t('make_room_to_play')}</em></h2>
      <p>{t('capture_screenshots_record_with_obs_read_screen_text_or')}</p>
      <p>{t('tools_calendars_adds_read_only_google_outlook_or_ical_s')}</p>
      <p>{t('web_apps_open_in_their_own_window_with_a_chosen_browser')}</p>
      <p>{t('steam_comes_installed_with_gamemode_mangohud_and_gamesc')}</p>
    </section>
    <section class="info-section" id="recovery" aria-labelledby="features-recovery">
      <p class="eyebrow">{t('maintenance_recovery')}</p>
      <h2 id="features-recovery">{t('a_way_forward')}<br /><em>{t('a_way_back')}</em></h2>
      <p>{t('system_update_checks_arch_news_and_available_changes_cr')} <code>eitr update pacman</code>, <code>eitr update aur</code> {t('and')} <code>eitr update full</code> {t('update_without_automatic_snapshots_while_it_works_each_')}</p>
      <p>{t('system_maintenance_check_this_pc_runs_read_only_checks_')}</p>
      <p>{t('system_maintenance_choose_fastest_mirrors_uses_reflecto')}</p>
      <p>{t('recovery_includes_system_snapshots_a_boot_guard_optiona')}</p>
      <a class="text-link" href="/guide/recovery/">{t('read_the_recovery_handbook')}</a>
    </section>
    <section class="info-section" aria-labelledby="features-remote">
      <p class="eyebrow">{t('remote_access_explicit_setup')}</p>
      <h2 id="features-remote">{t('remote_access')}<br /><em>{t('share_by_choice')}</em></h2>
      <p>{t('moonlight_sunshine_sharing_and_tailscale_away_access_ha')}</p>
      <a class="text-link" href="https://github.com/eitr-org/eitr/blob/main/distro/REMOTE-ACCESS.md" target="_blank" rel="noopener noreferrer">{t('read_the_setup_and_security_boundaries')}</a>
    </section>
  </div>
</Layout>
