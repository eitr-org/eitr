---
import { translator } from '../i18n';
const t = translator(Astro.url.pathname, 'installation');
import Layout from '../layouts/Layout.astro';
import { sitePages } from '../data/site-pages';
import download from '../data/download.json';
import release from '../data/release.json';
---
<Layout {...sitePages.installation}>
  <section class="wrap guide-intro">
    <p class="eyebrow">{t('installation_hardware_eitr_linux')}</p>
    <h1>{t('a_place_to_begin')}<br /><em>{t('know_the_ground_first')}</em></h1>
    <p class="lead">{t('the_eitr_linux_iso_includes_the_packages_for_an_offline')} {download.version}{t('the_project_is_a')} {translator(Astro.url.pathname, 'roadmap')(release.stage)} {t('for_early_users_with_specific_tested_configurations_and')}</p>
    <nav class="info-links" aria-label={t('installation_resources')}>
      <a class="button primary" href="/#install">{t('download_sha_256')}</a>
      <a class="text-link" href="/guide/">{t('vm_testing_canonical_guides')}</a>
    </nav>
  </section>
  <div class="wrap info-body">
    <section class="info-section" aria-labelledby="installation-target">
      <p class="eyebrow">{t('target_system')}</p>
      <h2 id="installation-target">{t('x86_64')}<br /><em>{t('uefi_arch_underneath')}</em></h2>
      <ul>
        <li>{t('an_x86_64_pc_or_vm_booted_in_uefi_mode_apple_silicon_te')}</li>
        <li>{t('the_guided_installer_lists_writable_disks_of_at_least_6')}</li>
        <li>{t('install_alongside_mode_requires_a_gpt_disk_with_at_leas')}</li>
        <li>{t('the_supported_fresh_install_layout_uses_btrfs_for_eitr_')}</li>
        <li>{t('no_network_is_required_for_the_guided_installation_late')}</li>
        <li>{t('installation_takes_about_two_minutes_in_a_virtual_machi')}</li>
      </ul>
      <p>{t('back_up_your_files_before_changing_a_disk_verify_the_is')}</p>
      <a class="text-link" href="https://github.com/eitr-org/eitr/blob/main/distro/README.md" target="_blank" rel="noopener noreferrer">{t('read_the_complete_installation_guide')}</a>
    </section>
    <section class="info-section" id="unattended" aria-labelledby="installation-unattended">
      <p class="eyebrow">{t('several_machines_answers_stick_organization_profiles')}</p>
      <h2 id="installation-unattended">{t('no_questions_asked')}<br /><em>{t('the_same_setup_each_time')}</em></h2>
      <p>{t('to_install_without_the_wizard_format_a_usb_stick_as_fat')} <code>EITRANSWERS</code> {t('fat_labels_hold_11_characters_and_put')} <code>eitr-answers.json</code> {t('on_it_with_the_disk_layout_encryption_user_keyboard_and')}</p>
      <p>{t('add')} <code>eitr-profile.json</code> {t('to_the_same_stick_with_or_without_answers_for_an_organi')}</p>
      <div class="info-links"><a class="text-link" href="https://github.com/eitr-org/eitr/blob/main/distro/README.md#unattended-install" target="_blank" rel="noopener noreferrer">{t('unattended_install')}</a><a class="text-link" href="https://github.com/eitr-org/eitr/blob/main/distro/ORGANIZATION-PROFILES.md" target="_blank" rel="noopener noreferrer">{t('organization_profiles')}</a></div>
    </section>
    <section class="info-section" id="compatibility" aria-labelledby="installation-evidence">
      <p class="eyebrow">{t('evidence_not_a_blanket_compatibility_claim')}</p>
      <h2 id="installation-evidence">{t('what_has')}<br /><em>{t('actually_been_tested')}</em></h2>
      <div class="info-table-scroll">
        <table class="info-table">
          <caption>{t('eitr_s_current_validation_scope')}</caption>
          <thead><tr><th scope="col">{t('configuration')}</th><th scope="col">{t('current_evidence')}</th></tr></thead>
          <tbody>
            <tr><th scope="row">{t('released_isos_in_virtual_machines')}</th><td>{t('automated_offline_installation_update_and_factory_reset')}</td></tr>
            <tr><th scope="row">{t('developer_s_desktop')}</th><td>{t('installed_from_eitr_s_iso_and_used_daily_with_updates_t')}</td></tr>
            <tr><th scope="row">{t('installing_beside_windows')}</th><td>{t('verified_in_a_vm_with_a_simulated_windows_disk_real_win')}</td></tr>
            <tr><th scope="row">{t('other_graphics_cards_and_laptops')}</th><td>{t('driver_handling_exists_but_broader_real_hardware_valida')}</td></tr>
            <tr><th scope="row">{t('encrypted_system_recovery')}</th><td>{t('encrypted_installation_and_daily_use_have_real_machine_')}</td></tr>
          </tbody>
        </table>
      </div>
    </section>
    <section class="info-section" aria-labelledby="installation-graphics">
      <p class="eyebrow">{t('graphics_firmware')}</p>
      <h2 id="installation-graphics">{t('driver_handling')}<br /><em>{t('explicit_choices')}</em></h2>
      <p>{t('eitr_detects_graphics_hardware_and_has_driver_handling_')}</p>
      <p>{t('secure_boot_setup_is_documented_in_the_handbook_and_is_')}</p>
    </section>
    <section class="info-section" aria-labelledby="installation-try">
      <p class="eyebrow">{t('try_it_report_back')}</p>
      <h2 id="installation-try">{t('start_with_a_vm')}<br /><em>{t('help_expand_the_evidence')}</em></h2>
      <p>{t('a_clean_x86_64_vm_on_linux_kvm_is_the_preferred_first_t')}</p>
      <p>{t('on_the_desktop_system_information_report_a_problem_prep')}</p>
      <div class="info-links"><a class="text-link" href="/guide/">{t('choose_a_testing_guide')}</a><a class="text-link" href="https://github.com/eitr-org/eitr/issues" target="_blank" rel="noopener noreferrer">{t('report_an_issue')}</a><a class="text-link" href="/privacy/">{t('how_reports_are_handled')}</a></div>
    </section>
  </div>
</Layout>
