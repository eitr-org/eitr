---
import { translator } from '../i18n';
const t = translator(Astro.url.pathname, 'privacy');
import BrandText from "../components/BrandText.astro";
import Layout from "../layouts/Layout.astro";
import { sitePages } from "../data/site-pages";
const sections = [
  [
    t('nothing_is_collected_by_itself'),
    t('eitr_collects_no_usage_telemetry_weather_updates_and_co'),
  ],
  [
    t('what_a_problem_report_holds'),
    t('versions_of_eitr_and_its_main_packages_graphics_hardwar'),
  ],
  [
    t('how_a_report_reaches_us'),
    t('only_if_you_send_it_by_email_to_reports_eitr_info_or_as'),
  ],
  [
    t('what_we_do_with_it'),
    t('a_report_is_used_only_to_find_and_fix_the_problem_it_de'),
  ],
  [
    t('your_choices'),
    t('reply_to_your_report_email_or_write_to_contact_eitr_inf'),
  ],
  [
    t('this_website'),
    t('the_site_sets_no_cookies_iso_download_starts_are_counte'),
  ],
];
---

<Layout {...sitePages.privacy}>
  <section class="wrap guide-intro">
    <p class="eyebrow">{t('privacy')}</p>
    <h1>
      {t('your_machine')}
      <br />
      <em>{t('your_choice')}</em>
    </h1>
    <p class="lead">
      <BrandText text="Eitr" /> {t('collects_no_usage_telemetry_a_problem_report_leaves_you')}
    </p>
  </section>
  <section class="wrap guide-links" aria-label={t('how_problem_reports_are_handled')}>
    {sections.map(([title, body], index) => (
      <div class="guide-link">
        <span class="feature-number">0{index + 1}</span>
        <div>
          <h2 id={`privacy-${index + 1}`}>{title}</h2>
          <p>{body}</p>
        </div>
      </div>
    ))}
  </section>
</Layout>
