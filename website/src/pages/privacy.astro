---
import BrandText from "../components/BrandText.astro";
import Layout from "../layouts/Layout.astro";
import { sitePages } from "../data/site-pages";
const sections = [
  [
    "Nothing is collected by itself",
    "Eitr collects no usage telemetry. Weather, updates and connected tools contact their own services. Crash notifications offer help or a report for you to review and send; they are on by default and can be turned off in the Handbook welcome.",
  ],
  [
    "What a problem report holds",
    "Versions of Eitr and its main packages, graphics hardware, desktop errors and warnings, recent crashes, the installation log and recent package changes. Your user name, computer name, home folder, email, IP and MAC addresses are removed before you see it. You read the whole report before sending it.",
  ],
  [
    "How a report reaches us",
    "Only if you send it: by email to reports@eitr.info, or as a public GitHub issue. An email shares your email address with us; a GitHub issue is visible to everyone.",
  ],
  [
    "What we do with it",
    "A report is used only to find and fix the problem it describes. It is not sold, shared or used for anything else, and it is deleted once the problem is fixed.",
  ],
  [
    "Your choices",
    "Reply to your report email, or write to contact@eitr.info, to have your report deleted at any time. You can turn crash offers off in the welcome chapter of the Handbook. Optional cloud assistants receive messages and context you share; Control Center quick chat is read-only and keeps its conversation only in memory until closed.",
  ],
  [
    "This website",
    "The site sets no cookies. ISO download starts are counted by UTC day and filename without storing visitor data; the website displays the aggregate total. Your day/night preference is saved only in this browser’s local storage. It is served by Cloudflare, which processes visitors' network addresses to deliver and protect it.",
  ],
];
---

<Layout {...sitePages.privacy}>
  <section class="wrap guide-intro">
    <p class="eyebrow">Privacy</p>
    <h1>
      Your machine.
      <br />
      <em>Your choice.</em>
    </h1>
    <p class="lead">
      <BrandText text="Eitr" /> collects no usage telemetry. A problem report leaves your computer only when you send it.
    </p>
  </section>
  <section class="wrap guide-links" aria-label="How problem reports are handled">
    {sections.map(([title, body], index) => (
      <div class="guide-link">
        <span class="feature-number">0{index + 1}</span>
        <div>
          <h2>{title}</h2>
          <p>{body}</p>
        </div>
      </div>
    ))}
  </section>
</Layout>
