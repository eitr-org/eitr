---
const { html, path } = Astro.props;
const headings: { id: string; title: string }[] = [];
const usedIds = new Set(Array.from(html.matchAll(/\bid="([^"]+)"/g), (match: RegExpMatchArray) => match[1]));
const content = html.replace(/<h2\b([^>]*)>([\s\S]*?)<\/h2>/g, (_heading: string, attributes: string, body: string) => {
  const title = body.replace(/<br\s*\/?\s*>/gi, ' ').replace(/<[^>]*>/g, '').trim();
  let id = attributes.match(/\bid="([^"]+)"/)?.[1];
  if (!id) {
    const stem = title.replace(/&[^;]+;/g, ' ').normalize('NFKD').replace(/[\u0300-\u036f]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '') || 'section';
    id = stem;
    let suffix = 2;
    while (usedIds.has(id)) id = `${stem}-${suffix++}`;
    usedIds.add(id);
    attributes += ` id="${id}"`;
  }
  headings.push({ id, title });
  return `<h2${attributes}>${body}</h2>`;
});
const artwork = path.startsWith('/guide/') ? 'mimir' : path === '/installation/' ? 'yggdrasil' : path === '/features/' ? 'valkyrie' : path === '/development/' ? 'mimir' : path === '/privacy/' ? 'jormungandr' : 'yggdrasil';
---
<div class="inner-page">
  <div class="inner-content" set:html={content} />
  <aside class="page-rail">
    <img class="inner-hero-art" src={`/art/${artwork}.webp`} alt="" width="480" height="360" />
    {headings.length > 0 && <nav class="page-outline" aria-label="On this page">
      <p class="label">On this page</p>
      <ol>{headings.map(heading => <li><a href={`#${heading.id}`} set:html={heading.title} /></li>)}</ol>
    </nav>}
  </aside>
</div>
