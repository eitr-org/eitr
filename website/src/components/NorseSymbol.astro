if (!paths[name]) throw new Error(`Unknown Norse symbol: ${name}`);
---
<svg class:list={['norse-symbol',className]} viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round" aria-hidden="true">{paths[name].map(d=><path d={d}/>)}</svg>
