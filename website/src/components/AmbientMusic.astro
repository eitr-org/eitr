<div class="ambient-music">
  <button class="music-toggle" type="button" aria-pressed="false" aria-controls="norse-audio" aria-label="Music off"><span aria-hidden="true">♫</span><span class="music-state" hidden>off</span></button>
  <details>
    <summary>Music credits</summary>
    <p><a href="https://creatorchords.com/music/wild-west-vikings/" target="_blank" rel="noopener noreferrer">Wild West Vikings</a>
      by Alexander Nakarada · <a href="https://creatorchords.com" target="_blank" rel="noopener noreferrer">CreatorChords</a> ·
      <a href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="noopener noreferrer">CC BY 4.0</a>.
      Re-encoded at 128 kbps and repeated for playback.</p>
    <p>Theme-switch howl: <a href="https://freesound.org/people/NaturesTemper/sounds/398430/" target="_blank" rel="noopener noreferrer">Wolf howl</a> by NaturesTemper, CC0.</p>
    <p>Charged lightning: <a href="https://freesound.org/people/TRP/sounds/616992/" target="_blank" rel="noopener noreferrer">Thunder, crack, pretty close</a> by TRP, CC0.</p>
  </details>
  <p class="music-status" role="status"></p>
  <audio id="norse-audio" preload="none" loop src="/audio/wild-west-vikings.mp3"></audio>
</div>
<style>
.ambient-music{position:absolute;z-index:2;right:max(20px,calc((100% - 1280px)/2));bottom:12px;display:flex;align-items:center;gap:12px;color:var(--muted);font-size:12px}
.music-toggle{display:grid;place-items:center;width:40px;height:40px;border:1px solid var(--line-strong);border-radius:4px;background:var(--bg);color:var(--muted);font:inherit;font-size:20px;cursor:pointer}
.music-toggle:hover,.music-toggle[aria-pressed="true"]{border-color:var(--fg);color:var(--fg)}
.music-toggle:focus-visible,summary:focus-visible{outline:2px solid var(--fg);outline-offset:4px}
summary{cursor:pointer;min-height:40px;display:flex;align-items:center}
details[open]{position:absolute;bottom:48px;right:0;width:min(310px,calc(100vw - 40px));padding:16px;background:var(--bg);border:1px solid var(--line-strong);border-radius:4px}
details p{margin-top:10px;line-height:1.7}details a{text-decoration:underline}
.music-status{position:absolute;right:0;bottom:48px;width:240px;padding:12px;background:var(--bg);margin:0}.music-status:empty{display:none}
</style>
<script>
const audio=document.querySelector<HTMLAudioElement>('#norse-audio');
const toggle=document.querySelector<HTMLButtonElement>('.music-toggle');
const status=document.querySelector<HTMLElement>('.music-status');
if(audio && toggle && status) {
 audio.volume=.2;
 const update=()=>{
  const playing=!audio.paused;
  toggle.setAttribute('aria-pressed',String(playing));
  toggle.setAttribute('aria-label',playing ? 'Music on' : 'Music off');
  toggle.querySelector('.music-state')!.textContent=playing ? 'on' : 'off';
 };
 audio.addEventListener('play',update);
 audio.addEventListener('pause',update);
 toggle.addEventListener('click',async()=>{
  status.textContent='';
  if(!audio.paused) {audio.pause();return;}
  toggle.disabled=true;
  try {await audio.play();}
  catch {status.textContent='Music could not play. Please try again.';}
  finally {toggle.disabled=false;update();}
 });
 audio.addEventListener('error',()=>{status.textContent='Music is unavailable. Please try again later.';update();});
 document.addEventListener('visibilitychange',()=>{if(document.hidden) audio.pause();});
}
// The credits close on a click anywhere outside them, or on Escape (focus returns to their title).
const credits=document.querySelector<HTMLDetailsElement>('.ambient-music details');
if(credits) {
 document.addEventListener('click',(event)=>{
  if(credits.open && !credits.contains(event.target as Node)) credits.open=false;
 });
 document.addEventListener('keydown',(event)=>{
  if(event.key==='Escape' && credits.open) {credits.open=false;credits.querySelector('summary')?.focus();}
 });
}
</script>
