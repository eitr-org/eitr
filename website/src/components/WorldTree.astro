---
import NorseSymbol from './NorseSymbol.astro';
import BrandText from './BrandText.astro';
import themes from '../data/themes.json';
const realms = [
  {id:'asgard',name:'Asgard',topic:'The desktop shell',symbol:'raven',x:50,y:11,color:'#ddbd7e',intro:'One shell. Everything within reach.',body:'Quickshell brings the bar, native panels and notifications into one theme-aware desktop.',items:['Control Center, networking and audio panels','Calendar, weather and media controls','Workspace Overview with live previews'],href:'#what',link:'Explore the desktop'},
  {id:'alfheim',name:'Alfheim',topic:'Themes & color',symbol:'tree',x:23,y:27,color:'#e0a0a4',intro:`${themes.length} worlds. Find your atmosphere.`,body:'A theme follows you across the bar, terminal, launcher, lockscreen, editors and apps.',items:['Light and dark palettes','Wallpapers bundled with each theme, some of them alive','One selection recolors the desktop'],href:'#themes',link:'Discover the themes'},
  {id:'vanaheim',name:'Vanaheim',topic:'Make it yours',symbol:'tree',x:77,y:27,color:'#a9b47c',intro:'Your desktop should feel like home.',body:'Shape the desktop through its own preferences, with personal choices that survive theme changes.',items:['Square, Rounded or Extra Rounded corners','Bar position, transparency, Full, Centered and Tabs layouts','Workspaces as runes, numbers, glyphs or dots'],href:'#themes',link:'See the possibilities'},
  {id:'jotunheim',name:'Jotunheim',topic:'Arch & updates',symbol:'hammer',x:13,y:52,color:'#a7b1c2',intro:'An Arch foundation. Room to grow.',body:'Eitr runs on Arch Linux for x86_64, with its own signed package repository alongside Arch’s.',items:['Hyprland with a shared Lua configuration','Package-owned desktop components','System Update snapshots upgrades on supported setups'],href:'#road',link:'Follow the roadmap'},
  {id:'midgard',name:'Midgard',topic:'Everyday flow',symbol:'ship',x:50,y:49,color:'#e4d5aa',intro:'Less searching. More doing.',body:'Tiling windows, workspaces and a keyboard-first launcher keep everyday work moving.',items:['Walker launches apps and finds actions','Apps and settings meet in organized menus','An offline shortcut reference stays close'],href:'#what',link:'Meet the desktop'},
  {id:'svartalfheim',name:'Svartalfheim',topic:'Tools & accounts',symbol:'spear',x:87,y:52,color:'#e0784a',intro:'A place for the work you do.',body:'Git Accounts and cloud menus make account context visible and keep personal and work identities apart.',items:['Folder-specific Git identity rules','Explicit cloud provider and project selection','Assistant accounts and session menus'],href:'#faq',link:'More about Eitr'},
  {id:'niflheim',name:'Niflheim',topic:'The Handbook',symbol:'raven',x:25,y:77,color:'#c9d3db',intro:'Old wisdom. Always close.',body:'The offline, read-only Eitr Handbook keeps guidance inside the desktop, even without a connection.',items:['Shortcuts, appearance and networking','Security and recovery guidance','Canonical distro guides in one reader'],href:'/guide/',link:'Open the guides'},
  {id:'muspelheim',name:'Muspelheim',topic:'Installation',symbol:'hammer',x:75,y:77,color:'#e05a5a',intro:'Where a new desktop begins.',body:'The guided installer sets up the complete desktop offline, from the packages carried on the ISO.',items:['Guided installation workflow','VM testing guides for Linux and Mac','A public beta ISO, offered with its SHA-256 checksum'],href:'#install',link:'Plan your first install'},
  {id:'helheim',name:'Helheim',topic:'Recovery',symbol:'serpent',x:50,y:91,color:'#9a8f86',intro:'A way back when you need one.',body:'Snapshots and documented recovery procedures help you return to a working system.',items:['System Update snapshots supported layouts before upgrading','Factory reset returns to the first-login baseline','Read the recovery guide and current limitations'],href:'/guide/',link:'Read the recovery guides'},
];
---
<section id="realms" class="wrap world-tree section">
  <div class="section-heading">
    <p class="eyebrow reveal"><NorseSymbol name="tree" class="heading-symbol" /> Yggdrasil / The nine realms</p>
    <h2 class="reveal">Many realms.<br /><em>One living desktop.</em></h2>
    <p class="reveal">Follow a branch. Each realm opens a different part of <BrandText text="Eitr" wordmark />.</p>
  </div>
  <div class="realm-map">
    <img class="world-tree-art" src="/art/yggdrasil.webp" alt="" loading="lazy" />
    <div class="realm-nodes" role="group" aria-label="Explore Eitr through nine realms">
      {realms.map(realm => (
        <button type="button" class="realm-node" data-realm-open={realm.id} aria-haspopup="dialog" aria-controls={`realm-${realm.id}`} style={`--realm-x:${realm.x}%;--realm-y:${realm.y}%;--realm-color:${realm.color}`}>
          <span class="realm-orb" aria-hidden="true"></span>
          <span class="realm-name">{realm.name}</span>
          <span class="realm-topic">{realm.topic}</span>
        </button>
      ))}
    </div>
  </div>
  <p class="realm-hint">Choose a realm to explore.</p>
  {realms.map(realm => (
    <dialog class="realm-dialog" id={`realm-${realm.id}`} aria-labelledby={`realm-title-${realm.id}`} aria-describedby={`realm-intro-${realm.id}`} style={`--realm-color:${realm.color}`}>
      <button class="realm-close" type="button" aria-label={`Close ${realm.name}`} autofocus>×</button>
      <div class="realm-dialog-content">
        <NorseSymbol name={realm.symbol} class="realm-dialog-symbol" />
        <p class="eyebrow">{realm.name} / {realm.topic}</p>
        <h2 id={`realm-title-${realm.id}`}>{realm.intro}</h2>
        <p class="realm-description" id={`realm-intro-${realm.id}`}><BrandText text={realm.body} /></p>
        <ul>{realm.items.map(item => <li>{item}</li>)}</ul>
        <a class="text-link realm-cta" href={realm.href}>{realm.link} ↗</a>
      </div>
    </dialog>
  ))}
</section>
<style>
/* On phones the nine realms become a long stack of buttons over a hidden tree, so the section is left out. */
@media(max-width:700px){.world-tree{display:none}}
.world-tree{padding-bottom:30px}.world-tree h2 em{color:#d4545c}
.realm-map{position:relative;min-height:650px;isolation:isolate;background:#000;border:1px solid #b08d5729;border-radius:6px;overflow:hidden}
.world-tree-art{position:absolute;inset:0;width:100%;height:100%;object-fit:contain;object-position:center;opacity:.65}
.realm-nodes{position:absolute;inset:0}
.realm-node{position:absolute;left:var(--realm-x);top:var(--realm-y);translate:-50% -50%;width:178px;min-height:76px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;padding:12px 10px 10px;color:#efe7dc;border:1px solid color-mix(in srgb,var(--realm-color) 35%,transparent);border-radius:6px;background:#0a0707ef;cursor:pointer;box-shadow:0 8px 24px #0008;transition:border-color .2s,background .2s,box-shadow .2s}
.realm-orb{width:7px;height:7px;position:absolute;top:-4px;border-radius:50%;background:var(--realm-color);box-shadow:0 0 12px var(--realm-color)}
.realm-name{font:500 16px var(--carved);letter-spacing:.05em;color:var(--realm-color)}
.realm-topic{font:12px var(--mono);color:#b5aba0}
.realm-node:hover,.realm-node:focus-visible{border-color:var(--realm-color);background:#161111;box-shadow:0 0 24px color-mix(in srgb,var(--realm-color) 15%,transparent)}
.realm-hint{text-align:center;margin-top:18px;font-size:12px;letter-spacing:.08em}
.realm-dialog{box-sizing:border-box;width:min(580px,calc(100vw - 36px));max-height:calc(100dvh - 48px);padding:0;margin:auto;overflow:auto;border:1px solid var(--realm-color);border-radius:8px;background:#0d0a0a;color:var(--fg);box-shadow:0 30px 100px #000b}
.realm-dialog::backdrop{background:#000b;backdrop-filter:blur(7px)}
.realm-dialog[open]{animation:realm-arrive .2s ease-out}
.realm-dialog-content{padding:42px}
.realm-dialog :global(.realm-dialog-symbol){width:48px;height:48px;color:var(--realm-color);margin-bottom:20px}
.realm-dialog .eyebrow{color:var(--realm-color);font-size:12px;padding-right:18px}
.realm-dialog h2{font-size:42px;line-height:1.1;margin:18px 0 24px}
.realm-description{font-size:14px}
.realm-dialog ul{padding-left:18px;margin:24px 0 28px;color:#c2b8ad;line-height:1.7;font-size:13px}
.realm-dialog li+li{margin-top:8px}
.realm-close{position:absolute;right:12px;top:12px;width:36px;height:36px;background:transparent;border:1px solid #ffffff29;border-radius:50%;color:#e4dcd2;font-size:24px;line-height:1;cursor:pointer}
.realm-close:hover{border-color:var(--realm-color)}
@keyframes realm-arrive{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}
@media(max-width:960px){.realm-map{min-height:590px}.realm-node{width:145px}.realm-name{font-size:14px}.realm-topic{font-size:12px}}
@media(max-width:600px){.realm-map{min-height:0;padding:24px 16px}.world-tree-art{object-fit:contain;opacity:.32}.realm-nodes{position:relative;display:grid;grid-template-columns:1fr 1fr;gap:18px 12px}.realm-node{position:relative;left:auto;top:auto;translate:none;width:100%;min-height:82px;padding-inline:5px}.realm-node:last-child{grid-column:1/-1;width:50%;justify-self:center}.realm-dialog-content{padding:34px 24px}.realm-dialog h2{font-size:34px}}
</style>
<script>
for(const button of document.querySelectorAll<HTMLButtonElement>('[data-realm-open]')) {
 const dialog=document.getElementById(`realm-${button.dataset.realmOpen}`) as HTMLDialogElement | null;
 if(!dialog) continue;
 button.addEventListener('click',()=>{if(!dialog.open) dialog.showModal();});
 dialog.querySelector('.realm-close')?.addEventListener('click',()=>dialog.close());
 dialog.querySelector('.realm-cta')?.addEventListener('click',()=>dialog.close());
 dialog.addEventListener('click',event=>{
  if(event.target!==dialog) return;
  const bounds=dialog.getBoundingClientRect();
  if(event.clientX<bounds.left || event.clientX>bounds.right || event.clientY<bounds.top || event.clientY>bounds.bottom) dialog.close();
 });
}
</script>
